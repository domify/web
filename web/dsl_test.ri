    perform(context).into_body
  end

  private def perform(env : Context)
    env["order"]? || ""
  end
end

class Route13 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env["order"]? || ""
  end
end

class Route14 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    name = env.params.url["name"]
    rendered = render "fixtures/views/page.eiy"
    body = ""
    body << rendered
    body
  end
end

class Route15 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    name = env.params.url["name"]
    rendered = render "fixtures/views/with_content_for.eiy",
      "fixtures/views/layout_with_yield.eiy"
    body = ""
    body << rendered
    body
  end
end

class Route16 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.text("x" * 2000)
  end
end


class Tag < Handler
  @label : String

  def initialize(@label : String)
    super()
  end

  pub def call(ctx : Context) : Nil
    previous = ctx["order"]?
    ctx["order"] = previous ? previous + "," + @label : @label
    call_next(ctx)
  end
end

class Collected < Logger
  @text : String::Builder
  @rows : Array(Tuple(Int32, Int32))

  def initialize(capacity : Int32)
    @text = String::Builder.new(capacity)
    @rows = [] of Tuple(Int32, Int32)
  end

  pub def write(message : String) : Nil
    at = @text.bytesize
    @text.append(message)
    @rows << {at, message.bytesize}
  end

  def lines : Array(String)
    @rows.map { |row| @text.finish[row[0], row[1]] }
  end
end

class ServedHeader < StaticHeadersHook
  pub def call(context : Context, path : String, info : File::Info) : Nil
    context.response.headers["X-Served"] = info.size.to_s
    nil
  end
end

def dsl_example_1 : Nil
  config = Config.new("web")
  router = Router.new("")
  application = App.new(router, config)
  route_action_1 = Route1.new
  application.get("/dsl", route_action_1)

  route_action_2 = Route2.new
  application.post("/dsl", route_action_2)

  route_action_3 = Route3.new
  application.before_all("/gated", route_action_3)

  route_action_4 = Route4.new
  application.get("/gated", route_action_4)

  route_action_5 = Route5.new
  application.error(404, route_action_5)

  mounted = Router.new("")
  route_action_6 = Route6.new
  mounted.get("/in", route_action_6)
  application.mount "/sub", mounted

  route_action_7 = Route7.new
  application.before_get(["/listed-a", "/listed-b"], route_action_7)

  route_action_8 = Route8.new
  application.get("/listed-a", route_action_8)

  route_action_9 = Route9.new
  application.get("/listed-b", route_action_9)

  route_action_10 = Route10.new
  application.get("/halted", route_action_10)

  route_action_11 = Route11.new
  application.get("/headed", route_action_11)

  route_action_12 = Route12.new
  application.get("/ordered", route_action_12)

  route_action_13 = Route13.new
  application.get("/api/ordered", route_action_13)

  route_action_14 = Route14.new
  application.get("/rendered/:name", route_action_14)

  route_action_15 = Route15.new
  application.get("/laid-out/:name", route_action_15)

  route_action_16 = Route16.new
  application.get("/big-text", route_action_16)

  route_options_1 = Config.new("web")
  route_tree_1 = Tree(Int32).new
  socket_tree_1 = Tree(Int32).new
  route_handler_1 = RouteHandler.new(route_tree_1, socket_tree_1,
    route_options_1)
  route_handler_1.load(application.router)
  handler = route_handler_1
  dispatch(handler, "GET", "/dsl") do |made230|
    assert made230.response.body == "from-dsl"
  end
  dispatch(handler, "POST", "/dsl") do |made231|
    assert made231.response.body == "posted-dsl"
  end
  nil
end

