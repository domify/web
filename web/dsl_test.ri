  route_handler_6 = RouteHandler.new(route_tree_6, socket_tree_6,
    route_options_6)
  route_handler_6.load(application.router)
  handler = route_handler_6
  dispatch(handler, "GET", "/halted") do |halted|
    assert halted.response.status_code == 403
    assert halted.response.body == "Forbidden"
    dispatch(handler, "GET", "/headed") do |headed|
      assert headed.response.headers["x-a"] == "1"
      assert headed.response.headers["x-b"] == "2"
    end
