  config = Config.new("web")
  router = Router.new("")
  application = App.new(router, config)
  route_action_1 = Route1.new
  application.get("/dsl", route_action_1)

  route_action_2 = Route2.new
  application.post("/dsl", route_action_2)

  route_action_3 = Route3.new
  application.before_all("/gated", route_action_3)

  route_action_4 = Route4.new
  application.get("/gated", route_action_4)

  route_action_5 = Route5.new
  application.error(404, route_action_5)

  mounted = Router.new("")
  route_action_6 = Route6.new
  mounted.get("/in", route_action_6)
  application.mount "/sub", mounted

  route_action_7 = Route7.new
  application.before_get(["/listed-a", "/listed-b"], route_action_7)

  route_action_8 = Route8.new
  application.get("/listed-a", route_action_8)

  route_action_9 = Route9.new
  application.get("/listed-b", route_action_9)

  route_action_10 = Route10.new
  application.get("/halted", route_action_10)

  route_action_11 = Route11.new
  application.get("/headed", route_action_11)

  route_action_12 = Route12.new
  application.get("/ordered", route_action_12)

  route_action_13 = Route13.new
  application.get("/api/ordered", route_action_13)

  route_action_14 = Route14.new
  application.get("/rendered/:name", route_action_14)

  route_action_15 = Route15.new
  application.get("/laid-out/:name", route_action_15)

  route_action_16 = Route16.new
  application.get("/big-text", route_action_16)

  application.logging(false)
  application.serve_static(false)
  second = Tag.new("second")
  application.use(second)
  first = Tag.new("first")
  application.use(first, 0)
  api_first = Tag.new("api-1")
  api_second = Tag.new("api-2")
  scoped_first = PathHandler.new("/api", api_first)
  scoped_second = PathHandler.new("/api", api_second)
  application.use(scoped_first)
  application.use(scoped_second)
  with_handler_chain(application) do |whole|
    dispatch(whole, "GET", "/ordered") do |made242|
      assert made242.response.body == "first,second"
    end
    dispatch(whole, "GET", "/api/ordered") do |made243|
      assert made243.response.body == "first,second,api-1,api-2"
    end
  end
  nil
end

def dsl_example_10 : Nil
  config = Config.new("web")
  router = Router.new("")
  application = App.new(router, config)
  route_action_1 = Route1.new
  application.get("/dsl", route_action_1)

  route_action_2 = Route2.new
  application.post("/dsl", route_action_2)

  route_action_3 = Route3.new
  application.before_all("/gated", route_action_3)

  route_action_4 = Route4.new
  application.get("/gated", route_action_4)

  route_action_5 = Route5.new
  application.error(404, route_action_5)

  mounted = Router.new("")
  route_action_6 = Route6.new
  mounted.get("/in", route_action_6)
  application.mount "/sub", mounted

  route_action_7 = Route7.new
  application.before_get(["/listed-a", "/listed-b"], route_action_7)

  route_action_8 = Route8.new
  application.get("/listed-a", route_action_8)

  route_action_9 = Route9.new
  application.get("/listed-b", route_action_9)

  route_action_10 = Route10.new
  application.get("/halted", route_action_10)

  route_action_11 = Route11.new
  application.get("/headed", route_action_11)

  route_action_12 = Route12.new
  application.get("/ordered", route_action_12)

  route_action_13 = Route13.new
  application.get("/api/ordered", route_action_13)

  route_action_14 = Route14.new
  application.get("/rendered/:name", route_action_14)

  route_action_15 = Route15.new
  application.get("/laid-out/:name", route_action_15)

  route_action_16 = Route16.new
  application.get("/big-text", route_action_16)

  route_options_7 = Config.new("web")
  route_tree_7 = Tree(Int32).new
  socket_tree_7 = Tree(Int32).new
  route_handler_7 = RouteHandler.new(route_tree_7, socket_tree_7,
    route_options_7)
  route_handler_7.load(application.router)
  handler = route_handler_7
  dispatch(handler, "GET", "/rendered/ada") do |made244|
    assert made244.response.body == "Hello ada\n"
  end
  dispatch(handler, "GET", "/laid-out/ada") do |made245|
    laid = made245.response.body
    assert laid.includes?("<head><title>Page of ada</title>\n</head>")
    assert laid.includes?("<body>Hello ada\n</body>")
  end
  nil
end

def dsl_example_11 : Nil
  config = Config.new("web")
  router = Router.new("")
  application = App.new(router, config)
  route_action_1 = Route1.new
  application.get("/dsl", route_action_1)

  route_action_2 = Route2.new
  application.post("/dsl", route_action_2)

  route_action_3 = Route3.new
  application.before_all("/gated", route_action_3)

  route_action_4 = Route4.new
  application.get("/gated", route_action_4)

  route_action_5 = Route5.new
  application.error(404, route_action_5)

  mounted = Router.new("")
  route_action_6 = Route6.new
  mounted.get("/in", route_action_6)
  application.mount "/sub", mounted

  route_action_7 = Route7.new
  application.before_get(["/listed-a", "/listed-b"], route_action_7)

  route_action_8 = Route8.new
  application.get("/listed-a", route_action_8)

  route_action_9 = Route9.new
  application.get("/listed-b", route_action_9)

  route_action_10 = Route10.new
  application.get("/halted", route_action_10)

  route_action_11 = Route11.new
  application.get("/headed", route_action_11)

  route_action_12 = Route12.new
  application.get("/ordered", route_action_12)

  route_action_13 = Route13.new
  application.get("/api/ordered", route_action_13)

  route_action_14 = Route14.new
  application.get("/rendered/:name", route_action_14)

  route_action_15 = Route15.new
  application.get("/laid-out/:name", route_action_15)

  route_action_16 = Route16.new
  application.get("/big-text", route_action_16)

  application.gzip true
  http_request("GET", "/big-text") do |request|
    request.headers["Accept-Encoding"] = "gzip"
    with_handler_chain(application) do |current_handler|
      dispatch(current_handler, request) do |packed|
        assert packed.response.headers["content-encoding"] == "gzip"
        assert Gzip.decompress(packed.response.body) == "x" * 2000
      end
    end
  end
  nil
end

def dsl_example_12 : Nil
  config = Config.new("web")
  router = Router.new("")
  application = App.new(router, config)
  route_action_1 = Route1.new
  application.get("/dsl", route_action_1)

  route_action_2 = Route2.new
  application.post("/dsl", route_action_2)

  route_action_3 = Route3.new
  application.before_all("/gated", route_action_3)

  route_action_4 = Route4.new
  application.get("/gated", route_action_4)

  route_action_5 = Route5.new
  application.error(404, route_action_5)

  mounted = Router.new("")
  route_action_6 = Route6.new
  mounted.get("/in", route_action_6)
  application.mount "/sub", mounted

  route_action_7 = Route7.new
  application.before_get(["/listed-a", "/listed-b"], route_action_7)

  route_action_8 = Route8.new
  application.get("/listed-a", route_action_8)

  route_action_9 = Route9.new
  application.get("/listed-b", route_action_9)

  route_action_10 = Route10.new
  application.get("/halted", route_action_10)

  route_action_11 = Route11.new
  application.get("/headed", route_action_11)

  route_action_12 = Route12.new
  application.get("/ordered", route_action_12)

  route_action_13 = Route13.new
  application.get("/api/ordered", route_action_13)

  route_action_14 = Route14.new
  application.get("/rendered/:name", route_action_14)

  route_action_15 = Route15.new
  application.get("/laid-out/:name", route_action_15)

  route_action_16 = Route16.new
  application.get("/big-text", route_action_16)

  application.serve_static({"dir_listing" => true, "gzip" => true})
  assert config.serve_static
  assert config.static_dir_listing
  assert config.static_gzip
  assert !config.static_dir_index
  application.public_folder(__DIR__ + "/fixtures")
  hook = ServedHeader.new
  application.static_headers(hook)
  with_handler_chain(application) do |current_handler|
    dispatch(current_handler, "GET", "/hello.txt") do |served|
      assert served.response.body == "hello-static"
      assert served.response.headers["x-served"] == "12"
      dispatch(current_handler, "GET", "/") do |listed|
        assert listed.response.body.includes?("hello.txt")
        application.serve_static(false)
      end
    end
  end
  nil
end

def run_suite : Nil
  describe "web/dsl" do
    it "registers GET and POST on the process app" do
      dsl_example_1
    end

    it "registers error handlers" do
      dsl_example_2
    end

    it "registers before_all" do
      dsl_example_3
    end

    it "mounts a sub-router" do
      dsl_example_4
    end

    it "writes config through helpers" do
      dsl_example_5
    end

    it("sends request lines and log messages to the configured " +
      "logger until logging false") do
      dsl_example_6
    end

    it "registers one filter for a list of paths" do
      dsl_example_7
    end

    it "halts and sets headers with the helper functions" do
      dsl_example_8
    end

    it("places a positioned handler first and scopes a handler list " +
      "to a path") do
      dsl_example_9
    end

    it "renders templates, with a layout and content_for, through the DSL" do
      dsl_example_10
    end

    it "compresses responses with gzip true" do
      dsl_example_11
    end

    it "takes static options as a hash and calls static_headers" do
      dsl_example_12
    end
  end
end

group do |g|
  suite = g.spawn do
    run_suite
    0
  end
  result = suite.value
  raise result.text if result.is_a?(Panicked)
  0
end
