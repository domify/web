# A real TCP round-trip. Assertions read the status line, headers and body
# as frames, not as a bag of substrings. `IyiSocket` parks, so a read waits
# without `wait_readable`; closing the listener answers `Cancelled` on
# `accept` and the group ends.
module web/server_test

import std/socket::{IyiSocket}
import std/http::{HTTP}
import web/router::{Router, RouteHandler}
import web/handler::{chain, Handler}
import web/context::{Context}
import web/server::{Server}
import web/config::{Config}
import web/log::{Logger}
import web/harness::*
import web/spec::*

import web/router::{RouteAction, Route, SocketRoute}
import web/radix::{Tree}
import web/context::{Context}
import web/body::{IntoBody}
import web/event_stream::{EventStream}

class Route1 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "home"
  end
end

class Route2 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "Hello, #{env.params.url["name"]}!"
  end
end

class Route3 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.content_type = "application/json"
    "{}"
  end
end

class Route4 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    # On the tape of the request, which the server opened.
    env.response.send(String.build(16) { |buf| buf.append("from the tape") })
    ""
  end
end

class Route5 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.request.body
  end
end

class Route6 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.params.body["name"]
  end
end

class Route7 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "put"
  end
end

class Route8 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.redirect("/there")
    ""
  end
end

class Route9 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.redirect(env.params.query["to"]? || "/")
    ""
  end
end

class Route10 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "nope"
  end
end

class Route11 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    raise "kaboom <b>" if env.request.path == "/boom"
    "unreachable"
  end
end

class Route12 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    raise "handler failed" if env.request.path == "/boom-twice"
    "unreachable"
  end
end

class Route13 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    raise "handler failed" if env.request.path == "/boom-json"
    "unreachable"
  end
end

class Route14 < RouteAction
  pub def call(context : Context) : String
    EventStream.serve(context) do |stream|
      perform(stream, context)
      nil
    end
    ""
  end

  private def perform(stream : EventStream, env : Context)
    stream.send("one", event: "tick")
    stream.send("two", event: "tick")
  end
end

class Route15 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.print("one")
    env.response.flush
    env.response.print("two")
    ""
  end
end

class Route16 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    upload = env.params.files["file"]?
    upload ? upload.path + "|" + upload.read : "none"
  end
end


def read_frame(client : IyiSocket) : String
  buffer = String::Builder.new
  loop do
    size = http_frame_size(buffer.finish)
    break if size && buffer.bytesize >= size
    chunk = client.read(4096).or_panic
    break if chunk.empty?
    buffer.append(chunk)
  end
  size = http_frame_size(buffer.finish)
  size && size <= buffer.bytesize ? buffer.finish[0, size] : buffer.finish
end

@[OnTape]
pub struct LogLine
  getter text : String
  def initialize(@text : String)
  end
end

class PostedLogger < Logger
  pub def write(message : String) : Nil
    raise "log queue full" unless RisBoard.post(LogLine.new(message))
  end
end

class Collected < Logger
  def initialize
    @text = String::Builder.new
    @rows = [] of Tuple(Int32, Int32)
  end

  pub def write(message : String) : Nil
    at = @text.bytesize
    @text.append(message)
    @rows << {at, message.bytesize}
  end

  def lines : Array(String)
    loop do
      result = RisBoard.poll(LogLine)
      break if result.is_a?(Cancelled) || !result[1]
      line = result[0]
      write(line.text) if line
    end
    @rows.map { |row| @text.finish[row[0], row[1]] }
  end
end

def close_request(method : String, path : String, extra : String = "") : String
  "#{method} #{path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n#{extra}\r\n"
end

@[OnTape]
pub struct Settings
  getter max_body : Int32
  getter show : Bool
  getter logging : Bool
  def initialize(config : Config)
    @max_body = config.max_request_body_size
    @show = config.show_exceptions?
    @logging = config.logging
  end
end

pub class Routes
  def self.with_handler(settings : Settings,
                        & : Handler, Config -> Nil) : Nil
    options = Config.new
    options.logging = settings.logging
    options.show_exceptions = settings.show
    options.powered_by_header = true
    options.max_request_body_size = settings.max_body
    logger = PostedLogger.new
    options.logger = logger
    router = Router.new("")
    route_action_1 = Route1.new
    router.get("/", route_action_1)
    route_action_2 = Route2.new
    router.get("/hello/:name", route_action_2)
    route_action_3 = Route3.new
    router.get("/json", route_action_3)
    route_action_4 = Route4.new
    router.get("/tape", route_action_4)
    route_action_5 = Route5.new
    router.post("/echo", route_action_5)
    route_action_6 = Route6.new
    router.post("/form", route_action_6)
    route_action_7 = Route7.new
    router.put("/item", route_action_7)
    route_action_8 = Route8.new
    router.get("/go", route_action_8)
    route_action_9 = Route9.new
    router.get("/go-to", route_action_9)
    route_action_10 = Route10.new
    router.error(404, route_action_10)
    route_action_11 = Route11.new
    router.get("/boom", route_action_11)
    route_action_12 = Route12.new
    router.get("/boom-twice", route_action_12)
    route_action_13 = Route13.new
    router.get("/boom-json", route_action_13)
    route_action_14 = Route14.new
    router.get("/events", route_action_14)
    route_action_15 = Route15.new
    router.get("/stream", route_action_15)
    route_action_16 = Route16.new
    router.post("/upload", route_action_16)

    tree = Tree(Int32).new
    sockets = Tree(Int32).new
    routed = RouteHandler.new(tree, sockets, options)
    routed.load(router)
    yield routed, options
  end

  def self.error_page(settings : Settings, request) : String
    raise "page failed" if request.path == "/boom-twice"
    request.path == "/boom-json" ? "{\"error\":\"sorry\"}" :
      "sorry: " + request.path
  end

  def self.error_content_type(request) : String
    request.path == "/boom-json" ? "application/json; charset=utf-8" :
      "text/html; charset=utf-8"
  end
end

pub class DirectFactory
  def self.with_handler(settings : Settings,
                        & : Handler, Config -> Nil) : Nil
    Routes.with_handler(settings) do |handler, options|
      yield handler, options
    end
  end

  def self.error_page(settings : Settings, request) : String
    Routes.error_page(settings, request)
  end

  def self.error_content_type(request) : String
    Routes.error_content_type(request)
  end

  def self.listening(port : Int32) : Nil
    server_listening(DirectFactory, port)
  end
end

pub class ExchangeFactory
  def self.with_handler(settings : Settings,
                        & : Handler, Config -> Nil) : Nil
    Routes.with_handler(settings) do |handler, options|
      yield handler, options
    end
  end

  def self.error_page(settings : Settings, request) : String
    Routes.error_page(settings, request)
  end

  def self.error_content_type(request) : String
    Routes.error_content_type(request)
  end

  def self.listening(port : Int32) : Nil
    server_listening(ExchangeFactory, port)
  end
end

def exchange(config : Config, request : String) : String
  buffer = String::Builder.new
  with_server(Settings.new(config), ExchangeFactory, tasks: 1) do |server|
    client = IyiSocket.connect("127.0.0.1", server.bound_port).or_panic
    client.write(request).or_panic
    loop do
      chunk = client.read(4096).or_panic
      break if chunk.empty?
      buffer.append(chunk)
    end
    client.close
  end
  buffer.finish
end

def run_suite : Nil
  describe "Server" do
    it "serves GET with Date, powered-by and Connection: close" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      home = exchange(cfg, close_request("GET", "/"))
      assert status_line(home) == "HTTP/1.1 200 OK"
      assert http_header(home, "X-Powered-By") == "web"
      assert http_header(home, "Connection") == "close"
      assert http_body(home) == "home"
      date = http_header(home, "Date")
      assert !date.nil?
      if dated = date
        assert dated.includes?("GMT")
      end
    end

    it "sends a body from the request's tape with its length" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      sent = exchange(cfg, close_request("GET", "/tape"))
      assert status_line(sent) == "HTTP/1.1 200 OK"
      assert http_header(sent, "Content-Length") == "13"
      assert http_body(sent) == "from the tape"
      head = exchange(cfg, close_request("HEAD", "/tape"))
      assert http_header(head, "Content-Length") == "13"
      assert http_body(head) == ""
    end

    it "percent-decodes a url param over TCP" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      named = exchange(cfg, close_request("GET", "/hello/dunya"))
      assert http_body(named) == "Hello, dunya!"
      spaced = exchange(cfg, close_request("GET", "/hello/a%20b"))
      assert http_body(spaced) == "Hello, a b!"
    end

    it "preserves Content-Type set by the route" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      json = exchange(cfg, close_request("GET", "/json"))
      assert http_header(json, "Content-Type") == "application/json"
      assert http_body(json) == "{}"
    end

    it "echoes a POST body, including an empty one and a body larger than one read" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      echoed = exchange(cfg, close_request("POST", "/echo", "Content-Length: 5\r\n") + "hello")
      assert http_body(echoed) == "hello"

      empty = exchange(cfg, close_request("POST", "/echo", "Content-Length: 0\r\n"))
      assert http_body(empty) == ""

      payload = "x" * 5000
      bulky = exchange(cfg, close_request("POST", "/echo", "Content-Length: 5000\r\n") + payload)
      assert http_body(bulky) == payload
    end

    it "answers Expect: 100-continue before the body, then the request" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      with_server(Settings.new(cfg), DirectFactory) do |server|
        port = server.bound_port
        client = IyiSocket.connect("127.0.0.1", port).or_panic
        client.write(close_request("POST", "/echo", "Expect: 100-continue\r\nContent-Length: 5\r\n")).or_panic
        interim_io = String::Builder.new
        while interim_io.bytesize < 25
          chunk = client.read(25 - interim_io.bytesize).or_panic
          break if chunk.empty?
          interim_io.append(chunk)
        end
        interim = interim_io.finish
        assert interim == "HTTP/1.1 100 Continue\r\n\r\n"
        client.write("hello").or_panic
        final = read_frame(client)
        client.close
        assert status_line(final) == "HTTP/1.1 200 OK"
        assert http_body(final) == "hello"
      end
    end

    it "decodes a chunked POST body" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      chunked = exchange(cfg, close_request("POST", "/echo", "Transfer-Encoding: chunked\r\n") + "3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n")
      assert http_body(chunked) == "abcde"
    end

    it "parses a form body" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      form = exchange(cfg, close_request("POST", "/form", "Content-Type: application/x-www-form-urlencoded\r\nContent-Length: 8\r\n") + "name=iyi")
      assert http_body(form) == "iyi"
    end

    it "dispatches PUT" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      put = exchange(cfg, close_request("PUT", "/item"))
      assert http_body(put) == "put"
    end

    it "omits the body on HEAD and keeps Content-Length" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      headed = exchange(cfg, close_request("HEAD", "/"))
      assert status_line(headed) == "HTTP/1.1 200 OK"
      assert http_header(headed, "Content-Length") == "4"
      assert http_body(headed) == ""
    end

    it "redirects with Location" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      go = exchange(cfg, close_request("GET", "/go"))
      assert status_line(go) == "HTTP/1.1 302 Found"
      assert http_header(go, "Location") == "/there"
    end

    it "serves a custom 404 over TCP" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      missing = exchange(cfg, close_request("GET", "/nope"))
      assert status_line(missing) == "HTTP/1.1 404 Not Found"
      assert http_body(missing) == "nope"
    end

    it "rejects a lowercase method as 405" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      low = exchange(cfg, close_request("get", "/"))
      assert status_line(low) == "HTTP/1.1 405 Method Not Allowed"
    end

    it "answers a malformed request with 400" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      bad = exchange(cfg, "GET / HTTP/1.1\r\nNotAHeader\r\n\r\n")
      assert status_line(bad) == "HTTP/1.1 400 Bad Request"
      assert http_header(bad, "Connection") == "close"
      short = exchange(cfg, "GET\r\n\r\n")
      assert status_line(short) == "HTTP/1.1 400 Bad Request"
    end

    it "answers a Content-Length above the cap with 413 before reading the body" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      cfg.max_request_body_size = 8
      huge = exchange(cfg, close_request("POST", "/echo", "Content-Length: 20\r\n") + "xxxxxxxxxxxxxxxxxxxx")
      assert status_line(huge) == "HTTP/1.1 413 Content Too Large"
      assert http_header(huge, "Connection") == "close"
      early = exchange(cfg, close_request("POST", "/echo", "Content-Length: 5000000\r\n"))
      assert status_line(early) == "HTTP/1.1 413 Content Too Large"
      cfg.max_request_body_size = 8 * 1024 * 1024
    end

    it "serves a second request on a keep-alive connection" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      with_server(Settings.new(cfg), DirectFactory) do |server|
        port = server.bound_port
        alive = IyiSocket.connect("127.0.0.1", port).or_panic
        alive.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        first = read_frame(alive)
        assert status_line(first) == "HTTP/1.1 200 OK"
        assert http_header(first, "Connection") == "keep-alive"
        assert http_body(first) == "home"
        alive.write("GET /json HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").or_panic
        second_io = String::Builder.new
        loop do
          chunk = alive.read(4096).or_panic
          break if chunk.empty?
          second_io.append(chunk)
        end
        second = second_io.finish
        alive.close
        assert http_body(second) == "{}"
        assert http_header(second, "Connection") == "close"
      end
    end

    it "sends server-sent events as they are written" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      events = exchange(cfg, close_request("GET", "/events"))
      assert status_line(events) == "HTTP/1.1 200 OK"
      assert http_header(events, "Content-Type") == "text/event-stream; charset=utf-8"
      assert http_header(events, "Transfer-Encoding") == "chunked"
      assert http_body(events) == "17\r\nevent: tick\ndata: one\n\n\r\n17\r\nevent: tick\ndata: two\n\n\r\n0\r\n\r\n"
    end

    it "streams a flushed response in chunks and keeps the connection" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      with_server(Settings.new(cfg), DirectFactory) do |server|
        port = server.bound_port
        streamed = exchange(cfg, close_request("GET", "/stream"))
        assert status_line(streamed) == "HTTP/1.1 200 OK"
        assert http_header(streamed, "Transfer-Encoding") == "chunked"
        assert http_body(streamed) == "3\r\none\r\n3\r\ntwo\r\n0\r\n\r\n"

        alive = IyiSocket.connect("127.0.0.1", port).or_panic
        alive.write("GET /stream HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        first_io = String::Builder.new
        until first_io.finish.ends_with?("0\r\n\r\n")
          first_io.append(alive.read(4096).or_panic)
        end
        first = first_io.finish
        assert http_header(first, "Connection") == "keep-alive"
        alive.write("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").or_panic
        second_io = String::Builder.new
        loop do
          chunk = alive.read(4096).or_panic
          break if chunk.empty?
          second_io.append(chunk)
        end
        second = second_io.finish
        alive.close
        assert http_body(second) == "home"
      end
    end

    it "receives a multipart upload and deletes its file after responding" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      body = "--XyZ\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.bin\"\r\n\r\nbytes\u0000\r\nhere\r\n--XyZ--\r\n"
      sent = exchange(cfg, close_request("POST", "/upload", "Content-Type: multipart/form-data; boundary=XyZ\r\nContent-Length: #{body.bytesize}\r\n") + body)
      assert status_line(sent) == "HTTP/1.1 200 OK"
      parts = http_body(sent).split('|')
      assert parts.size == 2
      assert parts[1] == "bytes\u0000\r\nhere"
      assert !File.exists?(parts[0])
    end

    it "answers a panicking route with the error 500 page and closes" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      boom = exchange(cfg, "GET /boom HTTP/1.1\r\nHost: localhost\r\n\r\n")
      assert status_line(boom) == "HTTP/1.1 500 Internal Server Error"
      assert http_header(boom, "Connection") == "close"
      assert http_body(boom) == "sorry: /boom"
    end

    it "sends the error 500 page a helper wrote" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      boom = exchange(cfg, close_request("GET", "/boom-json"))
      assert status_line(boom) == "HTTP/1.1 500 Internal Server Error"
      assert http_header(boom, "Content-Type") == "application/json; charset=utf-8"
      assert http_body(boom) == "{\"error\":\"sorry\"}"
    end

    it "falls back to the built-in 500 page when the error page panics" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      cfg.show_exceptions = true
      shown = exchange(cfg, close_request("GET", "/boom-twice"))
      assert status_line(shown) == "HTTP/1.1 500 Internal Server Error"
      assert http_body(shown).includes?("handler failed")
      assert http_header(shown, "Content-Security-Policy") == "default-src 'none'; style-src 'unsafe-inline'"

      cfg.show_exceptions = false
      hidden = exchange(cfg, close_request("GET", "/boom-twice"))
      assert status_line(hidden) == "HTTP/1.1 500 Internal Server Error"
      assert !http_body(hidden).includes?("handler failed")
    end

    it "logs the 500 a panicking route gets through the configured logger" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      previous = cfg.logger
      collected = Collected.new
      cfg.logger = collected
      cfg.logging = true
      exchange(cfg, close_request("GET", "/boom"))
      assert collected.lines.size == 1
      assert collected.lines[0].starts_with?("GET /boom 500 ")
      assert collected.lines[0].ends_with?("ms")

      cfg.logging = false
      exchange(cfg, close_request("GET", "/boom"))
      assert collected.lines.size == 1
      cfg.logger = previous
    end

    it "keeps other connections open when one request panics" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      with_server(Settings.new(cfg), DirectFactory) do |server|
        port = server.bound_port
        alive = IyiSocket.connect("127.0.0.1", port).or_panic
        alive.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert http_body(read_frame(alive)) == "home"

        boom = exchange(cfg, close_request("GET", "/boom"))
        assert status_line(boom) == "HTTP/1.1 500 Internal Server Error"

        alive.write("GET /json HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        again = read_frame(alive)
        alive.close
        assert status_line(again) == "HTTP/1.1 200 OK"
        assert http_body(again) == "{}"
      end
    end

    it "refuses a redirect to a location carrying CR and LF" do
      cfg = Config.new
      cfg.logging = false
      cfg.serve_static = false
      cfg.powered_by_header = true
      forged = exchange(cfg, close_request("GET", "/go-to?to=/next%0d%0aSet-Cookie:%20injected=1"))
      assert status_line(forged) == "HTTP/1.1 500 Internal Server Error"
      assert http_header(forged, "Set-Cookie").nil?
    end
  end
end

run_suite
