# A request's bytes as they come off a connection, parsed once they are
# all there.
#
# Parsing the whole buffer again after every read, and growing it by
# concatenation, made a body cost the square of its size: an 8 MB upload
# took 1.3 s of the server's time, and 64 MB 18.5 s. The bytes are kept in
# a buffer that grows by doubling instead, the head's end is searched for
# only in what is new, and `std/http`'s parser runs once the request is
# whole: when `Content-Length` bytes have followed the head, or when a
# chunked body's last chunk has arrived. `Server.parse_head` reads the head
# on the request's tape, where its bytes are, and the `Request` is built
# from its views. A chunked body is decoded here as
# it arrives, since `std/http` decodes one by concatenating its chunks.
#
# The framing is read from the head the way `std/http` reads it, and what
# it cannot agree on is refused rather than guessed at: two
# `Content-Length`s that differ, or more than one `Transfer-Encoding`.
#
# The bytes are on the tape of the request's `Tape.scope`, read into it
# straight from the socket, and the framing is read from them in place:
# until the parser runs, a request costs the collector nothing. What leaves
# - the `Request`, the bytes after it - is copied out as heap strings.
module web/intake

import std/http::{HTTP, Server, ParsedHead, HeadError, Field}
import web/request::{Request, ParseError, request_from}
import std/text

# `std/http`'s bound on a request's head.
MAX_HEAD = 1048576

# A chunk-size line, extensions included, or a trailer line.
MAX_CHUNK_LINE = 4096

SIZE_LINE  = 0
CHUNK_DATA = 1
CHUNK_END  = 2
TRAILERS   = 3

# The body is larger than the server takes; the answer is `413`.
pub struct TooLarge
end

@[OnTape]
pub struct Intake
  @bytes : TapeWriter
  @body : TapeWriter
  @max_body : Int32
  @searched : Int32
  @head_end : Int32
  @need : Int32
  @chunked : Bool
  @scan : Int32
  @state : Int32
  @remaining : Int32
  @continue : Bool
  @declared : Int32
  @head : ParsedHead?

  # *leftover* is what the connection's last request left unread.
  def initialize(leftover : String, @max_body : Int32)
    @bytes = TapeWriter.new(leftover.bytesize < 4096 ? 4096 : leftover.bytesize)
    @body = TapeWriter.new(64)
    @searched = 0
    @head_end = -1
    @need = -1
    @chunked = false
    @scan = 0
    @state = SIZE_LINE
    @remaining = 0
    @continue = false
    @declared = 0
    @head = nil
    append(leftover)
  end

  pub def append(chunk : String) : Nil
    @bytes.append(chunk.to_unsafe, chunk.bytesize)
  end

  pub def append(bytes : Pointer(UInt8), count : Int32) : Nil
    @bytes.append(bytes, count)
  end

  # No byte of a request has arrived.
  pub def empty? : Bool
    @bytes.length == 0
  end

  # True once, when the head asked for `100 Continue` and has been read
  # without being refused: the client waits for it before sending the
  # body (curl waits a second for any body over a megabyte).
  pub def continue_due? : Bool
    return false unless @continue
    @continue = false
    true
  end

  # The request with what follows it and whether the client asked to
  # close, a refusal, or nil when more has to arrive.
  pub def take : Tuple(Request, String, Bool) | ParseError | TooLarge | Nil
    if @head_end < 0
      unless find_head_end
        return ParseError.new("request headers past #{MAX_HEAD} bytes") if @bytes.length > MAX_HEAD
        return nil
      end
      # The head is read once, on the tape, as soon as it is whole: its
      # framing says how much body follows, and the request is built from
      # the same views once that has arrived.
      case head = Server.parse_head(@bytes.finish)
      in Nil
        return nil
      in HeadError
        return ParseError.new(head.message)
      in ParsedHead
        @head = head
        refused = read_framing(head)
        return refused if refused
      end
    end
    @chunked ? take_chunked : take_sized
  end

  private def take_sized : Tuple(Request, String, Bool) | ParseError | TooLarge | Nil
    return nil if @bytes.length < @need
    head = @head
    return ParseError.new("incomplete request") unless head
    body = @declared > 0 ? copy(@bytes, head.body_start, @declared) : ""
    finish(request_from(head, body), head.body_start + @declared)
  end

  private def take_chunked : Tuple(Request, String, Bool) | ParseError | TooLarge | Nil
    case ended = decode_chunks
    in Nil
      nil
    in ParseError
      ended
    in TooLarge
      ended
    in Int32
      head = @head
      return ParseError.new("incomplete request") unless head
      finish(request_from(head, copy(@body, 0, @body.length)), ended)
    end
  end

  # The request with what the client sent after it, from *at* on.
  private def finish(built : Tuple(Request, Bool) | ParseError, at : Int32) : Tuple(Request, String, Bool) | ParseError
    case built
    in ParseError
      built
    in Tuple(Request, Bool)
      rest = at < @bytes.length ? copy(@bytes, at, @bytes.length - at) : ""
      {built[0], rest, built[1]}
    end
  end

  # Looks for the blank line that ends the head in what arrived since the
  # last look; true once it is there.
  private def find_head_end : Bool
    p = @bytes.finish.to_unsafe
    n = @bytes.length
    i = @searched > 3 ? @searched - 3 : 0
    while i + 3 < n
      if p[i] == 13_u8 && p[i + 1] == 10_u8 && p[i + 2] == 13_u8 && p[i + 3] == 10_u8
        @head_end = i
        return true
      end
      i = i + 1
    end
    @searched = n
    false
  end

  # How much body follows *head*, read from its fields where they lie.
  private def read_framing(head : ParsedHead) : ParseError | TooLarge | Nil
    body_start = head.body_start
    fields = head.fields
    length = nil.as(Field?)
    lengths_differ = false
    encodings = 0
    chunked = false
    expects = false
    i = 0
    while i < fields.size
      f = fields[i]
      name = f.name
      if HTTP.same_name?(name.to_unsafe, name.bytesize, "Content-Length")
        if first = length
          lengths_differ = true unless same_bytes?(first.value, f.value)
        else
          length = f
        end
      elsif HTTP.same_name?(name.to_unsafe, name.bytesize, "Transfer-Encoding")
        encodings = encodings + 1
        chunked = HTTP.same_name?(f.value.to_unsafe, f.value.bytesize, "chunked")
      elsif HTTP.same_name?(name.to_unsafe, name.bytesize, "Expect")
        expects = HTTP.same_name?(f.value.to_unsafe, f.value.bytesize, "100-continue")
      end
      i = i + 1
    end
    # An HTTP/1.0 client does not know the interim answer.
    expects = false if head.http10?

    return ParseError.new("more than one Transfer-Encoding") if encodings > 1
    if encodings == 1
      if chunked
        @chunked = true
        @scan = body_start
        @continue = expects
      else
        # Not chunked: `request_from` refuses it.
        @need = body_start
      end
      return nil
    end

    @need = body_start
    return nil unless length
    return ParseError.new("Content-Length given twice, differently") if lengths_differ
    declared = HTTP.content_length(length.value.to_s)
    # Not a length: `request_from` refuses it.
    return nil unless declared
    return TooLarge.new if declared > @max_body.to_i64
    @declared = declared.to_i32
    @need = body_start + @declared
    @continue = expects && declared > 0
    nil
  end

  private def same_bytes?(a : TapeString, b : TapeString) : Bool
    return false unless a.bytesize == b.bytesize
    i = 0
    while i < a.bytesize
      return false unless a.to_unsafe[i] == b.to_unsafe[i]
      i = i + 1
    end
    true
  end

  # Decodes what has arrived of a chunked body into `@body`: the index just
  # past the body's end once it has all arrived, nil until then.
  private def decode_chunks : Int32 | ParseError | TooLarge | Nil
    p = @bytes.finish.to_unsafe
    n = @bytes.length
    while @scan < n
      if @state == SIZE_LINE
        line_end = find_crlf(@scan)
        unless line_end
          return ParseError.new("chunk size line too long") if n - @scan > MAX_CHUNK_LINE
          return nil
        end
        size = chunk_size(@scan, line_end)
        return ParseError.new("not a chunk size") if size < 0
        return TooLarge.new if @body.length.to_i64 + size > @max_body.to_i64
        @scan = line_end + 2
        if size == 0
          @state = TRAILERS
        else
          @remaining = size.to_i32
          @state = CHUNK_DATA
        end
      elsif @state == CHUNK_DATA
        take = n - @scan
        take = @remaining if @remaining < take
        @body.append(p + @scan, take)
        @scan = @scan + take
        @remaining = @remaining - take
        @state = CHUNK_END if @remaining == 0
      elsif @state == CHUNK_END
        return nil if n - @scan < 2
        return ParseError.new("a chunk is not followed by CRLF") unless p[@scan] == 13_u8 && p[@scan + 1] == 10_u8
        @scan = @scan + 2
        @state = SIZE_LINE
      else
        line_end = find_crlf(@scan)
        unless line_end
          return ParseError.new("trailer line too long") if n - @scan > MAX_CHUNK_LINE
          return nil
        end
        return line_end + 2 if line_end == @scan
        @scan = line_end + 2
      end
    end
    nil
  end

  # The chunk size written between *from* and *to*, without its
  # extensions and blanks; -1 when it is not hexadecimal. Eight digits at
  # most, which is more than any body the server takes.
  private def chunk_size(from : Int32, to : Int32) : Int64
    p = @bytes.finish.to_unsafe
    last = from
    while last < to && p[last] != 59_u8
      last = last + 1
    end
    first = from
    while first < last && (p[first] == 32_u8 || p[first] == 9_u8)
      first = first + 1
    end
    while last > first && (p[last - 1] == 32_u8 || p[last - 1] == 9_u8)
      last = last - 1
    end
    return -1_i64 if last == first || last - first > 8
    value = 0_i64
    i = first
    while i < last
      byte = p[i]
      digit = if byte >= 48_u8 && byte <= 57_u8
                byte.to_i64 - 48_i64
              elsif byte >= 97_u8 && byte <= 102_u8
                byte.to_i64 - 87_i64
              elsif byte >= 65_u8 && byte <= 70_u8
                byte.to_i64 - 55_i64
              else
                -1_i64
              end
      return -1_i64 if digit < 0
      value = value * 16_i64 + digit
      i = i + 1
    end
    value
  end

  private def find_crlf(from : Int32) : Int32?
    p = @bytes.finish.to_unsafe
    n = @bytes.length
    i = from
    while i + 1 < n
      return i if p[i] == 13_u8 && p[i + 1] == 10_u8
      i = i + 1
    end
    nil
  end




  private def copy(buffer : TapeWriter, from : Int32, count : Int32) : String
    source = buffer.finish.to_unsafe + from
    String.new(count) do |target|
      target.copy_from(source, count)
    end
  end
end
