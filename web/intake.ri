# A request's bytes as they come off a connection, parsed once they are
# all there.
#
# Parsing the whole buffer again after every read, and growing it by
# concatenation, made a body cost the square of its size: an 8 MB upload
# took 1.3 s of the server's time, and 64 MB 18.5 s. The bytes are kept in
# a buffer that grows by doubling instead, the head's end is searched for
# only in what is new, and `std/http`'s parser runs once the request is
# whole: when `Content-Length` bytes have followed the head, or when a
# chunked body's last chunk has arrived. `Server.parse_head` reads the head
# on the request's tape, where its bytes are, and the `Request` is built
# from its views. A chunked body is decoded here as
# it arrives, since `std/http` decodes one by concatenating its chunks.
#
# The framing is read from the head the way `std/http` reads it, and what
# it cannot agree on is refused rather than guessed at: two
# `Content-Length`s that differ, or more than one `Transfer-Encoding`.
#
# The bytes are on the tape of the request's `tape`, read into it
# straight from the socket, and the framing is read from them in place:
# until the parser runs, a request costs the collector nothing. What leaves
# - the `Request`, the bytes after it - is copied out as heap strings.
#
# Only the bytes grow while a request comes in (TAPE_DESIGN.md, "Layout"):
# `ready` reads the framing from a head parsed on a `local_tape` of its
# own, reserves room for a sized body, and checks a chunked one without
# copying it; `take`, once `ready`, parses the head on the request's tape
# and decodes a chunked body straight into the request's heap string.
module web/intake

import std/http::{HTTP, Server, ParsedHead, HeadError, Field}
import web/request::{Request, ParseError, Arrived, request_from, arrived_from, content_length}
import std/text

# `std/http`'s bound on a request's head.
MAX_HEAD = 1048576

# A chunk-size line, extensions included, or a trailer line.
MAX_CHUNK_LINE = 4096

SIZE_LINE  = 0
CHUNK_DATA = 1
CHUNK_END  = 2
TRAILERS   = 3

# The body is larger than the server takes; the answer is `413`.
pub struct TooLarge
end

# What a head says about the body after it.
struct Framing
  getter need : Int32
  getter declared : Int32
  getter chunked : Bool
  getter body_start : Int32
  getter continue : Bool

  def initialize(@need, @declared, @chunked, @body_start, @continue)
  end
end

@[OnTape]
pub struct Intake
  @bytes : Tape::String::Writer
  @max_body : Int32
  @searched : Int32
  @head_end : Int32
  @framed : Bool
  @need : Int32
  @chunked : Bool
  @body_start : Int32
  @scan : Int32
  @state : Int32
  @remaining : Int32
  @body_size : Int64
  @end_at : Int32
  @continue : Bool
  @declared : Int32

  # *leftover* is what the connection's last request left unread.
  def initialize(leftover : String, @max_body : Int32)
    @bytes = Tape::String::Writer.new(leftover.bytesize < 4096 ? 4096 : leftover.bytesize)
    @searched = 0
    @head_end = -1
    @framed = false
    @need = -1
    @chunked = false
    @body_start = 0
    @scan = 0
    @state = SIZE_LINE
    @remaining = 0
    @body_size = 0_i64
    @end_at = -1
    @continue = false
    @declared = 0
    append(leftover)
  end

  pub def append(chunk : String) : Nil
    @bytes.append(chunk)
  end

  pub def append(bytes : Pointer(UInt8), count : Int32) : Nil
    @bytes.append(bytes, count)
  end

  # No byte of a request has arrived.
  pub def empty? : Bool
    @bytes.length == 0
  end

  # True once, when the head asked for `100 Continue` and has been read
  # without being refused: the client waits for it before sending the
  # body (curl waits a second for any body over a megabyte).
  pub def continue_due? : Bool
    return false unless @continue
    @continue = false
    true
  end

  # Whether the whole request has arrived, or a refusal. It puts nothing
  # on the request's tape, so a read loop grows only the bytes.
  pub def ready : Bool | ParseError | TooLarge
    unless @framed
      unless find_head_end
        return ParseError.new("request headers past #{MAX_HEAD} bytes") if @bytes.length > MAX_HEAD
        return false
      end
      bytes = @bytes.finish
      max_body = @max_body
      framed = nil.as(Framing | ParseError | TooLarge | Nil)
      local_tape do
        framed = Intake.framing(bytes, max_body)
      end
      case framed
      in Nil
        return ParseError.new("incomplete request")
      in ParseError
        return framed
      in TooLarge
        return framed
      in Framing
        @framed = true
        @need = framed.need
        @declared = framed.declared
        @chunked = framed.chunked
        @body_start = framed.body_start
        @scan = framed.body_start
        @continue = framed.continue
        @bytes.reserve(@need) unless @chunked
      end
    end
    @chunked ? scan_chunks : @bytes.length >= @need
  end

  # The request with what follows it and whether the client asked to
  # close, a refusal, or nil when more has to arrive. Parses the head on
  # the request's tape; a read loop calls `ready` and this once after it.
  pub def take : Tuple(Request, String, Bool) | ParseError | TooLarge | Nil
    case ready = self.ready
    in ParseError
      return ready
    in TooLarge
      return ready
    in Bool
      return nil unless ready
    end
    case head = Server.parse_head(@bytes.finish)
    in Nil
      ParseError.new("incomplete request")
    in HeadError
      ParseError.new(head.message)
    in ParsedHead
      if @chunked
        finish(request_from(head, decode_body), @end_at)
      else
        body = @declared > 0 ? copy(@bytes, head.body_start, @declared) : ""
        finish(request_from(head, body), head.body_start + @declared)
      end
    end
  end

  # `take` as an `Arrived`: the head's views and the body where they lie
  # on the request's tape. A chunked body is decoded once, on the heap.
  # Nil for an absolute-form target, which `take` reads instead.
  pub def take_arrived : Arrived | ParseError | TooLarge | Nil
    case ready = self.ready
    in ParseError
      return ready
    in TooLarge
      return ready
    in Bool
      return nil unless ready
    end
    case head = Server.parse_head(@bytes.finish)
    in Nil
      ParseError.new("incomplete request")
    in HeadError
      ParseError.new(head.message)
    in ParsedHead
      at = @chunked ? @end_at : head.body_start + @declared
      body = if @chunked
               decode_body.as_tape
             else
               @declared > 0 ? @bytes.finish[head.body_start, @declared] : "".as_tape
             end
      rest = at < @bytes.length ? copy(@bytes, at, @bytes.length - at) : ""
      arrived_from(head, body, rest)
    end
  end

  # The request with what the client sent after it, from *at* on.
  private def finish(built : Tuple(Request, Bool) | ParseError, at : Int32) : Tuple(Request, String, Bool) | ParseError
    case built
    in ParseError
      built
    in Tuple(Request, Bool)
      rest = at < @bytes.length ? copy(@bytes, at, @bytes.length - at) : ""
      {built[0], rest, built[1]}
    end
  end

  # Looks for the blank line that ends the head in what arrived since the
  # last look; true once it is there.
  private def find_head_end : Bool
    p = @bytes.finish
    n = @bytes.length
    i = @searched > 3 ? @searched - 3 : 0
    while i + 3 < n
      if p[i] == 13_u8 && p[i + 1] == 10_u8 && p[i + 2] == 13_u8 && p[i + 3] == 10_u8
        @head_end = i
        return true
      end
      i = i + 1
    end
    @searched = n
    false
  end

  # How much body follows the head in *bytes*, read from its fields where
  # they lie. Runs in a `local_tape`: the parsed head stays there.
  def self.framing(bytes : Tape::String, max_body : Int32) : Framing | ParseError | TooLarge | Nil
    head = Server.parse_head(bytes)
    case head
    in Nil
      return nil
    in HeadError
      return ParseError.new(head.message)
    in ParsedHead
    end
    body_start = head.body_start
    fields = head.fields
    length = nil.as(Field?)
    lengths_differ = false
    encodings = 0
    chunked = false
    expects = false
    i = 0
    while i < fields.size
      f = fields[i]
      name = f.name
      if HTTP.same_name?(name, "Content-Length")
        if first = length
          lengths_differ = true unless same_bytes?(first.value, f.value)
        else
          length = f
        end
      elsif HTTP.same_name?(name, "Transfer-Encoding")
        encodings = encodings + 1
        chunked = HTTP.same_name?(f.value, "chunked")
      elsif HTTP.same_name?(name, "Expect")
        expects = HTTP.same_name?(f.value, "100-continue")
      end
      i = i + 1
    end
    # An HTTP/1.0 client does not know the interim answer.
    expects = false if head.http10?

    return ParseError.new("more than one Transfer-Encoding") if encodings > 1
    # Not chunked: `request_from` refuses it.
    no_body = Framing.new(body_start, 0, false, body_start, false)
    if encodings == 1
      return chunked ? Framing.new(-1, 0, true, body_start, expects) : no_body
    end
    return no_body unless length
    return ParseError.new("Content-Length given twice, differently") if lengths_differ
    declared = content_length(length.value)
    # Not a length: `request_from` refuses it.
    return no_body unless declared
    return TooLarge.new if declared > max_body.to_i64
    Framing.new(body_start + declared.to_i32, declared.to_i32, false, body_start, expects && declared > 0)
  end

  private def self.same_bytes?(a : Tape::String, b : Tape::String) : Bool
    return false unless a.bytesize == b.bytesize
    i = 0
    while i < a.bytesize
      return false unless a[i] == b[i]
      i = i + 1
    end
    true
  end

  # Checks what has arrived of a chunked body, without copying it: true
  # once its last chunk and trailers are in (`@end_at` is just past them).
  private def scan_chunks : Bool | ParseError | TooLarge
    s = Tape::Scanner.new(@bytes.finish)
    s.offset = @scan
    # Kept at each step's start: a refusal comes before the step moves.
    while (@scan = s.offset) && !s.eos?
      if @state == SIZE_LINE
        line_end = find_crlf(s.offset)
        unless line_end
          return ParseError.new("chunk size line too long") if s.rest.bytesize > MAX_CHUNK_LINE
          return false
        end
        size = chunk_size(s.offset, line_end)
        return ParseError.new("not a chunk size") if size < 0
        return TooLarge.new if @body_size + size > @max_body.to_i64
        s.offset = line_end + 2
        if size == 0
          @state = TRAILERS
        else
          @remaining = size.to_i32
          @state = CHUNK_DATA
        end
      elsif @state == CHUNK_DATA
        take = s.rest.bytesize
        take = @remaining if @remaining < take
        @body_size = @body_size + take
        s.advance(take)
        @remaining = @remaining - take
        @state = CHUNK_END if @remaining == 0
      elsif @state == CHUNK_END
        return false if s.rest.bytesize < 2
        return ParseError.new("a chunk is not followed by CRLF") unless s.skip("\r\n")
        @state = SIZE_LINE
      else
        line_end = find_crlf(s.offset)
        unless line_end
          return ParseError.new("trailer line too long") if s.rest.bytesize > MAX_CHUNK_LINE
          return false
        end
        if line_end == s.offset
          @end_at = line_end + 2
          return true
        end
        s.offset = line_end + 2
      end
    end
    false
  end

  # The chunked body, checked by `scan_chunks`, decoded into one string.
  private def decode_body : String
    p = @bytes.finish
    total = @body_size.to_i32
    String.new(total) do |target|
      at = @body_start
      written = 0
      while written < total
        line_end = find_crlf(at) || at # checked by scan_chunks: always found
        size = chunk_size(at, line_end).to_i32
        at = line_end + 2
        k = 0
        while k < size
          target[written + k] = p[at + k]
          k = k + 1
        end
        written = written + size
        at = at + size + 2
      end
    end
  end

  # The chunk size written between *from* and *to*, without its
  # extensions and blanks; -1 when it is not hexadecimal. Eight digits at
  # most, which is more than any body the server takes.
  private def chunk_size(from : Int32, to : Int32) : Int64
    p = @bytes.finish
    last = from
    while last < to && p[last] != 59_u8
      last = last + 1
    end
    first = from
    while first < last && (p[first] == 32_u8 || p[first] == 9_u8)
      first = first + 1
    end
    while last > first && (p[last - 1] == 32_u8 || p[last - 1] == 9_u8)
      last = last - 1
    end
    return -1_i64 if last == first || last - first > 8
    value = 0_i64
    i = first
    while i < last
      byte = p[i]
      digit = if byte >= 48_u8 && byte <= 57_u8
                byte.to_i64 - 48_i64
              elsif byte >= 97_u8 && byte <= 102_u8
                byte.to_i64 - 87_i64
              elsif byte >= 65_u8 && byte <= 70_u8
                byte.to_i64 - 55_i64
              else
                -1_i64
              end
      return -1_i64 if digit < 0
      value = value * 16_i64 + digit
      i = i + 1
    end
    value
  end

  private def find_crlf(from : Int32) : Int32?
    p = @bytes.finish
    n = @bytes.length
    i = from
    while i + 1 < n
      return i if p[i] == 13_u8 && p[i + 1] == 10_u8
      i = i + 1
    end
    nil
  end


  # Where bytes leave the request's tape: the body, for the `Request` the
  # handler keeps, and what follows the request, for the connection's next.
  private def copy(buffer : Tape::String::Writer, from : Int32, count : Int32) : String
    buffer.finish[from, count].to_heap
  end
end
