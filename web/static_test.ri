# Static files from a real folder: MIME, index.html, HEAD, a missing file
# falling through, a `..` path that must not walk out of the folder, and
# the caching, compression and range behaviour a production server needs.
module web/static_test

import std/file::{File}
import std/compress::{Gzip}
import web/static::{StaticHandler}
import web/compress::{COMPRESS_MAX_SIZE}
import web/handler::{chain}
import web/file_body::{FileCache}
import web/context::{Context}
import web/harness::*
import web/router::{Router, RouteHandler}
import web/handler::{Handler}
import web/spec::*

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

import web/router::{Route, SocketRoute}
import web/radix::{Tree}
import web/config::{Config, StaticHeadersHook}

class Route1 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "from-route"
  end
end

class Route2 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "from-route"
  end
end

class Route3 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "from-route"
  end
end

class Route4 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "from-route"
  end
end


class Paths
  def initialize
    @text = String::Builder.new
    @rows = [] of Tuple(Int32, Int32)
  end

  def add(path : String) : Nil
    at = @text.bytesize
    @text.append(path)
    @rows << {at, path.bytesize}
  end

  def ==(values : Array(String)) : Bool
    @rows.map { |row| @text.finish[row[0], row[1]] } == values
  end
end

class HeaderObserver < StaticHeadersHook
  def initialize(@seen : Paths)
  end

  pub def call(context : Context, path : String, info : File::Info) : Nil
    @seen.add(path)
    context.response.headers["Cache-Control"] = "max-age=" + info.size.to_s
    nil
  end
end

ROOT = __DIR__ + "/fixtures"

def static_app(& : Handler -> Nil) : Nil
  static_app_at(ROOT) do |made26|
    yield made26
  end
end

def static_app_at(root : String, & : Handler -> Nil) : Nil
  router4 = Router.new("")
  route_action_1 = Route1.new
  router4.get("/fallback", route_action_1)
  route_options_1 = Config.new
  route_tree_1 = Tree(Int32).new
  socket_tree_1 = Tree(Int32).new
  route_handler_1 = RouteHandler.new(route_tree_1, socket_tree_1,
    route_options_1)
  route_handler_1.load(router4)
  routed4 = route_handler_1
  static = StaticHandler.new(root)
  cache = FileCache.new
  static.file_cache = cache
  handler = chain([static, routed4])
  yield handler
  nil
end

# *size* bytes of numbered lines, so every offset holds different text.
def numbered(size : Int32) : String
  lines = String::Builder.new
  total = 0
  index = 0
  while total < size
    digits = index.to_s
    line = "0" * (7 - digits.bytesize) + digits + "\n"
    lines.append(line)
    total = total + line.bytesize
    index = index + 1
  end
  lines.finish[0, size]
end

def static_example_1 : Nil
  hello = File.read(ROOT + "/hello.txt")
  static_app do |made27|
    dispatch(made27, "GET", "/hello.txt") do |ctx|
      assert ctx.response.body == hello
      assert ctx.response.content_type == "text/plain; charset=utf-8"
    end
  end
  nil
end

def static_example_2 : Nil
  static_app do |app|
    dispatch(app, "GET", "/app.css") do |made30|
      assert made30.response.content_type == "text/css; charset=utf-8"
    end
    dispatch(app, "GET", "/app.js") do |made31|
      assert made31.response.content_type == "text/javascript; charset=utf-8"
    end
    dispatch(app, "GET", "/data.json") do |made32|
      assert made32.response.content_type == "application/json; charset=utf-8"
    end
    dispatch(app, "GET", "/unknown.bin") do |made33|
      assert made33.response.content_type == "application/octet-stream"
    end
  end
  nil
end

def static_example_3 : Nil
  static_app do |made34|
    dispatch(made34, "GET", "/") do |ctx|
      assert ctx.response.body == File.read(ROOT + "/index.html")
      assert ctx.response.content_type == "text/html; charset=utf-8"
    end
  end
  nil
end

def static_example_4 : Nil
  hello = File.read(ROOT + "/hello.txt")
  static_app do |made36|
    dispatch(made36, "HEAD", "/hello.txt") do |ctx|
      assert ctx.response.body == ""
      assert ctx.response.headers["content-length"] == hello.bytesize.to_s
    end
  end
  nil
end

def static_example_5 : Nil
  static_app do |made38|
    dispatch(made38, "POST", "/hello.txt") do |made39|
      assert made39.response.status_code == 404
    end
  end
  nil
end

