  static_app do |made40|
    dispatch(made40, "GET", "/no-such-static.txt") do |made41|
      assert made41.response.status_code == 404
    end
  end
  nil
end

def static_example_7 : Nil
  static_app do |made42|
    dispatch(made42, "GET", "/../router.ri") do |walk|
      assert walk.response.status_code == 404
      assert !walk.response.body.includes?("Modular routing")

      static_app do |made44|
        dispatch(made44, "GET", "/foo/../../router.ri") do |nested|
          assert nested.response.status_code == 404
        end
      end
    end
  end
  nil
end

def static_example_8 : Nil
  static_app do |made46|
    dispatch(made46, "GET", "/fallback") do |made47|
      assert made47.response.body == "from-route"
    end
  end
  nil
end

def static_example_9 : Nil
  router5 = Router.new("")
  route_action_2 = Route2.new
  router5.get("/fallback", route_action_2)
  route_options_2 = Config.new
  route_tree_2 = Tree(Int32).new
  socket_tree_2 = Tree(Int32).new
  route_handler_2 = RouteHandler.new(route_tree_2, socket_tree_2,
    route_options_2)
  route_handler_2.load(router5)
  routed5 = route_handler_2
  listing = chain([StaticHandler.new(__DIR__), routed5])
  dispatch(listing, "GET", "/") do |made48|
    assert made48.response.status_code == 404
  end
  nil
end

def static_example_10 : Nil
  static_app do |made49|
    dispatch(made49, "GET", "/docs") do |moved|
      assert moved.response.status_code == 302
      assert moved.response.headers["location"] == "/docs/"
      static_app do |made51|
        dispatch(made51, "GET", "/docs/") do |made52|
          assert made52.response.body == File.read(ROOT + "/docs/index.html")
        end
      end
    end
  end
  nil
end

def static_example_11 : Nil
  router6 = Router.new("")
  route_action_3 = Route3.new
  router6.get("/fallback", route_action_3)
  route_options_3 = Config.new
  route_tree_3 = Tree(Int32).new
  socket_tree_3 = Tree(Int32).new
  route_handler_3 = RouteHandler.new(route_tree_3, socket_tree_3,
    route_options_3)
  route_handler_3.load(router6)
  routed6 = route_handler_3
  app = chain([StaticHandler.new(ROOT, dir_index: false, dir_listing: true),
    routed6])
  dispatch(app, "GET", "/") do |listing|
    assert listing.response.status_code == 200
    assert listing.response.body.includes?(
      "<a href=\"/hello.txt\">hello.txt</a>")
    assert listing.response.body.includes?("<a href=\"/docs/\">docs/</a>")
  end
  nil
end

def static_example_12 : Nil
  static_app do |made54|
    dispatch(made54, "GET", "/hello.txt") do |first|
      tag = first.response.headers["etag"]
      modified = first.response.headers["last-modified"]
      assert tag.starts_with?("W/\"")
      assert first.response.headers["x-content-type-options"] == "nosniff"
      assert first.response.headers["accept-ranges"] == "bytes"
      check_conditional_requests(tag, modified)
    end
  end
  nil
end

def check_conditional_requests(tag : String, modified : String) : Nil
  http_request("GET", "/hello.txt") do |again|
    again.headers["If-None-Match"] = "\"other\", " + tag
    static_app do |made57|
      dispatch(made57, again) do |cached|
        assert cached.response.status_code == 304
        assert cached.response.body == ""
      end
    end
  end
  http_request("GET", "/hello.txt") do |dated|
    dated.headers["If-Modified-Since"] = modified
    static_app do |made60|
      dispatch(made60, dated) do |made61|
        assert made61.response.status_code == 304
      end
    end
  end
  http_request("GET", "/hello.txt") do |stale|
    stale.headers["If-Modified-Since"] =
      "Sun, 06 Nov 1994 08:49:37 GMT"
    static_app do |made63|
      dispatch(made63, stale) do |made64|
        assert made64.response.status_code == 200
      end
    end
  end
  http_request("GET", "/hello.txt") do |other|
    other.headers["If-None-Match"] = "\"nope\""
    other.headers["If-Modified-Since"] = modified
    static_app do |made66|
      dispatch(made66, other) do |made67|
        assert made67.response.status_code == 200
      end
    end
  end
  nil
end

def static_example_13 : Nil
  http_request("GET", "/hello.txt") do |ranged|
    ranged.headers["Range"] = "bytes=0-4"
    static_app do |made69|
      dispatch(made69, ranged) do |part|
        assert part.response.status_code == 206
        assert part.response.body == "hello"
        assert part.response.headers["content-range"] == "bytes 0-4/12"
      end
    end
  end
  http_request("GET", "/hello.txt") do |beyond|
    beyond.headers["Range"] = "bytes=50-60"
    static_app do |made72|
      dispatch(made72, beyond) do |missed|
        assert missed.response.status_code == 416
        assert missed.response.headers["content-range"] == "bytes */12"
      end
    end
  end
  http_request("GET", "/hello.txt") do |two|
    two.headers["Range"] = "bytes=0-0,-1"
    static_app do |made75|
      dispatch(made75, two) do |multi|
        assert multi.response.status_code == 206
        assert multi.response.content_type.starts_with?(
          "multipart/byteranges; boundary=")
      end
    end
  end
  nil
end

def static_example_14 : Nil
  http_request("GET", "/large.txt") do |request|
    request.headers["Accept-Encoding"] = "gzip, deflate"
    static_app do |made78|
      dispatch(made78, request) do |packed|
        assert packed.response.headers["content-encoding"] == "gzip"
        assert packed.response.headers["vary"] == "Accept-Encoding"
        assert packed.response.headers["etag"].ends_with?("-gzip\"")
        assert Gzip.decompress(packed.response.body) == File.read(
          ROOT + "/large.txt")

        static_app do |made80|
          dispatch(made80, "GET", "/large.txt") do |plain|
            assert plain.response.headers["content-encoding"]?.nil?
            assert plain.response.headers["vary"] == "Accept-Encoding"
            assert plain.response.body == File.read(ROOT + "/large.txt")
          end
        end
      end
    end
  end
  nil
end

def static_example_15 : Nil
  File.tempfile("web-static-", ".bin") do |path|
    content = numbered(200000)
    File.write(path, content)
    static_app_at(File.dirname(path)) do |app|
      url = "/" + File.basename(path)

      dispatch(app, "GET", url) do |whole|
        assert whole.response.status_code == 200
        assert whole.response.headers["content-length"] == "200000"
        assert whole.response.body == content

        dispatch(app, "HEAD", url) do |headed|
          assert headed.response.status_code == 200
          assert headed.response.body == ""
          assert headed.response.headers["content-length"] == "200000"
          assert headed.response.headers["etag"] ==
            whole.response.headers["etag"]
          assert headed.response.headers["last-modified"] ==
            whole.response.headers["last-modified"]
          assert headed.response.headers["accept-ranges"] == "bytes"

          http_request("GET", url) do |ranged|
            ranged.headers["Range"] = "bytes=100000-"
            dispatch(app, ranged) do |part|
              assert part.response.status_code == 206
              assert part.response.headers["content-range"] ==
                "bytes 100000-199999/200000"
              assert part.response.body == content[100000, 100000]

              http_request("GET", url) do |cached|
                cached.headers["If-None-Match"] = whole.response.headers["etag"]
                dispatch(app, cached) do |unchanged|
                  assert unchanged.response.status_code == 304
                  assert unchanged.response.body == ""
                end
              end
            end
          end
        end
      end
    end
  end
  nil
end

def static_example_16 : Nil
  File.tempfile("web-static-", ".txt") do |path|
    content = numbered(COMPRESS_MAX_SIZE + 1)
    File.write(path, content[0, COMPRESS_MAX_SIZE])
    static_app_at(File.dirname(path)) do |app|
      url = "/" + File.basename(path)

      http_request("GET", url) do |at_limit|
        at_limit.headers["Accept-Encoding"] = "gzip"
        dispatch(app, at_limit) do |packed|
          assert packed.response.headers["content-encoding"] == "gzip"
          assert packed.response.headers["vary"] == "Accept-Encoding"
          assert Gzip.decompress(packed.response.body) == content[0,
            COMPRESS_MAX_SIZE]

          File.write(path, content)
          http_request("GET", url) do |over|
            over.headers["Accept-Encoding"] = "gzip"
            dispatch(app, over) do |plain|
              assert plain.response.headers["content-encoding"]?.nil?
              assert plain.response.headers["vary"]?.nil?
              assert !plain.response.headers["etag"].ends_with?("-gzip\"")
              assert plain.response.headers["content-length"] == (
                COMPRESS_MAX_SIZE + 1).to_s
              assert plain.response.body == content
            end
          end
        end
      end
    end
  end
  nil
end

def static_example_17 : Nil
  seen = Paths.new
  hook = HeaderObserver.new(seen)
  router7 = Router.new("")
  route_action_4 = Route4.new
  router7.get("/fallback", route_action_4)
  route_options_4 = Config.new
  route_tree_4 = Tree(Int32).new
  socket_tree_4 = Tree(Int32).new
  route_handler_4 = RouteHandler.new(route_tree_4, socket_tree_4,
    route_options_4)
  route_handler_4.load(router7)
  routed7 = route_handler_4
  app = chain([StaticHandler.new(ROOT, headers_hook: hook), routed7])
  dispatch(app, "GET", "/hello.txt") do |ctx|
    assert seen == [ROOT + "/hello.txt"]
    assert ctx.response.headers["cache-control"] == "max-age=12"
  end
  nil
end

def run_suite : Nil
  describe "StaticHandler" do
    it "serves a file with its MIME type" do
      static_example_1
    end

    it "maps common extensions" do
      static_example_2
    end

    it "serves index.html for a directory" do
      static_example_3
    end

    it "omits the body on HEAD and keeps the length" do
      static_example_4
    end

    it "does not serve a file for POST" do
      static_example_5
    end

    it "falls through when the file is missing" do
      static_example_6
    end

    it "refuses a path that walks out of the folder" do
      static_example_7
    end

    it "reaches the router when nothing is served" do
      static_example_8
    end

    it "does not File.read a directory that has no index.html" do
      static_example_9
    end

    it("redirects a directory without a trailing slash, then serves " +
      "its index") do
      static_example_10
    end

    it "lists a directory when dir_listing is on" do
      static_example_11
    end

    it "sends ETag and Last-Modified and answers a matching request with 304" do
      static_example_12
    end

    it "answers a byte range with 206 and an unsatisfiable one with 416" do
      static_example_13
    end

    it "compresses a large textual file for a client that accepts gzip" do
      static_example_14
    end

    it("sends a file larger than one chunk whole, by range, for " +
      "HEAD and as a 304") do
      static_example_15
    end

    it("compresses a textual file of up to COMPRESS_MAX_SIZE bytes " +
      "and sends a larger one as it is") do
      static_example_16
    end

    it "calls the headers hook with the served file" do
      static_example_17
    end
  end
end

run_suite
