# Request logging must not swallow the route's body or status, and writes
# through whichever `Logger` it was given.
module web/log_test

import web/log::{LogHandler, Logger}
import web/handler::{chain}
import web/context::{Context}
import web/harness::*
import web/router::{Router, RouteHandler}
import web/handler::{Handler}
import web/spec::*
import std/time::{Span}

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

import web/router::{Route, SocketRoute}
import web/radix::{Tree}
import web/config::{Config}

class Route1 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.status_code = 201
    "logged"
  end
end


class Lines
  def initialize
    @text = String::Builder.new
    @rows = [] of Tuple(Int32, Int32)
  end
  def add(value : String) : Nil
    at = @text.bytesize
    @text.append(value)
    @rows << {at, value.bytesize}
  end
  def size : Int32
    @rows.size
  end
  def [](index : Int32) : String
    at, size = @rows[index]
    @text.finish[at, size]
  end
  def ==(values : Array(String)) : Bool
    return false unless size == values.size
    index = 0
    while index < size
      return false unless self[index] == values[index]
      index += 1
    end
    true
  end
end

class Collected < Logger
  def initialize(@lines : Lines)
  end
  getter lines : Lines
  pub def write(message : String) : Nil
    @lines.add(message)
  end
end

# Replaces the line format: sees the context, never calls `write`.
class Statuses < Logger
  def initialize(@seen : Lines)
  end
  getter seen : Lines
  pub def request(ctx : Context, elapsed : Span) : Nil
    @seen.add(ctx.request.path + "=" + ctx.response.status_code.to_s)
  end
  pub def write(message : String) : Nil
    @seen.add("write")
  end
end

def logged_routes(& : Handler -> Nil) : Nil
  router3 = Router.new("")
  route_action_1 = Route1.new
  router3.get("/log", route_action_1)
  route_options_1 = Config.new
  route_tree_1 = Tree(Int32).new
  socket_tree_1 = Tree(Int32).new
  route_handler_1 = RouteHandler.new(route_tree_1, socket_tree_1, route_options_1)
  route_handler_1.load(router3)
  routed3 = route_handler_1
  yield routed3
end

def run_suite : Nil
  describe "LogHandler" do
    it "preserves the route's status and body" do
      logged_routes do |made18|
        handler = chain([LogHandler.new, made18])
        dispatch(handler, "GET", "/log") do |ctx|
          assert ctx.response.status_code == 201
          assert ctx.response.body == "logged"
        end
      end
    end

    it "writes one request line per request through its logger" do
      lines = Lines.new
      collected = Collected.new(lines)
      logged_routes do |made20|
        handler = chain([LogHandler.new(collected), made20])
        dispatch(handler, "GET", "/log") do |made21|
          nil
        end
        http_request("POST", "/missing", "q=1") do |made22|
          dispatch(handler, made22) do |made23|
            nil
          end
        end
        assert collected.lines.size == 2
        assert collected.lines[0].starts_with?("GET /log 201 ")
        assert collected.lines[0].ends_with?("ms")
        assert collected.lines[1].starts_with?("POST /missing 404 ")
      end
    end

    it "hands a logger that overrides request the finished context" do
      lines = Lines.new
      statuses = Statuses.new(lines)
      logged_routes do |made24|
        handler = chain([LogHandler.new(statuses), made24])
        dispatch(handler, "GET", "/log") do |made25|
          nil
        end
        assert statuses.seen == ["/log=201"]
      end
    end
  end
end

run_suite
