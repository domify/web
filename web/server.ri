# One `serve` binds one reuse-port listener; its workers share it, and whichever
# is free takes the next connection. Each owns its handler and connection.
# Stop messages drain requests; cancellation cuts them off without waiting.
module web/server

import std/http

import std/socket::{IyiSocket, SocketError}
import std/http::{HTTP, Field, ParsedHead, HeadError}
import std/html::{HTML}
import std/time::{Time, Span}
import web/handler::{Handler}
import web/context::{Context}
import web/params::{Params}
import web/request::{Request, ParseError, Arrived, arrived_from}
import web/headers::{Headers}
import web/intake::{Intake, TooLarge}
import web/response::{Response, Wire}
import web/config::{Config}
import web/http_date::*

# Connection reads are bounded and use checked builders.
READ_SIZE = 16384

# Keep the public helper while delegating socket ownership and cleanup
# to std/socket, which now supports SO_REUSEPORT directly.
pub def listen_reuse_port(host : String, port : Int32) : IyiSocket
  IyiSocket.listen(host, port, backlog: 1024, reuse_port: true)
end

@[OnTape]
pub struct PanicRequest
  getter method : String
  getter path : String
  getter headers : Array(Tuple(String, String))
  getter message : String

  def initialize(@method : String, @path : String,
                 @headers : Array(Tuple(String, String)), @message : String)
  end
end

pub struct ServerStop(F)
end

# Factory.with_handler(config) builds and borrows its task-local chain.
# Optional Factory.error_page(config, snapshot) returns copied page text.
pub class Server
  pub def self.serve(host : String, port : Int32, config : C,
                     factory : F.class,
                     tasks : Int32 = ::Std::Http::Server::MAX_CONNECTIONS) : Nil \
                     forall C, F
    raise "choose a port from 1 to 65535" unless port > 0 && port <= 65535
    raise "tasks must be positive" unless tasks > 0
    listener = IyiSocket.listen_result(host, port, backlog: 1024,
      reuse_port: true)
    raise listener.message if listener.is_a?(SocketError)
    defer listener.close
    bound = {listener.fd, listener.family, port, config}
    image = RisTaskConfig.new(bound)
    defer image.close
    group do |pool|
      tasks.times do
        supervise(pool, image, typeof(bound), factory, C)
      end
      0
    end
    nil
  end

  pub def self.serve_unix(path : String, config : C,
                          factory : F.class) : Nil forall C, F
    listener = IyiSocket.listen_unix(path)
    defer listener.close
    bound = {listener.fd, listener.family, -1, config}
    image = RisTaskConfig.new(bound)
    defer image.close
    group do |pool|
      supervise(pool, image, typeof(bound), factory, C)
      0
    end
    nil
  end

  pub def self.stop(factory : F.class, tasks : Int32) : Nil forall F
    tasks.times do
      unless RisBoard.post(ServerStop(F).new)
        raise "server stop queue is full"
      end
    end
  end

  # Call after join/cutoff from the uncancelled owner before reusing F.
  pub def self.clear_stops(factory : F.class) : Nil forall F
    loop do
      result = RisBoard.poll(ServerStop(F))
      break if result.is_a?(Cancelled) || !result[1]
    end
  end

  private def self.supervise(pool : IyiGroup, image : RisTaskConfig,
                             tuple_type : T.class, factory : F.class,
                             config_type : C.class) : Nil forall T, F, C
    pool.spawn do
      loop do
        break if IyiScheduler.current.cancelled
        result = group do |own|
          task = own.spawn do
            run_worker(image.read(T), factory, config_type)
          end
          task.value
        end
        break if result == 0
        break if sleep(5).is_a?(Cancelled)
      end
      0
    end
    nil
  end

  # The worker holds the shared listener under a descriptor of its own.
  private def self.run_worker(settings : Tuple(Int32, Int32, Int32, C),
                              factory : F.class,
                              config_type : C.class) : Int32 forall C, F
    fd, family, port, config = settings
    listener = IyiSocket.share_listener(fd, family)
    defer listener.close
    F.with_handler(config) do |handler, options|
      worker = Worker(C, F, typeof(handler)).new(handler, options,
        config, listener)
      {% if F.class.has_method?(:listening) %}
        F.listening(port)
      {% end %}
      worker.run
    end
    0
  end
end

class Worker(C, F, H)
  def initialize(@handler : H, @config : Config,
                 @settings : C, @listener : IyiSocket)
    @draining = false
    @in_flight = 0
    @date_second = -1_i64
    @date_text = String::Builder.new
  end

  def run : Nil
    until stopping?
      ready = IyiSocket.await_readable(@listener.fd, 100)
      break if ready.is_a?(Cancelled)
      next unless ready
      case client = @listener.accept_ready
      in Nil
      in Cancelled
        break
      in SocketError
        # A worker stopping has shut the listener for all of them.
        break if stopping? || sleep(5).is_a?(Cancelled)
      in IyiSocket
        serve_client(client)
      end
    end
  end

  private def serve_client(client : IyiSocket) : Nil
    defer client.close
    connection = Connection.new(client)
    client.write_timeout_ms = milliseconds(@config.write_timeout)
    serve_connection(connection)
  end

  private def stopping? : Bool
    return true if @draining || IyiScheduler.current.cancelled
    result = RisBoard.poll(ServerStop(F))
    if !result.is_a?(Cancelled) && result[1]
      @draining = true
      @listener.stop_listening
    end
    @draining || IyiScheduler.current.cancelled
  end

  # A timeout setting in seconds as the socket takes it; nil and 0 are none.
  private def milliseconds(seconds : Int32?) : Int32?
    return nil unless seconds
    return nil if seconds <= 0
    seconds >= 2147483 ? 2147483647 : seconds * 1000
  end

  # Each request runs inside its own `tape`: its bytes as they are
  # read, and its response as it is written, are on the tape and are gone
  # together when the response is out. The scope opens once the request's
  # first bytes are in, read onto the stack: a connection waiting for its
  # next request holds no tape.
  private def serve_connection(conn : Connection) : Nil
    client = conn.socket
    pending = String::Builder.new
    following = String::Builder.new
    requests = 0
    loop do
      following.clear
      if pending.bytesize == 0
        case got = await_request(conn, requests == 0, pending)
        in Closed
          return
        in TimedOut
          write_error(client, 408, "Request Timeout")
          return
        in Int32
        end
      end
      done = false
      tape do
        done = !serve_request(conn, client, pending.finish,
          requests, following)
      end
      return if done
      pending.clear
      pending.append(following.finish)
      requests = requests + 1
    end
  end

  # Waits for a request's first bytes and reads them into *into*: a
  # connection's first request has `read_timeout` from the accept, a later
  # one `idle_timeout`. Either is just `Closed` when nothing came.
  private def await_request(conn : Connection, first : Bool,
                            into : String::Builder) : Int32 | Closed | TimedOut
    client = conn.socket
    since = first ? conn.accepted : Time.monotonic
    timeout = milliseconds(first ? @config.read_timeout :
      @config.idle_timeout)
    loop do
      return Closed.new if client.closed? || stopping?
      wait = 100
      if timeout
        remaining = timeout.to_i64 - elapsed_ms(since)
        return Closed.new if remaining <= 0
        wait = remaining.to_i32 if remaining < wait
      end
      client.read_timeout_ms = wait
      case got = client.read(into, READ_SIZE)
      in Cancelled
        return Closed.new
      in SocketError
        return Closed.new unless got.timed_out?
      in Int32
        return got == 0 ? Closed.new : got
      end
    end
  end

  # One request off *conn*, read and answered: *count* bytes of it are
  # already at *start*. When the connection may carry another, what the
  # client sent after this one; nil otherwise.
  private def serve_request(conn : Connection, client : IyiSocket,
                            leftover : String, requests : Int32,
                            following : String::Builder) : Bool
    intake = Intake.new(@config.max_request_body_size)
    intake.append(leftover)
    ready = read_request(conn, intake, requests == 0)
    case ready
    in Closed
      return false
    in ParseError
      write_error(client, 400, "Bad Request")
      return false
    in TooLarge
      write_error(client, 413, "Content Too Large")
      return false
    in TimedOut
      write_error(client, 408, "Request Timeout")
      return false
    in Bool
    end
    alive = false
    fields = Array(Field).new
    paths = String::Builder.new
    case head = intake.request_head(fields)
    in ParsedHead
      body = intake.request_body
      case parsed = arrived_from(head, body, intake.rest, paths)
      in Arrived
        alive = answer(client, parsed,
          wants_keepalive?(parsed.close, requests))
      in Nil
        headers = Headers.new
        request = Request.new(head, body, headers)
        if request.refusal
          write_error(client, 400, "Bad Request")
        else
          alive = dispatch(client, request, intake.rest,
            wants_keepalive?(request.close, requests))
        end
      in ParseError
        write_error(client, 400, "Bad Request")
      end
    in HeadError, Nil
      write_error(client, 400, "Bad Request")
    end
    following.append(intake.rest) if alive
    alive
  end

  private def wants_keepalive?(wire_close : Bool, already : Int32) : Bool
    return false unless @config.keepalive
    return false if stopping?
    return false if wire_close
    already + 1 < @config.max_keepalive_requests
  end

  # Runs the chain for one request and writes its response. True when the
  # connection may carry another request. *leftover* is what the client
  # sent after this request, which a connection taken over (a WebSocket)
  # reads first.
  private def dispatch(client : IyiSocket, request : Request, leftover : String, keepalive : Bool) : Bool
    @in_flight = @in_flight + 1
    defer leave
    headers = Headers.new
    response = Response.new(headers)
    params = Params.new(request)
    ctx = Context.new(request, response, params)
    ctx.limit_uploads(@config.max_file_uploads, @config.max_multipart_form_field_size)
    ctx.max_ranges = @config.max_ranges
    ctx.file_cache = @handler.file_cache
    defer ctx.cleanup_params
    head = HTTP.same_name?(request.method, "HEAD")
    sink = SocketWire.new(client)
    ctx.response.attach(sink, client,
      wire_version(request), keepalive, head)
    stamp(ctx)
    {% if F.class.has_method?(:activity) %}
      F.activity(1)
    {% end %}
    defer finished_request
    state = RequestState.new
    defer recover_request(client, ctx, state)
    @handler.call(ctx)
    if ctx.upgrades? && ctx.response.status_code == 101
      state.started = true
      return take_over(client, ctx, leftover)
    end
    if conn = ctx.response.headers["connection"]?
      keepalive = false if conn.downcase == "close"
    end
    # Cut off at shutdown while the handler ran: nobody is left to answer.
    return false if client.closed? || IyiScheduler.current.cancelled
    keepalive = false if stopping?
    if ctx.response.headers_sent?
      ctx.response.finish
      keepalive = keepalive && ctx.response.reusable?
    else
      ctx.response.headers["Connection"] = keepalive ? "keep-alive" : "close"
      state.started = true
      send(client, ctx.response, wire_version(request), !head)
    end
    keepalive
  end

  # A request as it arrived, offered to the handler's `answer` first: one
  # that reads it on the tape answers it there, and no `Request` or
  # `Context` is made. Otherwise it becomes a `Request` and is dispatched.
  private def answer(client : IyiSocket, arrived : Arrived, keepalive : Bool) : Bool
    kept = answer_arrived(client, arrived, keepalive)
    return kept unless kept.nil?
    headers = Headers.new
    request = arrived.to_request(headers)
    if refusal = request.refusal
      write_error(client, 400, "Bad Request")
      false
    else
      dispatch(client, request, arrived.rest, keepalive)
    end
  end

  # `answer`'s handler call and its response, counted in flight: whether
  # the connection may carry another request, or nil when the handler
  # left the request to the chain.
  private def answer_arrived(client : IyiSocket, arrived : Arrived, keepalive : Bool) : Bool?
    @in_flight = @in_flight + 1
    defer leave
    headers = Headers.new
    response = Response.new(headers)
    head = arrived.head?
    version = arrived.http10? ? "HTTP/1.0" : "HTTP/1.1"
    sink = SocketWire.new(client)
    response.attach(sink, client, version, keepalive, head)
    stamp(response)
    request_headers = Headers.new
    request = arrived.to_request(request_headers)
    params = Params.new(request)
    context = Context.new(request, response, params)
    state = RequestState.new
    defer recover_request(client, context, state)
    answered = @handler.answer(arrived, response)
    return nil unless answered
    if conn = response.headers["connection"]?
      keepalive = false if conn.downcase == "close"
    end
    return false if client.closed? || IyiScheduler.current.cancelled
    keepalive = false if stopping?
    if response.headers_sent?
      response.finish
      keepalive = keepalive && response.reusable?
    else
      response.headers["Connection"] = keepalive ? "keep-alive" : "close"
      state.started = true
      send(client, response, version, !head)
    end
    keepalive
  end

  private def finished_request : Nil
    {% if F.class.has_method?(:activity) %}
      F.activity(-1)
    {% end %}
  end

  private def leave : Nil
    @in_flight = @in_flight - 1
  end

  # A 101 hands the connection to whoever asked for it once the status line
  # and headers are buffer, and the connection carries no more HTTP. The read
  # timeout was for a request arriving; an upgraded connection waits on
  # its own terms. A panic from here on has no response to become.
  private def take_over(client : IyiSocket, ctx : Context,
                        leftover : String) : Bool
    send(client, ctx.response, wire_version(ctx.request), false)
    client.read_timeout_ms = nil
    ctx.take_over(client, leftover)
    false
  end

  private def stamp(ctx : Context) : Nil
    stamp(ctx.response)
  end

  private def stamp(response : Response) : Nil
    if @config.powered_by_header
      response.headers["X-Powered-By"] = "web"
    end
    unless response.headers.has_key?("Date")
      now = Time.utc
      second = now.to_unix
      if second != @date_second
        @date_text.clear
        @date_text.append(http_date(now))
        @date_second = second
      end
      response.headers["Date"] = @date_text.finish
    end
  end

  private def recover_request(client : IyiSocket, ctx : Context,
                              state : RequestState) : Nil
    fiber = IyiScheduler.current
    return unless fiber.panicked
    return if fiber.cancelled
    return if client.closed? || state.started || ctx.response.headers_sent?
    snapshot = PanicRequest.new(ctx.request.method, ctx.request.path,
      ctx.request.headers.pairs, fiber.panic_message)
    prepare_500(ctx)
    rendered = false
    {% if F.class.has_method?(:error_page) %}
      image = RisTaskConfig.new({@settings, snapshot})
      defer image.close
      result = group do |recovery|
        page = recovery.spawn do
          config, request = image.read(Tuple(C, PanicRequest))
          body = F.error_page(config, request)
          type = "text/html; charset=utf-8"
          {% if F.class.has_method?(:error_content_type) %}
            type = F.error_content_type(request)
          {% end %}
          {body, type}
        end
        page.value
      end
      if result.is_a?(Tuple(String, String))
        ctx.response.set_body(result[0])
        ctx.response.content_type = result[1]
        rendered = true
      end
    {% end %}
    unless rendered
      ctx.response.set_body(panic_page(ctx.request,
        Panicked.new(snapshot.message)))
      if @config.show_exceptions?
        ctx.response.headers["Content-Security-Policy"] =
          "default-src 'none'; style-src 'unsafe-inline'"
        ctx.response.headers["X-Content-Type-Options"] = "nosniff"
      end
    end
    ctx.response.headers["Connection"] = "close"
    if @config.logging
      @config.logger.request(ctx, Span.zero)
    end
    send(client, ctx.response, wire_version(ctx.request),
      !HTTP.same_name?(ctx.request.method, "HEAD"))
  end

  private def prepare_500(ctx : Context) : Nil
    ctx.response.reset
    ctx.response.status_code = 500
    stamp(ctx)
  end

  private def panic_page(request : Request, failure : Panicked) : String
    title = "500 Internal Server Error"
    return "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title></head><body><h1>" + title + "</h1></body></html>\n" unless @config.show_exceptions?
    "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title></head><body><h1>" + title + "</h1><p>" +
      HTML.escape(request.method) + " " + HTML.escape(request.path) + "</p><pre>" + HTML.escape(failure.text) + "</pre></body></html>\n"
  end

  private def wire_version(request : Request) : String
    request.version.empty? ? "HTTP/1.1" : request.version
  end

  # A body over `max_request_body_size` is refused as soon as its
  # `Content-Length` is read, before the body itself is buffered, and a
  # chunked one as soon as its chunks pass it (`Intake`).
  #
  # A request has `read_timeout` to arrive whole, counted from its first
  # byte - from the accept, for a connection's *first* request - and one
  # cut short is `TimedOut`. A keep-alive connection waits `idle_timeout`
  # for that first byte; a connection that sent nothing is just `Closed`.
  # While the server drains, a keep-alive connection takes no further
  # request, and a new one only the request it has already sent.
  private def read_request(conn : Connection, intake : Intake,
                           first : Bool) : Bool | ParseError | TooLarge |
                           TimedOut | Closed
    client = conn.socket
    limit = milliseconds(@config.read_timeout)
    since = first ? conn.accepted : Time.monotonic
    # Only the request's bytes grow in this loop; `take` parses them after.
    loop do
      ready = intake.ready
      break if ready == true
      return ready if ready.is_a?(ParseError) || ready.is_a?(TooLarge)

      return Closed.new if client.closed?
      if intake.continue_due?
        # The client holds the body back until it is asked for it.
        return Closed.new unless client.write("HTTP/1.1 100 Continue\r\n\r\n").is_a?(Int32)
      end
      waiting = intake.empty?
      wait = limit
      if waiting && !first
        return Closed.new if @draining
        wait = milliseconds(@config.idle_timeout)
      elsif limit
        left = limit.to_i64 - elapsed_ms(since)
        if left <= 0
          return Closed.new if waiting
          return TimedOut.new
        end
        wait = left.to_i32
      end
      wait = 0 if waiting && @draining
      client.read_timeout_ms = wait
      conn.idle = waiting
      # Read straight onto the tape: a read costs no heap string.
      got = intake.read_from(client, READ_SIZE)
      conn.idle = false
      case got
      in Cancelled
        return Closed.new
      in SocketError
        return TimedOut.new if got.timed_out? && !waiting
        return Closed.new
      in Int32
        return Closed.new if got == 0 && waiting
        return ParseError.new("connection closed mid-headers") if got == 0
        since = Time.monotonic if waiting && !first
      end
    end
    true
  end

  private def elapsed_ms(since : Span) : Int64
    gone = Time.monotonic - since
    gone.total_seconds_i64 * 1000_i64 + (gone.nanoseconds // 1000000).to_i64
  end

  private def write_error(client : IyiSocket, status : Int32, body : String) : Nil
    headers = Headers.new
    res = Response.new(headers)
    res.status_code = status
    res.content_type = "text/plain; charset=utf-8"
    res.set_body(body)
    res.headers["Connection"] = "close"
    send(client, res, "HTTP/1.1", true)
  end

  # A buffered response leaves in one write, from the tape of the request
  # it answers: its bytes go when the scope ends, not to the collector.
  private def send(client : IyiSocket, res : Response, version : String, include_body : Bool) : Nil
    tape do
      buffer = String::Builder.new(res.http_capacity)
      res.write_http(buffer, version, include_body)
      wire = buffer.finish
      raise "the connection was cut off at shutdown" if client.closed?
      case wrote = client.write(wire, wire[0, 0])
      in Cancelled
      in SocketError
        raise wrote.message
      in Int32
      end
    end
  end

  private def write_raw(client : IyiSocket, bytes : String) : Nil
    # Closed under the task by a cut-off at shutdown: the panic is what
    # stops a handler that is still streaming.
    raise "the connection was cut off at shutdown" if client.closed?
    case wrote = client.write(bytes)
    in Cancelled
    in SocketError
      raise wrote.message
    in Int32
    end
  end
end

pub struct Closed
end

pub struct TimedOut
end

class RequestState
  property started : Bool
  def initialize
    @started = false
  end
end

class Connection
  getter socket : IyiSocket
  getter accepted : Span
  property idle : Bool

  def initialize(@socket : IyiSocket)
    @accepted = Time.monotonic
    @idle = false
  end
end

# The response's transport is local to the connection task. A class
# receiver replaces a stored proc that captured the socket and server.
class SocketWire < Wire
  def initialize(@socket : IyiSocket)
  end

  pub def write(bytes : String) : Nil
    raise "the connection was cut off at shutdown" if @socket.closed?
    case wrote = @socket.write(bytes)
    in Cancelled
      raise "socket write cancelled at shutdown cutoff"
    in SocketError
      raise wrote.message
    in Int32
    end
  end
end
