# An HTTP/1.1 server on `std/http`'s parser and ris's parking sockets.
#
# `IyiSocket#accept` / `#read` / `#write` park the calling fiber, so a
# slow client costs one task, not the thread. Closing the listener
# answers `Cancelled` on a parked `accept`, which is how `close` ends
# `listen`. A connection's own failure - a reset, a peer that has gone -
# answers `SocketError`: a read that gets one ends the connection, and a
# write that gets one panics its task, so a handler streaming to a client
# that left stops rather than writing on. The response is still this
# library's: handlers mutate a class, and `Set-Cookie` may appear more
# than once, which a Hash cannot hold.
#
# Every connection runs as its own task inside its own group. `listen`'s
# group cancels every live child on the first failure (III.4.3), so a
# handler's panic, or a write to a client that has gone, would otherwise
# close every other connection too. Reading a task's value is what
# catches its panic; the request being handled then gets a 500.
#
# A stop is a drain. `close` and `shutdown` close the listener, close the
# connections parked waiting for a request, and let each request in flight
# finish, its connection closing after the response; `listen` returns when
# the last connection has ended. What is still running at the deadline is
# cut off: its task group is cancelled, so a sleep or a socket wait answers
# `Cancelled`, and its socket is closed, so a write to it panics and a
# handler still streaming stops. The drain is watched the way Kemal
# watches it, every 10 ms, and only once the listener is closed.
#
# A slow client holds one task, and the timeouts bound for how long: a
# request has `read_timeout` to arrive whole, a keep-alive connection
# `idle_timeout` to start its next one, and a write `write_timeout` for
# the client to take bytes. The socket's own bound is per wait, so the
# read bound is set before every read from what is left of the request's
# deadline; a client trickling a byte at a time still runs buffer.
module web/server

import std/socket::{IyiSocket, SocketError}
import std/http::{HTTP}
import std/html::{HTML}
import std/time::{Time, Span}
import web/handler::{Handler}
import web/context::{Context}
import web/request::{Request, ParseError, Arrived}
import web/headers::{Headers}
import web/intake::{Intake, TooLarge}
import web/response::{Response}
import web/config::{Config}
import web/http_date::*

# What one read off a connection takes, onto the connection's stack.
READ_SIZE = 16384

lib LibReusePort
  fun setsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : UInt32) : Int32
end

# `IyiSocket.listen` plus `SO_REUSEPORT` (SOL_SOCKET 1, option 15 on
# Linux). std/socket has no option for it yet (once-campfire-ris's
# upstream.md); until it does, the socket is built here by hand.
pub def listen_reuse_port(host : String, port : Int32) : IyiSocket
  addr, family = IyiSocket.sockaddr(host, port)
  fd = IyiSocket.__sys_socket(family)
  raise "cannot create socket" if fd < 0
  IyiSocket.__sys_set_reuseaddr(fd)
  one = 1_i32
  LibReusePort.setsockopt(fd, 1, 15, pointerof(one).as(Void*), 4_u32)
  raise "cannot bind #{host}:#{port}" if IyiSocket.__sys_bind(fd, addr, family) < 0
  raise "cannot listen" if IyiSocket.__sys_listen(fd, 1024) < 0
  IyiSocket.__sys_set_nonblock(fd)
  IyiSocket.new(fd, family)
end

pub class Server
  @handler : Handler
  @config : Config
  @error_pages : Hash(Int32, Proc(Context, String))
  @socket : IyiSocket?
  @in_flight : Int32
  @host : String
  @port : Int32
  @first_connection : Connection?
  @draining : Bool
  @deadline : Span
  @cut : Bool
  @listening : Bool
  @stopped : Channel(Int32)

  # *error_pages* are the application's `error` handlers; the one for 500
  # renders the page a panicking request gets.
  def initialize(@handler : Handler, @config : Config, @error_pages : Hash(Int32, Proc(Context, String)) = {} of Int32 => Proc(Context, String))
    @socket = nil
    @in_flight = 0
    @host = "127.0.0.1"
    @port = 0
    @first_connection = nil
    @draining = false
    @deadline = Span.zero
    @cut = false
    @listening = false
    @stopped = Channel(Int32).new
  end

  # With *reuse_port* the socket sets `SO_REUSEPORT` before it binds, so
  # several servers - one per kernel thread or process - listen on the
  # same port and the kernel spreads the connections across them.
  pub def bind(host : String, port : Int32, reuse_port : Bool = false) : Int32
    listener = reuse_port ? listen_reuse_port(host, port) : IyiSocket.listen(host, port)
    @socket = listener
    @host = host
    @port = listener.local_port
    @port
  end

  # Listens at *path*, a unix socket's file, which must not exist yet; the
  # listener's close removes it.
  pub def bind_unix(path : String) : Nil
    @socket = IyiSocket.listen_unix(path)
    @host = path
    @port = 0
  end

  # Serves until `close` or `shutdown` has drained the connections.
  pub def listen : Nil
    listener = @socket
    return if @draining
    raise "server is not bound" unless listener
    @listening = true
    defer stopped_listening

    group do |g|
      pause = 5
      while !listener.closed?
        case client = listener.accept
        in Cancelled
          break
        in SocketError
          # The listener's own trouble - descriptors run buffer, most often -
          # is waited out rather than spun on: 5 ms doubling to a second,
          # as `std/http`'s server does, and the next accept that works
          # resets it.
          sleep(pause)
          pause = pause * 2 if pause < 1000
        in IyiSocket
          pause = 5
          conn = Connection.new(client)
          track(conn)
          spawn_connection(g, conn)
        end
      end
      # Closed by `close` or `shutdown`, or this task was cancelled, which
      # is a stop that does not wait.
      begin_drain(0) unless @draining
      wait_for_connections
      0
    end
  end

  # Stops taking connections and drains them, giving the requests in flight
  # `shutdown_timeout` seconds; answers at once, and `listen` returns when
  # the drain is over.
  pub def close : Nil
    begin_drain(@config.shutdown_timeout)
  end

  # Like `close`, with *timeout* seconds for the requests in flight, and
  # waits for `listen` to return. A deadline already running is only ever
  # brought forward: `shutdown(0)` during a drain cuts off what is left
  # now.
  pub def shutdown(timeout : Int32 = @config.shutdown_timeout) : Nil
    begin_drain(timeout)
    @stopped.receive if @listening
  end

  pub def in_flight : Int32
    @in_flight
  end

  pub def bound_port : Int32
    @port
  end

  private def serve_isolated(conn : Connection) : Nil
    client = conn.socket
    # The connection's write bound, set once. Its read bound is set before
    # every read, in `read_request`.
    client.write_timeout_ms = milliseconds(@config.write_timeout)
    exchange = Exchange.new
    failure = isolated(conn) { serve_connection(conn, exchange) }
    # A connection cut off at shutdown has nobody left to answer.
    if failure && !exchange.writing && !client.closed?
      if ctx = exchange.context
        # A response that has started streaming cannot become a 500: its
        # status line is already on the wire. The connection just ends.
        unless ctx.response.headers_sent?
          isolated { answer_panic(client, ctx, exchange.started, failure) }
        end
      elsif response = exchange.answering
        # The request it answered was on the tape, gone with it: the
        # error page is given a stand-in of its method alone.
        unless response.headers_sent?
          request = Request.new(exchange.answering_head ? "HEAD" : "GET", "/", "", "HTTP/1.1", Headers.new, "")
          isolated { answer_panic(client, Context.new(request, response, nil), exchange.started, failure) }
        end
      end
    end
    untrack(conn)
    client.close
  end

  # A method of its own because a `while` body is not a scope: a block
  # spawned in the accept loop captures the loop's one `conn`, which the
  # next accept overwrites before the task runs. A parameter is bound per
  # call.
  private def spawn_connection(g : IyiGroup, conn : Connection) : Nil
    g.spawn do
      serve_isolated(conn)
      0
    end
  end

  private def begin_drain(timeout : Int32) : Nil
    deadline = Time.monotonic + Span.seconds(timeout < 0 ? 0_i64 : timeout.to_i64)
    @deadline = deadline if !@draining || deadline < @deadline
    @draining = true
    if listener = @socket
      @socket = nil
      listener.close
    end
    # A task parked waiting for a request wakes to `Cancelled`, which ends
    # its connection; one that has any of a request goes on to answer it.
    conn = @first_connection
    while conn
      conn.socket.close if conn.idle
      conn = conn.following
    end
    cut_off if timeout <= 0
  end

  private def wait_for_connections : Nil
    while @first_connection && !@cut
      cut_off if Time.monotonic >= @deadline || sleep(10).is_a?(Cancelled)
    end
  end

  # The tasks cut off end on their own; `listen`'s group waits for them.
  private def cut_off : Nil
    @cut = true
    conn = @first_connection
    while conn
      conn.cut
      conn = conn.following
    end
  end

  private def stopped_listening : Nil
    @listening = false
    @stopped.close
  end

  private def track(conn : Connection) : Nil
    first = @first_connection
    conn.following = first
    first.previous = conn if first
    @first_connection = conn
  end

  private def untrack(conn : Connection) : Nil
    following = conn.following
    previous = conn.previous
    if previous
      previous.following = following
    else
      @first_connection = following
    end
    following.previous = previous if following
    conn.following = nil
    conn.previous = nil
  end

  # A timeout setting in seconds as the socket takes it; nil and 0 are none.
  private def milliseconds(seconds : Int32?) : Int32?
    return nil unless seconds
    return nil if seconds <= 0
    seconds >= 2147483 ? 2147483647 : seconds * 1000
  end

  # Runs *block* as its own task and answers its panic, if it had one. The
  # group is this call's alone, so the failure goes no further; *conn*
  # keeps it, for a cut-off to cancel.
  private def isolated(conn : Connection? = nil, &block : -> Nil) : Panicked?
    outcome = group do |g|
      conn.task_group = g if conn
      task = g.spawn do
        block.call
        0
      end
      task.value
    end
    outcome.is_a?(Panicked) ? outcome : nil
  end

  # Each request runs inside its own `tape`: its bytes as they are
  # read, and its response as it is written, are on the tape and are gone
  # together when the response is out. The scope opens once the request's
  # first bytes are in, read onto the stack: a connection waiting for its
  # next request holds no tape.
  private def serve_connection(conn : Connection, exchange : Exchange) : Nil
    client = conn.socket
    leftover = ""
    requests = 0
    chunk = uninitialized UInt8[READ_SIZE]
    start = pointerof(chunk).as(UInt8*)
    loop do
      count = 0
      if leftover.empty?
        case got = await_request(conn, requests == 0, start)
        in Closed
          return
        in TimedOut
          write_error(client, 408, "Request Timeout")
          return
        in Int32
          count = got
        end
      end
      done = false
      tape do
        if rest = serve_request(conn, client, leftover, start, count, requests, exchange)
          leftover = rest
        else
          done = true
        end
      end
      return if done
      requests = requests + 1
    end
  end

  # Waits for a request's first bytes and reads them into *into*: a
  # connection's first request has `read_timeout` from the accept, a later
  # one `idle_timeout`. Either is just `Closed` when nothing came.
  private def await_request(conn : Connection, first : Bool, into : Pointer(UInt8)) : Int32 | Closed | TimedOut
    client = conn.socket
    return Closed.new if client.closed?
    wait = milliseconds(@config.read_timeout)
    if !first
      return Closed.new if @draining
      wait = milliseconds(@config.idle_timeout)
    elsif limit = wait
      left = limit.to_i64 - elapsed_ms(conn.accepted)
      return Closed.new if left <= 0
      wait = left.to_i32
    end
    wait = 0 if @draining
    client.read_timeout_ms = wait
    conn.idle = true
    got = client.read(into, READ_SIZE)
    conn.idle = false
    case got
    in Cancelled
      Closed.new
    in SocketError
      Closed.new
    in Int32
      got == 0 ? Closed.new : got
    end
  end

  # One request off *conn*, read and answered: *count* bytes of it are
  # already at *start*. When the connection may carry another, what the
  # client sent after this one; nil otherwise.
  private def serve_request(conn : Connection, client : IyiSocket, leftover : String, start : Pointer(UInt8), count : Int32, requests : Int32, exchange : Exchange) : String?
    parsed = read_request(conn, leftover, start, count, requests == 0)
    case parsed
    in Closed
      nil
    in ParseError
      write_error(client, 400, "Bad Request")
      nil
    in TooLarge
      write_error(client, 413, "Content Too Large")
      nil
    in TimedOut
      write_error(client, 408, "Request Timeout")
      nil
    in Arrived
      keepalive = wants_keepalive?(it.close, requests)
      answer(client, it, keepalive, exchange) ? it.rest : nil
    in Tuple(Request, String, Bool)
      keepalive = wants_keepalive?(it[2], requests)
      dispatch(client, it[0], it[1], keepalive, exchange) ? it[1] : nil
    end
  end

  private def wants_keepalive?(wire_close : Bool, already : Int32) : Bool
    return false unless @config.keepalive
    return false if @draining
    return false if wire_close
    already + 1 < @config.max_keepalive_requests
  end

  # Runs the chain for one request and writes its response. True when the
  # connection may carry another request. *leftover* is what the client
  # sent after this request, which a connection taken over (a WebSocket)
  # reads first.
  private def dispatch(client : IyiSocket, request : Request, leftover : String, keepalive : Bool, exchange : Exchange) : Bool
    @in_flight = @in_flight + 1
    defer leave
    ctx = Context.for(request)
    ctx.limit_uploads(@config.max_file_uploads, @config.max_multipart_form_field_size)
    ctx.max_ranges = @config.max_ranges
    defer ctx.cleanup_params
    exchange.context = ctx
    exchange.started = Time.monotonic
    head = HTTP.same_name?(request.method, "HEAD")
    ctx.response.attach(->(bytes : String) { write_raw(client, bytes) },
      client,
      wire_version(request), keepalive, head)
    stamp(ctx)
    @handler.call(ctx)
    if upgrade = ctx.response.upgrade_handler
      return take_over(client, ctx, leftover, exchange, upgrade) if ctx.response.status_code == 101
    end
    if conn = ctx.response.headers["connection"]?
      keepalive = false if conn.downcase == "close"
    end
    # Cut off at shutdown while the handler ran: nobody is left to answer.
    return false if client.closed?
    keepalive = false if @draining
    exchange.writing = true
    if ctx.response.headers_sent?
      ctx.response.finish
      keepalive = keepalive && ctx.response.reusable?
    else
      ctx.response.headers["Connection"] = keepalive ? "keep-alive" : "close"
      send(client, ctx.response, wire_version(request), !head)
    end
    exchange.writing = false
    exchange.context = nil
    keepalive
  end

  # A request as it arrived, offered to the handler's `answer` first: one
  # that reads it on the tape answers it there, and no `Request` or
  # `Context` is made. Otherwise it becomes a `Request` and is dispatched.
  private def answer(client : IyiSocket, arrived : Arrived, keepalive : Bool, exchange : Exchange) : Bool
    kept = answer_arrived(client, arrived, keepalive, exchange)
    return kept unless kept.nil?
    case built = arrived.to_request
    in ParseError
      write_error(client, 400, "Bad Request")
      false
    in Tuple(Request, Bool)
      dispatch(client, built[0], arrived.rest, keepalive, exchange)
    end
  end

  # `answer`'s handler call and its response, counted in flight: whether
  # the connection may carry another request, or nil when the handler
  # left the request to the chain.
  private def answer_arrived(client : IyiSocket, arrived : Arrived, keepalive : Bool, exchange : Exchange) : Bool?
    @in_flight = @in_flight + 1
    defer leave
    response = Response.new
    head = arrived.head?
    version = arrived.http10? ? "HTTP/1.0" : "HTTP/1.1"
    response.attach(->(bytes : String) { write_raw(client, bytes) }, client, version, keepalive, head)
    stamp(response)
    exchange.answering = response
    exchange.answering_head = head
    exchange.started = Time.monotonic
    answered = @handler.answer(arrived, response)
    exchange.answering = nil
    return nil unless answered
    if conn = response.headers["connection"]?
      keepalive = false if conn.downcase == "close"
    end
    return false if client.closed?
    keepalive = false if @draining
    exchange.writing = true
    if response.headers_sent?
      response.finish
      keepalive = keepalive && response.reusable?
    else
      response.headers["Connection"] = keepalive ? "keep-alive" : "close"
      send(client, response, version, !head)
    end
    exchange.writing = false
    keepalive
  end

  private def leave : Nil
    @in_flight = @in_flight - 1
  end

  # A 101 hands the connection to whoever asked for it once the status line
  # and headers are buffer, and the connection carries no more HTTP. The read
  # timeout was for a request arriving; an upgraded connection waits on
  # its own terms. A panic from here on has no response to become.
  private def take_over(client : IyiSocket, ctx : Context, leftover : String, exchange : Exchange, upgrade : Proc(IyiSocket, String, Nil)) : Bool
    exchange.writing = true
    send(client, ctx.response, wire_version(ctx.request), false)
    exchange.writing = false
    exchange.context = nil
    client.read_timeout_ms = nil
    upgrade.call(client, leftover)
    false
  end

  private def stamp(ctx : Context) : Nil
    stamp(ctx.response)
  end

  private def stamp(response : Response) : Nil
    if @config.powered_by_header
      response.headers["X-Powered-By"] = "web"
    end
    unless response.headers.has_key?("Date")
      response.headers["Date"] = current_http_date
    end
  end

  # The handler panicked before its response went buffer. The response is
  # rebuilt from nothing: whatever the handler had written is not a page
  # anyone meant to send. The application's `error 500` page is used when
  # it renders; it is application code, so it may panic too, and then the
  # built-in page is sent instead.
  private def answer_panic(client : IyiSocket, ctx : Context, started : Span, failure : Panicked) : Nil
    request = ctx.request
    rendered = false
    if page = @error_pages[500]?
      body = ""
      prepare_500(ctx)
      page_failed = isolated { body = page.call(ctx) }
      unless page_failed
        # A page written with `env.json` or `env.text` answers nil.
        ctx.response.set_body(body) unless body.empty?
        rendered = true
      end
    end
    unless rendered
      prepare_500(ctx)
      ctx.response.set_body(panic_page(request, failure))
      if @config.show_exceptions?
        ctx.response.headers["Content-Security-Policy"] = "default-src 'none'; style-src 'unsafe-inline'"
        ctx.response.headers["X-Content-Type-Options"] = "nosniff"
      end
    end
    ctx.response.headers["Connection"] = "close"
    if @config.logging
      @config.logger.request(ctx, Time.monotonic - started)
    end
    send(client, ctx.response, wire_version(request), !HTTP.same_name?(request.method, "HEAD"))
  end

  private def prepare_500(ctx : Context) : Nil
    ctx.response.reset
    ctx.response.status_code = 500
    stamp(ctx)
  end

  private def panic_page(request : Request, failure : Panicked) : String
    title = "500 Internal Server Error"
    return "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title></head><body><h1>" + title + "</h1></body></html>\n" unless @config.show_exceptions?
    "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title></head><body><h1>" + title + "</h1><p>" +
      HTML.escape(request.method) + " " + HTML.escape(request.path) + "</p><pre>" + HTML.escape(failure.text) + "</pre></body></html>\n"
  end

  private def wire_version(request : Request) : String
    request.version.empty? ? "HTTP/1.1" : request.version
  end

  # A body over `max_request_body_size` is refused as soon as its
  # `Content-Length` is read, before the body itself is buffered, and a
  # chunked one as soon as its chunks pass it (`Intake`).
  #
  # A request has `read_timeout` to arrive whole, counted from its first
  # byte - from the accept, for a connection's *first* request - and one
  # cut short is `TimedOut`. A keep-alive connection waits `idle_timeout`
  # for that first byte; a connection that sent nothing is just `Closed`.
  # While the server drains, a keep-alive connection takes no further
  # request, and a new one only the request it has already sent.
  private def read_request(conn : Connection, leftover : String, start : Pointer(UInt8), count : Int32, first : Bool) : Arrived | Tuple(Request, String, Bool) | ParseError | TooLarge | TimedOut | Closed
    client = conn.socket
    intake = Intake.new(leftover, @config.max_request_body_size)
    intake.append(start, count) if count > 0
    limit = milliseconds(@config.read_timeout)
    since = first ? conn.accepted : Time.monotonic
    # Only the request's bytes grow in this loop; `take` parses them after.
    loop do
      ready = intake.ready
      break if ready == true
      return ready if ready.is_a?(ParseError) || ready.is_a?(TooLarge)

      return Closed.new if client.closed?
      if intake.continue_due?
        # The client holds the body back until it is asked for it.
        return Closed.new unless client.write("HTTP/1.1 100 Continue\r\n\r\n").is_a?(Int32)
      end
      waiting = intake.empty?
      wait = limit
      if waiting && !first
        return Closed.new if @draining
        wait = milliseconds(@config.idle_timeout)
      elsif limit
        left = limit.to_i64 - elapsed_ms(since)
        if left <= 0
          return Closed.new if waiting
          return TimedOut.new
        end
        wait = left.to_i32
      end
      wait = 0 if waiting && @draining
      client.read_timeout_ms = wait
      conn.idle = waiting
      # Read on the stack and appended to the tape: a read costs no heap
      # string.
      got = client.read(start, READ_SIZE)
      conn.idle = false
      case got
      in Cancelled
        return Closed.new
      in SocketError
        return TimedOut.new if got.timed_out? && !waiting
        return Closed.new
      in Int32
        return Closed.new if got == 0 && waiting
        return ParseError.new("connection closed mid-headers") if got == 0
        since = Time.monotonic if waiting && !first
        intake.append(start, got)
      end
    end
    arrived = intake.take_arrived
    return arrived unless arrived.nil?
    intake.take || ParseError.new("incomplete request")
  end

  private def elapsed_ms(since : Span) : Int64
    gone = Time.monotonic - since
    gone.total_seconds_i64 * 1000_i64 + (gone.nanoseconds // 1000000).to_i64
  end

  private def write_error(client : IyiSocket, status : Int32, body : String) : Nil
    res = Response.new
    res.status_code = status
    res.content_type = "text/plain; charset=utf-8"
    res.set_body(body)
    res.headers["Connection"] = "close"
    send(client, res, "HTTP/1.1", true)
  end

  # A buffered response leaves in one write, from the tape of the request
  # it answers: its bytes go when the scope ends, not to the collector.
  private def send(client : IyiSocket, res : Response, version : String, include_body : Bool) : Nil
    tape do
      buffer = Tape::String::Writer.new(res.http_capacity)
      res.write_http(buffer, version, include_body)
      wire = buffer.finish
      raise "the connection was cut off at shutdown" if client.closed?
      case wrote = client.write(wire, wire[0, 0])
      in Cancelled
      in SocketError
        raise wrote.message
      in Int32
      end
    end
  end

  private def write_raw(client : IyiSocket, bytes : Pointer(UInt8), count : Int32) : Nil
    raise "the connection was cut off at shutdown" if client.closed?
    case wrote = client.write(bytes, count)
    in Cancelled
    in SocketError
      raise wrote.message
    in Int32
    end
  end

  private def write_raw(client : IyiSocket, bytes : String) : Nil
    # Closed under the task by a cut-off at shutdown: the panic is what
    # stops a handler that is still streaming.
    raise "the connection was cut off at shutdown" if client.closed?
    case wrote = client.write(bytes)
    in Cancelled
    in SocketError
      raise wrote.message
    in Int32
    end
  end
end

pub struct Closed
end

pub struct TimedOut
end

# What a connection's task was doing when it stopped: the request being
# handled, until its response starts going buffer.
class Exchange
  property context : Context?
  # The response to a request a handler answers as it arrived, and whether
  # it was a HEAD: no `Context` was made for it.
  property answering : Response?
  property answering_head : Bool
  property started : Span
  property writing : Bool

  def initialize
    @context = nil
    @answering = nil
    @answering_head = false
    @started = Time.monotonic
    @writing = false
  end
end

# A connection `listen` took, as a drain sees it: its socket, when it was
# taken, whether its task is parked waiting for a request's first byte,
# and the group running that task. The server keeps them in a list of its
# own, which a connection leaves in constant time.
class Connection
  getter socket : IyiSocket
  getter accepted : Span
  property idle : Bool
  property task_group : IyiGroup?
  property previous : Connection?
  property following : Connection?

  def initialize(@socket : IyiSocket)
    @accepted = Time.monotonic
    @idle = false
    @task_group = nil
    @previous = nil
    @following = nil
  end

  # Cancels the task and closes the socket, which wakes a read or a write
  # parked on it.
  def cut : Nil
    if running = @task_group
      running.cancel_children
    end
    @socket.close
  end
end
