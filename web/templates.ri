# Server-side templates: `render` an `.eiy` file to a String, optionally
# inside a layout, and let a view hand markup to that layout with
# `content_for` / `yield_content`.
#
# Built on std/eiy, which turns a template into iyi source at compile time.
# A rendered page is compiled code, and a missing template or an unclosed
# tag stops the build instead of a request. The template's code is spliced
# where `render` is written, so it reads that scope's locals: a route's
# `name` is `<%= name %>` in the view. `<%= %>` prints `to_s` as is; escape
# untrusted text yourself.
#
# Paths are resolved at compile time. A relative path is read beside the
# file the `render` is written in: the route's source file, or, for a partial
# rendered inside a template, that template. An absolute path, including
# `"#{__DIR__}/..."`, is read as itself. The working directory never counts.
#
# Macros paste text, so every name a render introduces is a block parameter:
# `content` (the layout's view), `__web_io__` (the buffer the template
# prints to) and `__web_blocks__` (its captured blocks) exist only inside
# the render that made them. A render nested in a view or a layout shadows
# them, and the outer render's are intact when it returns; a caller's own
# `content` local is not overwritten.
module web/templates

import std/eiy::{Eiy}

# A package-owned print target copies each fragment before its scope ends.
pub class TemplateBuffer
  def initialize
    @text = String::Builder.new
  end

  pub def print(text : String) : Nil
    @text.append(text)
    nil
  end

  pub def print(value : T) : Nil forall T
    @text << value
    nil
  end

  pub def to_s : String
    String.new(@text.finish)
  end
end

pub class ContentBlocks
  def initialize
    @text = String::Builder.new
    @blocks = {} of String => Tuple(Int32, Int32)
  end

  pub def capture(key : String, & : TemplateBuffer -> Nil) : Nil
    buffer = TemplateBuffer.new
    yield buffer
    body = buffer.to_s
    at = @text.bytesize
    @text.append(body)
    @blocks[key] = {at, body.bytesize}
    nil
  end

  pub def [](key : String) : String
    if span = @blocks[key]?
      @text.finish[span[0], span[1]]
    else
      ""
    end
  end
end

# The scopes the macros render in. Each yields fresh values as block
# parameters, which is what keeps a nested render from reaching the outer
# render's buffer, blocks or `content`.
pub struct Templates
  # A buffer for one template, and the text it collected.
  pub def self.partial(buffer : TemplateBuffer,
                       & : TemplateBuffer -> Nil) : String
    yield buffer
    buffer.to_s
  end

  # The view's buffer and the render's blocks; the block answers the page.
  pub def self.page(buffer : TemplateBuffer, blocks : ContentBlocks,
                    & : TemplateBuffer, ContentBlocks -> String) : String
    yield buffer, blocks
  end

  # The rendered view as `content`, and a buffer for the layout.
  pub def self.layout(content : String, buffer : TemplateBuffer,
                      & : String, TemplateBuffer -> Nil) : String
    yield content, buffer
    buffer.to_s
  end
end

# std's macro currently stringifies String.view wrappers around a literal.
# Keep the compatibility normalization at this package's macro boundary.
pub macro embed_file(filename, io_name)
  {{ run("./template_process", @caller.first.filename || "", filename,
    io_name.id.stringify) }}
end

# The template at *filename*, rendered to a String with the caller's locals
# in scope.
pub macro render(filename)
  begin
    %buffer = ::Web::Templates::TemplateBuffer.new
    ::Web::Templates::Templates.partial(%buffer) do |__web_io__|
      ::Web::Templates.embed_file({{ filename }}, __web_io__)
    end
  end
end

# Owner declarations stay at the expansion site. Scoped parameters keep
# nested views/layouts from overwriting their caller's current print target.
pub macro render(filename, layout)
  begin
    %buffer = ::Web::Templates::TemplateBuffer.new
    %blocks = ::Web::Templates::ContentBlocks.new
    ::Web::Templates::Templates.page(%buffer, %blocks) do |__web_io__,
                                                         __web_blocks__|
      ::Web::Templates.embed_file({{ filename }}, __web_io__)
      %layout_io = ::Web::Templates::TemplateBuffer.new
      ::Web::Templates::Templates.layout(__web_io__.to_s,
        %layout_io) do |content, __web_io__|
        ::Web::Templates.embed_file({{ layout }}, __web_io__)
      end
    end
  end
end

# Captures what the block prints under *key* instead of printing it. Only
# inside `render(view, layout)`: in the view, the layout, or a partial one
# of them renders. The block runs here, once.
pub macro content_for(key)
  __web_blocks__.capture({{ key }}) do |__web_io__|
    {{ yield }}
  end
end

# The text captured under *key* by `content_for` in this render, or "".
pub macro yield_content(key)
  __web_blocks__[{{ key }}]
end
