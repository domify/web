# The writable half of a request: status, headers, body, and the `close`
# flag `halt` sets so the rest of the chain writes nothing.
#
# A response is buffered and sent whole once the chain has run, unless the
# handler calls `flush`. The first `flush` sends the status line and the
# headers, then everything printed so far; each later one sends what was
# printed since. On HTTP/1.1 a flushed body is sent chunked, unless the
# handler set `Content-Length`; on HTTP/1.0 it runs until the connection
# closes. Headers changed after the first `flush` are not sent.
#
# `send` writes a body that is on the request's tape straight to the
# socket, before the handler returns, so it is never copied to the heap.
module web/response

import std/socket::{IyiSocket, SocketError}
import web/headers::{Headers}
import web/status::*

pub class Response
  @status_code : Int32
  @headers : Headers
  @body : String
  @closed : Bool
  @content_type : String
  @sink : Proc(String, Nil)?
  @socket : IyiSocket?
  @version : String
  @keepalive : Bool
  @head : Bool
  @headers_sent : Bool
  @chunked : Bool
  @upgrade : Proc(IyiSocket, String, Nil)?
  # Whether the fields `send` is given carry the `Content-Type`.
  @typed : Bool

  def initialize
    @status_code = 200
    @headers = Headers.new
    @body = ""
    @closed = false
    @content_type = "text/html; charset=utf-8"
    @sink = nil
    @socket = nil
    @version = "HTTP/1.1"
    @keepalive = true
    @head = false
    @headers_sent = false
    @chunked = false
    @upgrade = nil
    @typed = false
  end

  pub def status_code : Int32
    @status_code
  end

  pub def status_code=(code : Int32) : Int32
    @status_code = code
  end

  pub def headers : Headers
    @headers
  end

  pub def body : String
    @body
  end

  pub def closed? : Bool
    @closed
  end

  pub def close : Nil
    @closed = true
  end

  pub def content_type : String
    @content_type
  end

  pub def content_type=(value : String) : String
    @content_type = value
    @headers["Content-Type"] = value
    value
  end

  pub def print(text : String) : Nil
    @body = @body + text
  end

  pub def write(text : String) : Nil
    print(text)
  end

  # Without a socket, header fields written for `send` are kept in the
  # headers, on the heap.
  private def keep_fields(fields : Tape::String) : Nil
    start = 0
    while start < fields.bytesize
      stop = start
      while stop + 1 < fields.bytesize && !(fields[stop] == 13_u8 && fields[stop + 1] == 10_u8)
        stop = stop + 1
      end
      line = fields[start, stop - start]
      if colon = line.index(':')
        @headers.add(line[0, colon].to_heap, line[colon + 2, line.bytesize - colon - 2].to_heap)
      end
      start = stop + 2
    end
  end

  # Without a socket (a response a test reads) the text is kept in the
  # body, on the heap: it leaves the tape here.
  private def keep(text : Tape::String) : Nil
    print(text.to_heap)
  end

  pub def set_body(text : String) : Nil
    @body = text
  end

  # A fresh 200 with no headers and no body, for a response that has to be
  # rebuilt after its handler failed part-way through writing it.
  pub def reset : Nil
    @status_code = 200
    @headers = Headers.new
    @body = ""
    @closed = false
    @content_type = "text/html; charset=utf-8"
    @upgrade = nil
  end

  # True once `flush` has sent the status line and headers.
  pub def headers_sent? : Bool
    @headers_sent
  end

  # Where `flush` writes, how the connection was asked for, and whether the
  # request was a HEAD. The server attaches this before the chain runs;
  # without it `flush` keeps buffering.
  pub def attach(sink : Proc(String, Nil), version : String, keepalive : Bool, head : Bool) : Nil
    @sink = sink
    @version = version
    @keepalive = keepalive
    @head = head
  end

  # The same, with the client's socket, which `send` writes to.
  pub def attach(sink : Proc(String, Nil), socket : IyiSocket, version : String, keepalive : Bool, head : Bool) : Nil
    @socket = socket
    attach(sink, version, keepalive, head)
  end

  # Sends *text*, on the request's tape, as the body, now: the status line
  # and headers first if they have not gone, with a `Content-Length` of the
  # body printed so far plus *text* when no length was set and nothing was
  # flushed. *text* goes to the socket from where it is and is not kept, so
  # it needs to live only until this returns. Headers set after it are not
  # sent. Without a socket attached it is copied into the body instead.
  pub def send(text : Tape::String) : Nil
    send("".as_tape, text)
  end

  # `send`, with header *fields* a layer above wrote on the request's tape,
  # each `Name: value` and a CRLF: they go out after this response's own
  # and before the framing it works out (`Content-Length`, `Connection`),
  # in the same write, copied nowhere. *fields* names no `Content-Length`
  # or `Connection`, which are given in the headers if at all, and names
  # `Content-Type` only when *typed*.
  pub def send(fields : Tape::String, text : Tape::String, typed : Bool = false) : Nil
    pieces = Tape::Array(Tape::String).new(1)
    pieces << text
    send(fields, pieces, typed)
  end

  # `send` with the body in *pieces*, sent in order with the head in one
  # write and never joined: a page's runs between the fragments it shares
  # with a cache.
  pub def send(fields : Tape::String, pieces : Tape::Array(Tape::String), typed : Bool = false) : Nil
    socket = @socket
    unless socket
      keep_fields(fields)
      pieces.each { |piece| keep(piece) }
      return
    end
    size = 0
    pieces.each { |piece| size = size + piece.bytesize }
    if !@headers_sent && !@headers.has_key?("Content-Length") && !no_entity?
      @headers["Content-Length"] = (@body.bytesize + size).to_s
    end
    # The head, what was printed before and the pieces go in one write:
    # written apart, the second write waits on the client's delayed ACK
    # (Nagle), 40 ms a response. The pieces go from where they are; a
    # chunk, which needs its CRLF after it, is joined on the tape.
    head = !@headers_sent
    @typed = typed
    settle_stream_head if head
    @typed = false
    @headers_sent = true
    body = !(@head || no_entity?) && (@body.bytesize + size) > 0
    pending = body ? @body : ""
    @body = ""
    framed = body && @chunked
    count = (head ? 64 + @headers.bytesize + fields.bytesize : 0) + pending.bytesize
    prefix = Tape::String::Writer.new(count + (framed ? 32 + size : 0))
    if head
      prefix.append(@version)
      prefix.push(32_u8)
      prefix.append_int(@status_code)
      prefix.push(32_u8)
      prefix.append(phrase(@status_code))
      prefix.append("\r\n")
      if fields.empty?
        @headers.write(prefix)
      else
        @headers.write_framing(prefix, false)
        prefix.append(fields)
        @headers.write_framing(prefix, true)
      end
      prefix.append("\r\n")
    end
    prefix.append((pending.bytesize + size).to_s(16) + "\r\n") if framed
    prefix.append(pending)
    if framed
      pieces.each { |piece| prefix.append(piece) }
      prefix.append("\r\n")
    end
    # Closed under the task by a cut-off at shutdown, as the server's own
    # writes are: the panic stops the handler.
    raise "the connection was cut off at shutdown" if socket.closed?
    wrote = if body && !framed && pieces.size > 1
              all = Tape::Array(Tape::String).new(pieces.size + 1)
              all << prefix.finish
              pieces.each { |piece| all << piece }
              socket.write(all)
            else
              socket.write(prefix.finish, body && !framed && pieces.size == 1 ? pieces[0] : "".as_tape)
            end
    case wrote
    in Cancelled
    in SocketError
      raise wrote.message
    in Int32
    end
  end

  # Sends what has been printed so far and keeps the response open.
  pub def flush : Nil
    sink = @sink
    return unless sink
    unless @headers_sent
      sink.call(stream_head)
      @headers_sent = true
    end
    return if @body.empty?
    unless @head || no_entity?
      sink.call(@chunked ? chunk(@body) : @body)
    end
    @body = ""
  end

  # Ends a flushed response: the rest of the body, then the last chunk.
  pub def finish : Nil
    flush
    sink = @sink
    sink.call("0\r\n\r\n") if sink && @chunked && !@head && !no_entity?
  end

  # Whether the connection can carry another request after this flushed
  # response: its end must be marked by the last chunk or by the length.
  pub def reusable? : Bool
    @chunked || @headers.has_key?("Content-Length") || @head || no_entity?
  end

  # Serialise to the bytes a TCP connection is owed. `Content-Length` is
  # written for every status that can carry a body, so a keep-alive
  # connection has a frame; a handler that already set one is left alone.
  # HEAD omits the body (RFC 9110 §9.3.2) but keeps the length a GET of the
  # same resource would have advertised. 1xx, 204 and 304 carry neither a
  # body nor a Content-Type. The `String` API beside `write_http`: the
  # bytes leave the tape here.
  pub def to_http(version : String, include_body : Bool = true) : String
    text = ""
    local_tape do
      buffer = Tape::String::Writer.new(http_capacity)
      write_http(buffer, version, include_body)
      text = buffer.finish.to_heap
    end
    text
  end

  # The bytes of `to_http`, onto *buffer*. The server writes them onto the
  # tape of the request it answers and sends them from there, so a
  # response costs no garbage-collected copy of its body.
  pub def write_http(buffer : Tape::String::Writer, version : String, include_body : Bool) : Nil
    no_entity = no_entity?
    unless @headers.has_key?("Content-Type") || no_entity
      @headers["Content-Type"] = @content_type
    end

    # RFC 9110 §8.6: no Content-Length on 1xx or 204; a 304 keeps one only
    # when the handler set it to the selected representation's length.
    unless @headers.has_key?("Content-Length") || no_entity
      @headers["Content-Length"] = @body.bytesize.to_s
    end

    buffer.append(version)
    buffer.push(32_u8)
    buffer.append_int(@status_code)
    buffer.push(32_u8)
    buffer.append(phrase(@status_code))
    buffer.append("\r\n")
    @headers.write(buffer)
    buffer.append("\r\n")
    buffer.append(@body) if include_body && !no_entity
  end

  # Room for all of `write_http`'s bytes, so the buffer does not grow: the
  # status line, the headers, the two `write_http` may add, and the body.
  pub def http_capacity : Int32
    128 + @content_type.bytesize + @headers.bytesize + @body.bytesize
  end

  # Takes the connection over once this response - a 101 - is buffer. The
  # server writes the status line and headers, then calls *block* with the
  # socket and whatever the client sent after the request, and the
  # connection carries no more HTTP. How a WebSocket starts.
  pub def upgrade(&block : IyiSocket, String -> Nil) : Nil
    @upgrade = block
  end

  pub def upgrade_handler : Proc(IyiSocket, String, Nil)?
    @upgrade
  end

  private def no_entity? : Bool
    @status_code == 204 || @status_code == 304 || (@status_code >= 100 && @status_code < 200)
  end

  private def stream_head : String
    settle_stream_head
    @version + " " + @status_code.to_s + " " + phrase(@status_code) + "\r\n" + @headers.to_s + "\r\n"
  end

  # The headers a streamed response is sent with: its type, its framing and
  # whether the connection stays open.
  private def settle_stream_head : Nil
    unless @typed || @headers.has_key?("Content-Type") || no_entity?
      @headers["Content-Type"] = @content_type
    end
    @chunked = @version == "HTTP/1.1" && !@headers.has_key?("Content-Length") && !no_entity?
    @headers["Transfer-Encoding"] = "chunked" if @chunked
    unless @headers.has_key?("Connection")
      @headers["Connection"] = @keepalive && reusable? ? "keep-alive" : "close"
    end
  end

  private def chunk(text : String) : String
    text.bytesize.to_s(16) + "\r\n" + text + "\r\n"
  end
end
