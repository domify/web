# Modular routing, ported from Kemal's `Router` and then actually dispatched
# rather than flattened into Crystal globals.
#
# Registration returns a value. `Kemal::RouteHandler::INSTANCE` and the
# three singletons beside it are gone: they were the workaround a clean
# sheet is the moment to stop writing.
module web/router

import web/body::{IntoBody}
import web/codec::*
import web/context::{Context, SocketHandler}
import web/radix::{Tree}
import web/handler::{Handler}
import web/status::*
import web/event_stream::{EventStream}
import web/websocket::{WebSocket}
import web/config::{Config}

pub abstract class RouteAction
  pub abstract def call(context : Context) : String
end

pub alias HandlerProc = RouteAction

@[OnTape]
pub struct Route
  def initialize(@method : String, @path : String, @handler : HandlerProc)
  end

  pub def method : String
    @method
  end

  pub def path : String
    @path
  end

  pub def handler : HandlerProc
    @handler
  end
end

# A `ws` route: the path as declared, prefixes included, and its block.
@[OnTape]
pub struct SocketRoute
  def initialize(@path : String, @handler : SocketHandler)
  end

  pub def path : String
    @path
  end

  pub def handler : SocketHandler
    @handler
  end
end

# A filter's kind, method, full path and block.
@[OnTape]
pub struct Filter
  getter kind : Symbol
  getter method : String
  getter path : String
  getter handler : HandlerProc

  def initialize(@kind : Symbol, @method : String, @path : String,
                 @handler : HandlerProc)
  end
end

# What a router holds is flat: a mounted router's routes, filters and error
# pages are copied in when it is mounted, with their paths as joined then,
# and it need not outlive that.
pub class Router
  @routes : Array(Route)
  @filters : Array(Filter)
  @sockets : Array(SocketRoute)
  @error_handlers : Hash(Int32, HandlerProc)
  @text : String::Builder

  def initialize(@prefix : String = "")
    @routes = [] of Route
    @filters = [] of Filter
    @sockets = [] of SocketRoute
    @error_handlers = {} of Int32 => HandlerProc
    @text = String::Builder.new(256)
  end

  private def keep(text : String) : String
    at = @text.bytesize
    @text.append(text)
    @text.finish[at, text.bytesize]
  end

  pub def prefix : String
    @prefix
  end

  {% for method in %w(get post put patch delete options head query) %}
    pub def {{ method.id }}(path : String, handler : RouteAction) : Nil
      add_route({{ method.upcase }}, path, handler)
    end
  {% end %}

  pub def ws(path : String, handler : SocketHandler) : Nil
    raise "path must start with /" unless path.starts_with?('/')
    @sockets << SocketRoute.new(keep(path), handler)
  end

  pub def before(path : String, handler : RouteAction) : Nil
    add_filter(:before, "ALL", path, handler)
  end

  pub def before(handler : RouteAction) : Nil
    add_filter(:before, "ALL", "*", handler)
  end

  pub def after(path : String, handler : RouteAction) : Nil
    add_filter(:after, "ALL", path, handler)
  end

  pub def after(handler : RouteAction) : Nil
    add_filter(:after, "ALL", "*", handler)
  end

  {% for kind in %w(before after) %}
    {% if kind == "before" %}
      {% filter_kind = :before %}
    {% else %}
      {% filter_kind = :after %}
    {% end %}
    pub def {{ kind.id }}(paths : Array(String),
                          handler : RouteAction) : Nil
      paths.each { |path| add_filter({{filter_kind}}, "ALL", path, handler) }
    end
    {% for method in %w(get post put patch delete options query) %}
      pub def {{ (kind + "_" + method).id }}(path : String,
                                            handler : RouteAction) : Nil
        add_filter({{filter_kind}}, {{method.upcase}}, path, handler)
      end

      pub def {{ (kind + "_" + method).id }}(paths : Array(String),
                                            handler : RouteAction) : Nil
        paths.each do |path|
          add_filter({{filter_kind}}, {{method.upcase}}, path, handler)
        end
      end
    {% end %}
  {% end %}

  # The sub-router arrives as a block parameter. Kemal's original used
  # `with sub_router yield`, which changes the block's `self` — a shape
  # no `& : Router -> Nil` annotation can describe (SPEC.md IV.2). One
  # extra `|r|` is the rule being paid rather than avoided.
  pub def namespace(path : String, & : Router -> Nil) : Nil
    sub_router = Router.new("")
    yield sub_router
    mount(path, sub_router)
  end

  # Copies what *router* holds so far into this router, under *path*.
  pub def mount(path : String, router : Router) : Nil
    index = 0
    while index < router.route_count
      route = router.route_at(index)
      full = keep(join_paths(join_paths(path, router.prefix), route.path))
      @routes << Route.new(route.method, full, route.handler)
      index += 1
    end
    index = 0
    while index < router.socket_count
      socket = router.socket_at(index)
      full = keep(join_paths(join_paths(path, router.prefix), socket.path))
      @sockets << SocketRoute.new(full, socket.handler)
      index += 1
    end
    index = 0
    while index < router.filter_count
      filter = router.filter_at(index)
      full = keep(join_paths(join_paths(path, router.prefix), filter.path))
      @filters << Filter.new(filter.kind, filter.method, full, filter.handler)
      index += 1
    end
    router.each_error { |code, handler| @error_handlers[code] = handler }
  end

  pub def mount(router : Router) : Nil
    mount("", router)
  end

  pub def error(status_code : Int32, handler : RouteAction) : Nil
    @error_handlers[status_code] = handler
  end

  pub def error_handler(status_code : Int32) : HandlerProc?
    @error_handlers[status_code]?
  end

  pub def each_error(& : Int32, HandlerProc -> Nil) : Nil
    @error_handlers.each { |code, handler| yield code, handler }
  end

  # Each route with its path joined under *base* and this router's prefix.
  pub def route_count : Int32
    @routes.size
  end

  pub def route_at(index : Int32) : Route
    @routes[index]
  end

  pub def ws_routes : Array(SocketRoute)
    @sockets
  end

  pub def socket_count : Int32
    @sockets.size
  end

  pub def socket_at(index : Int32) : SocketRoute
    @sockets[index]
  end

  pub def filter_count : Int32
    @filters.size
  end

  pub def filter_at(index : Int32) : Filter
    @filters[index]
  end

  pub def each_route(base : String = "", & : Route -> Nil) : Nil
    @routes.each do |route|
      yield Route.new(route.method, join_paths(join_paths(base, @prefix), route.path), route.handler)
    end
  end

  pub def each_socket(base : String = "", & : SocketRoute -> Nil) : Nil
    @sockets.each do |socket|
      yield SocketRoute.new(join_paths(join_paths(base, @prefix), socket.path), socket.handler)
    end
  end

  pub def each_filter(base : String = "", & : Filter -> Nil) : Nil
    @filters.each do |filter|
      yield Filter.new(filter.kind, filter.method,
        join_paths(join_paths(base, @prefix), filter.path), filter.handler)
    end
  end

  private def add_route(method : String, path : String,
                        handler : RouteAction) : Nil
    raise "path must start with /" unless path.starts_with?('/')
    @routes << Route.new(keep(method), keep(path), handler)
    nil
  end

  private def add_filter(kind : Symbol, method : String, path : String,
                         handler : RouteAction) : Nil
    @filters << Filter.new(kind, keep(method), keep(path), handler)
    nil
  end

end

# The last handler in the chain: look the route up, run before-filters,
# call the block, run after-filters, and render 404/405 when nothing
# matched. HEAD falls back to GET the way RFC 9110 §9.3.1 asks.
#
# `before_all` filters also run for a request no route matched, before
# its 404 or 405, so an authentication or logging filter sees it too.
# Per-method before filters and every after filter run only for a match.
#
# A `ws` route takes a request whose `Upgrade` names `websocket`: a GET
# runs the before filters for GET, then the handshake, which answers 101
# or refuses with 400, 403 or 426 and closes the connection, then the
# after filters. A before filter that halts or leaves an error status
# refuses the upgrade too. Another method is left to an HTTP route that
# serves it, or is refused with 405. A request that does not ask to
# upgrade is routed as usual; a GET only a `ws` route serves gets 426
# with `Upgrade: websocket`.
pub class RouteHandler < Handler
  @tree : Tree(Int32)
  @router : Router?
  @methods : Array(String)
  @sockets : Tree(Int32)
  @config : Config
  @text : String::Builder

  # *settings* supplies the WebSocket origin list and message limit, read
  # at each handshake.
  def initialize(@tree : Tree(Int32), @sockets : Tree(Int32),
                 @config : Config)
    super()
    @router = nil
    @methods = [] of String
    @text = String::Builder.new(256)
  end

  pub def load(router : Router) : Nil
    @router = router
    seen = {} of String => Bool
    index = 0
    while index < router.route_count
      route = router.route_at(index)
      route_path = join_paths(router.prefix, route.path)
      unless @tree.add("/" + route.method + route_path, index)
        raise "route #{route.method} #{route_path} is defined twice"
      end
      unless seen.has_key?(route.method)
        @methods << kept(@text, route.method)
        seen[route.method] = true
      end
      index += 1
    end
    index = 0
    while index < router.socket_count
      socket = router.socket_at(index)
      socket_path = join_paths(router.prefix, socket.path)
      unless @sockets.add(socket_path, index)
        raise "ws #{socket_path} is defined twice"
      end
      index += 1
    end
  end

  pub def call(ctx : Context) : Nil
    return if ctx.halted?

    method = ctx.request.method
    path = ctx.request.path

    if method == "QUERY" && !ctx.request.body.empty? && ctx.request.content_type.empty?
      render_error(ctx, 400)
      drop_head_body(ctx)
      return
    end

    if WebSocket.upgrade_request?(ctx.request)
      url = {} of String => String
      if socket_index = @sockets.find(path, url)
        socket = source.socket_at(socket_index)
        return if serve_socket(ctx, socket, url)
      end
    end

    url = {} of String => String
    route = lookup(method, path, url)

    unless route
      run_filters(ctx, :before, "ALL", path, true)
      if ctx.halted?
        drop_head_body(ctx)
        return
      end
      allowed = allowed_methods(path)
      if !allowed.empty? && !allowed.includes?(method)
        ctx.response.headers["Allow"] = allowed.join(", ")
        render_error(ctx, 405)
        drop_head_body(ctx)
        return
      end
      if method == "GET" && socket_path?(path)
        # RFC 9110 §15.5.22: the path speaks WebSocket and nothing else.
        ctx.response.headers["Upgrade"] = "websocket"
        render_error(ctx, 426)
        return
      end
      render_error(ctx, 404)
      drop_head_body(ctx)
      return
    end

    ctx.params.update_url(url)
    ctx.matched(route.method, join_paths(source.prefix, route.path))

    run_filters(ctx, :before, route.method, path)
    if ctx.halted?
      drop_head_body(ctx)
      return
    end

    # A before filter that left an error status with a page of its own
    # gets that page, and the route does not run.
    if ctx.response.status_code >= 400
      if custom = source.error_handler(ctx.response.status_code)
        render_page(ctx, custom)
        drop_head_body(ctx)
        return
      end
    end

    unless ctx.params.json_valid?
      render_error(ctx, 400)
      drop_head_body(ctx)
      return
    end

    if unreadable = ctx.params.body_error
      render_error(ctx, unreadable)
      drop_head_body(ctx)
      return
    end

    body = route.handler.call(ctx).into_body
    unless ctx.halted?
      # A helper like `env.text` already wrote the body and returned nil.
      # Replacing that with the empty IntoBody would wipe it.
      ctx.response.set_body(body) unless body.empty? && !ctx.response.body.empty?
    end

    if ctx.halted?
      drop_head_body(ctx)
      return
    end

    run_filters(ctx, :after, route.method, path)

    if custom = source.error_handler(ctx.response.status_code)
      if ctx.response.status_code >= 400
        render_page(ctx, custom)
      end
    end

    drop_head_body(ctx)
  end

  # The route for *method* and *path*, its dynamic segments put in *url*.
  pub def lookup(method : String, path : String, url : Hash(String, String)) : Route?
    found = @tree.find(path, url, method)
    if found.nil? && method == "HEAD"
      found = @tree.find(path, url, "GET")
    end
    return nil unless found
    source.route_at(found)
  end

  private def routed?(method : String, path : String) : Bool
    url = {} of String => String
    !@tree.find(path, url, method).nil?
  end

  private def socket_path?(path : String) : Bool
    url = {} of String => String
    !@sockets.find(path, url).nil?
  end

  private def drop_head_body(ctx : Context) : Nil
    return unless ctx.request.method == "HEAD"
    status = ctx.response.status_code
    bodiless = status == 204 || status == 304 || (status >= 100 && status < 200)
    unless ctx.response.headers.has_key?("Content-Length") || bodiless
      ctx.response.headers["Content-Length"] = ctx.response.body.bytesize.to_s
    end
    ctx.response.set_body("")
  end

  private def allowed_methods(path : String) : Array(String)
    allowed = [] of String
    @methods.each do |method|
      if routed?(method, path)
        allowed << method
      end
    end
    if allowed.includes?("GET") && !allowed.includes?("HEAD")
      allowed << "HEAD"
    end
    # The handshake is a GET, and a `ws` route serves nothing else, so it
    # adds GET but no HEAD.
    return allowed if allowed.includes?("GET") || !socket_path?(path)
    allowed.unshift("GET")
    allowed
  end

  # An upgrade request on a `ws` route. False when it is not the route's to
  # answer: a method other than GET that an HTTP route on the path serves.
  private def serve_socket(ctx : Context, socket : SocketRoute, url : Hash(String, String)) : Bool
    method = ctx.request.method
    path = ctx.request.path
    unless method == "GET"
      return false if routed?(method, path) || (method == "HEAD" && routed?("GET", path))
      run_filters(ctx, :before, "ALL", path, true)
      unless ctx.halted?
        ctx.response.headers["Allow"] = allowed_methods(path).join(", ")
        refuse_upgrade(ctx, 405)
      end
      drop_head_body(ctx)
      return true
    end

    ctx.params.update_url(url)
    ctx.matched("GET", join_paths(source.prefix, socket.path))
    run_filters(ctx, :before, "GET", path)
    return true if ctx.halted?
    if ctx.response.status_code >= 400
      # A filter that answered with an error refused the upgrade.
      if custom = source.error_handler(ctx.response.status_code)
        ctx.response.set_body(custom.call(ctx).into_body)
      end
      ctx.response.headers["Connection"] = "close"
      return true
    end

    if status = WebSocket.refusal(ctx.request, @config.websocket_allowed_origins)
      refuse_upgrade(ctx, status)
    else
      accept_socket(ctx, @config.websocket_max_message_size, socket.handler)
    end
    run_filters(ctx, :after, "GET", path)
    true
  end

  # A refused handshake also closes the connection, so nothing pipelined
  # behind it is read as the next request: Kemal's guard against
  # smuggling a request past a proxy that took the upgrade as done.
  # Answers an accepted handshake with 101; once the server has sent it, the
  # context runs *handler* on the connection. Call `refusal` first.
  private def accept_socket(ctx : Context, max_message_size : Int32, handler : SocketHandler) : Nil
    response = ctx.response
    response.status_code = 101
    response.headers["Upgrade"] = "websocket"
    response.headers["Connection"] = "Upgrade"
    response.headers["Sec-WebSocket-Accept"] = WebSocket.accept_key(ctx.request.headers["Sec-WebSocket-Key"].strip)
    ctx.socket_handler(max_message_size, handler)
  end

  private def refuse_upgrade(ctx : Context, status : Int32) : Nil
    render_error(ctx, status)
    ctx.response.headers["Sec-WebSocket-Version"] = "13" if status == 426
    ctx.response.headers["Connection"] = "close"
    nil
  end

  # *only_all* limits the run to filters registered for every method: what
  # an unmatched request gets.
  private def run_filters(ctx : Context, kind : Symbol, method : String, path : String, only_all : Bool = false) : Nil
    index = 0
    router = source
    while index < router.filter_count
      filter = router.filter_at(index)
      index += 1
      next unless filter.kind == kind
      if only_all
        next unless filter.method == "ALL"
      else
        next unless filter.method.in?("ALL", method)
      end
      pattern = join_paths(router.prefix, filter.path)
      next unless pattern_matches?(pattern, path)
      filter.handler.call(ctx)
      return if ctx.halted?
    end
  end

  private def source : Router
    @router || raise "load the route handler before dispatch"
  end

  private def render_error(ctx : Context, status : Int32) : Nil
    ctx.response.status_code = status
    if handler = source.error_handler(status)
      render_page(ctx, handler)
    else
      ctx.response.content_type = "text/html; charset=utf-8"
      ctx.response.set_body(status.to_s + " " + phrase(status))
    end
  end

  # An error page answers its body, or writes it with a helper such as
  # `env.json` and answers nil. What the response held before - a route's
  # own body, a halt's message - is not the page, so it goes first.
  private def render_page(ctx : Context, page : HandlerProc) : Nil
    ctx.response.set_body("")
    body = page.call(ctx).into_body
    ctx.response.set_body(body) unless body.empty?
  end
end

private def kept(text : String::Builder, value : String) : String
  at = text.bytesize
  text.append(value)
  text.finish[at, value.bytesize]
end
