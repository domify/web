    route_options_33)
  route_handler_33.load(router51)
  routed51 = route_handler_33
  handler = routed51
  http_request("GET", "/") do |made314|
    headers = Headers.new
    response = Response.new(headers)
    params = Params.new(made314)
    ctx = Context.new(made314, response, params)
    ctx.halt(499, "pre")
    handler.call(ctx)
    assert ctx.response.status_code == 499
    assert ctx.response.body == "pre"
  end
  nil
end

