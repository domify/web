def router_example_30 : Nil
  router48 = Router.new("")
  route_action_68 = Route68.new
  router48.before("/limited", route_action_68)
  route_action_69 = Route69.new
  router48.post("/upload", route_action_69)
  route_action_70 = Route70.new
  router48.post("/limited", route_action_70)
  route_options_30 = Config.new
  route_tree_30 = Tree(Int32).new
  socket_tree_30 = Tree(Int32).new
  route_handler_30 = RouteHandler.new(route_tree_30, socket_tree_30,
    route_options_30)
  route_handler_30.load(router48)
  routed48 = route_handler_30
  handler = routed48
  http_request("POST", "/upload", "", "--XyZ\r\nno headers",
    "multipart/form-data; boundary=XyZ") do |made306|
    dispatch(handler, made306) do |broken|
      assert broken.response.status_code == 400
      assert broken["route"]?.nil?

      one = "--XyZ\r\nContent-Disposition: form-data; " +
        "name=\"f\"; filename=\"x\"\r\n\r\nx\r\n--XyZ--\r\n"
      http_request("POST", "/upload", "", one,
        "multipart/form-data; boundary=XyZ") do |made308|
        dispatch(handler, made308) do |ok|
          assert ok.response.body == "1"
          ok.params.cleanup

          http_request("POST", "/limited", "", one,
            "multipart/form-data; boundary=XyZ") do |made310|
            dispatch(handler, made310) do |refused|
              assert refused.response.status_code == 413
              assert refused.response.body == "413 Content Too Large"
              assert refused["route"]?.nil?
            end
          end
        end
      end
    end
  end
  nil
end

