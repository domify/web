def router_example_37 : Nil
  router54 = Router.new("")
  route_action_80 = Route80.new
  router54.get("/gone", route_action_80)
  route_action_81 = Route81.new
  router54.before("/locked", route_action_81)
  route_action_82 = Route82.new
  router54.get("/locked", route_action_82)
  route_action_83 = Route83.new
  router54.error(404, route_action_83)
  route_action_84 = Route84.new
  router54.error(410, route_action_84)
  route_action_85 = Route85.new
  router54.error(423, route_action_85)
  route_options_37 = Config.new
  route_tree_37 = Tree(Int32).new
  socket_tree_37 = Tree(Int32).new
  route_handler_37 = RouteHandler.new(route_tree_37, socket_tree_37,
    route_options_37)
  route_handler_37.load(router54)
  routed54 = route_handler_37
  handler = routed54
  dispatch(handler, "GET", "/nope") do |missing|
    assert missing.response.status_code == 404
    assert missing.response.body == "no such page"
    assert missing.response.content_type == "text/plain; charset=utf-8"
    dispatch(handler, "GET", "/gone") do |gone|
      assert gone.response.status_code == 410
      assert gone.response.body == "{\"error\":\"gone\"}"
      dispatch(handler, "GET", "/locked") do |locked|
        assert locked.response.body == "<p>locked</p>"
      end
    end
  end
  nil
end

