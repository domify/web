def router_example_1 : Nil
  router19 = Router.new("")
  route_action_1 = Route1.new
  router19.get("/", route_action_1)
  route_action_2 = Route2.new
  router19.post("/users", route_action_2)
  route_action_3 = Route3.new
  router19.put("/users/:id", route_action_3)
  route_action_4 = Route4.new
  router19.patch("/users/:id", route_action_4)
  route_action_5 = Route5.new
  router19.delete("/users/:id", route_action_5)
  route_action_6 = Route6.new
  router19.options("/users", route_action_6)
  route_options_1 = Config.new
  route_tree_1 = Tree(Int32).new
  socket_tree_1 = Tree(Int32).new
  route_handler_1 = RouteHandler.new(route_tree_1, socket_tree_1,
    route_options_1)
  route_handler_1.load(router19)
  routed19 = route_handler_1
  handler = routed19

  dispatch(handler, "GET", "/") do |made250|
    assert made250.response.body == "home"
  end
  dispatch(handler, "POST", "/users") do |made251|
    assert made251.response.body == "created"
  end
  dispatch(handler, "PUT", "/users/3") do |made252|
    assert made252.response.body == "put:3"
  end
  dispatch(handler, "PATCH", "/users/3") do |made253|
    assert made253.response.body == "patch:3"
  end
  dispatch(handler, "DELETE", "/users/3") do |made254|
    assert made254.response.body == "deleted"
  end

  dispatch(handler, "OPTIONS", "/users") do |options|
    assert options.response.status_code == 200
    assert options.response.headers["allow"] == "GET, POST"
  end
  nil
end

def router_example_2 : Nil
  router20 = Router.new("")
  route_action_7 = Route7.new
  router20.query("/search-body", route_action_7)
  route_options_2 = Config.new
  route_tree_2 = Tree(Int32).new
  socket_tree_2 = Tree(Int32).new
  route_handler_2 = RouteHandler.new(route_tree_2, socket_tree_2,
    route_options_2)
  route_handler_2.load(router20)
  routed20 = route_handler_2
  handler = routed20

  dispatch(handler, "QUERY", "/search-body") do |made256|
    assert made256.response.body == "query-ok"
  end
  form_request("QUERY", "/search-body", "q=iyi") do |made257|
    dispatch(handler, made257) do |form|
      assert form.response.body == "iyi"
    end
  end
  nil
end

def router_example_3 : Nil
  router21 = Router.new("")
  route_action_8 = Route8.new
  router21.query("/search-body", route_action_8)
  route_options_3 = Config.new
  route_tree_3 = Tree(Int32).new
  socket_tree_3 = Tree(Int32).new
  route_handler_3 = RouteHandler.new(route_tree_3, socket_tree_3,
    route_options_3)
  route_handler_3.load(router21)
  routed21 = route_handler_3
  handler = routed21
  http_request("QUERY", "/search-body", "", "q=iyi") do |made259|
    dispatch(handler, made259) do |ctx|
      assert ctx.response.status_code == 400
      assert ctx.response.body == "400 Bad Request"
    end
  end
  nil
end

def router_example_4 : Nil
  router22 = Router.new("")
  route_action_9 = Route9.new
  router22.get("/users/:id", route_action_9)
