def router_example_25 : Nil
  router43 = Router.new("")
  route_action_58 = Route58.new
  router43.before("*", route_action_58)
  route_action_59 = Route59.new
  router43.before_get("*", route_action_59)
  route_action_60 = Route60.new
  router43.after("*", route_action_60)
  route_action_61 = Route61.new
  router43.get("/here", route_action_61)
  route_options_25 = Config.new
  route_tree_25 = Tree(Int32).new
  socket_tree_25 = Tree(Int32).new
  route_handler_25 = RouteHandler.new(route_tree_25, socket_tree_25,
    route_options_25)
  route_handler_25.load(router43)
  routed43 = route_handler_25
  handler = routed43
  dispatch(handler, "GET", "/nowhere") do |missing|
    assert missing.response.status_code == 404
    assert missing.response.headers["x-seen"]? == "1"
    assert missing.response.headers["x-get"]?.nil?
    assert missing.response.headers["x-after"]?.nil?
    assert !missing.route_found?

    dispatch(handler, "POST", "/here") do |wrong|
      assert wrong.response.status_code == 405
      assert wrong.response.headers["x-seen"]? == "1"
    end
  end
  nil
end

