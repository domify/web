  route_tree_4 = Tree(Int32).new
  socket_tree_4 = Tree(Int32).new
  route_handler_4 = RouteHandler.new(route_tree_4, socket_tree_4,
    route_options_4)
  route_handler_4.load(router22)
  routed22 = route_handler_4
  handler = routed22
  dispatch(handler, "GET", "/users/7") do |made261|
    assert made261.response.body == "7"
