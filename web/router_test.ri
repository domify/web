# Router dispatch without a socket. Each example draws its own routes so a
# filter on one path cannot rewrite the assertions on another.
module web/router_test

import web/router::{Router, RouteHandler}
import web/harness::*
import web/context::{Context}
import web/context::{with_context}
import web/headers::{Headers}
import web/response::{Response}
import web/params::{Params}
import web/spec::*

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

import web/router::{Route, SocketRoute}
import web/radix::{Tree}
import web/config::{Config}

