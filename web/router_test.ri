  nil
end

def router_example_5 : Nil
  router23 = Router.new("")
  route_action_10 = Route10.new
  router23.get("/users/:id", route_action_10)
  route_action_11 = Route11.new
  router23.get("/users/new", route_action_11)
  route_options_5 = Config.new
  route_tree_5 = Tree(Int32).new
  socket_tree_5 = Tree(Int32).new
  route_handler_5 = RouteHandler.new(route_tree_5, socket_tree_5,
    route_options_5)
  route_handler_5.load(router23)
  routed23 = route_handler_5
  handler = routed23
  dispatch(handler, "GET", "/users/new") do |made262|
    assert made262.response.body == "new-user"
  end
  nil
end

def router_example_6 : Nil
  router24 = Router.new("")
  route_action_12 = Route12.new
