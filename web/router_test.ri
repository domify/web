def router_example_15 : Nil
  router33 = Router.new("")
  route_action_27 = Route27.new
  router33.post("/users", route_action_27)
  route_action_28 = Route28.new
  router33.options("/users", route_action_28)
  route_action_29 = Route29.new
  router33.get("/", route_action_29)
  route_options_15 = Config.new
  route_tree_15 = Tree(Int32).new
  socket_tree_15 = Tree(Int32).new
  route_handler_15 = RouteHandler.new(route_tree_15, socket_tree_15,
    route_options_15)
  route_handler_15.load(router33)
  routed33 = route_handler_15
  handler = routed33

  dispatch(handler, "GET", "/users") do |wrong|
    assert wrong.response.status_code == 405
    assert wrong.response.headers["allow"].includes?("POST")
    assert wrong.response.headers["allow"].includes?("OPTIONS")
    assert wrong.response.body == "405 Method Not Allowed"

    dispatch(handler, "POST", "/") do |post_root|
      assert post_root.response.status_code == 405
      assert post_root.response.headers["allow"] == "GET, HEAD"
    end
  end
  nil
end

