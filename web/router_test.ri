def router_example_39 : Nil
  router56 = Router.new("")
  namespace_1 = Router.new("")
  route_action_88 = Route88.new
  namespace_1.get("/dash", route_action_88)
  router56.mount("/ns", namespace_1)
  namespace_2 = Router.new("")
  namespace_3 = Router.new("")
  route_action_89 = Route89.new
  namespace_3.get("/ping", route_action_89)
  namespace_2.mount("/v1", namespace_3)
  router56.mount("/api", namespace_2)
  route_options_39 = Config.new
  route_tree_39 = Tree(Int32).new
  socket_tree_39 = Tree(Int32).new
  route_handler_39 = RouteHandler.new(route_tree_39, socket_tree_39,
    route_options_39)
  route_handler_39.load(router56)
  routed56 = route_handler_39
  handler = routed56
  dispatch(handler, "GET", "/ns/dash") do |made323|
    assert made323.response.body == "dash"
  end
  dispatch(handler, "GET", "/api/v1/ping") do |made324|
    assert made324.response.body == "pong"
  end
  nil
end

def router_example_40 : Nil
  router57 = Router.new("")
  mounted = Router.new("")
  route_action_90 = Route90.new
  mounted.get("/list", route_action_90)
  router57.mount "/mounted", mounted

  bare = Router.new("")
  route_action_91 = Route91.new
  bare.get("/bare", route_action_91)
  router57.mount(bare)
  route_options_40 = Config.new
  route_tree_40 = Tree(Int32).new
  socket_tree_40 = Tree(Int32).new
  route_handler_40 = RouteHandler.new(route_tree_40, socket_tree_40,
    route_options_40)
  route_handler_40.load(router57)
  routed57 = route_handler_40
  handler = routed57
  dispatch(handler, "GET", "/mounted/list") do |made325|
    assert made325.response.body == "listed"
  end
  dispatch(handler, "GET", "/bare") do |made326|
    assert made326.response.body == "bare"
  end
  nil
end

def router_example_41 : Nil
  router = Router.new("")
  namespace_4 = Router.new("")
  namespace_5 = Router.new("")
  route_action_92 = Route92.new
  namespace_5.get("/ping", route_action_92)
  namespace_4.mount("/v1", namespace_5)
  router.mount("/api", namespace_4)
  bare = Router.new("")
  route_action_93 = Route93.new
  bare.get("/bare", route_action_93)
  router.mount(bare)

  paths = [] of String
  text = String::Builder.new
  router.each_route do |route|
    at = text.bytesize
    text.append(route.method)
    text.append(" ")
    text.append(route.path)
    paths << text.finish[at, text.bytesize - at]
    nil
  end
  assert paths.includes?("GET /api/v1/ping")
  assert paths.includes?("GET /bare")
  nil
end

def router_example_42 : Nil
  assert panics? {
    router58 = Router.new("")
    route_action_94 = Route94.new
    router58.get("/twice", route_action_94)
    route_action_95 = Route95.new
    router58.get("/twice/", route_action_95)
    route_options_41 = Config.new
    route_tree_41 = Tree(Int32).new
    socket_tree_41 = Tree(Int32).new
    route_handler_41 = RouteHandler.new(route_tree_41, socket_tree_41,
      route_options_41)
    route_handler_41.load(router58)
    routed58 = route_handler_41
    nil
  }
  assert panics? {
    router59 = Router.new("")
    route_action_96 = Route96.new
    router59.get("/api/ping", route_action_96)
    inner = Router.new("")
    route_action_97 = Route97.new
    inner.get("/ping", route_action_97)
    router59.mount("/api", inner)
    route_options_42 = Config.new
    route_tree_42 = Tree(Int32).new
    socket_tree_42 = Tree(Int32).new
    route_handler_42 = RouteHandler.new(route_tree_42, socket_tree_42,
      route_options_42)
    route_handler_42.load(router59)
    routed59 = route_handler_42
    nil
  }
  nil
end

def router_example_43 : Nil
  router60 = Router.new("")
  route_action_98 = Route98.new
  router60.get("/about", route_action_98)
  route_action_99 = Route99.new
  router60.get("/users/:id/", route_action_99)
  route_options_43 = Config.new
  route_tree_43 = Tree(Int32).new
  socket_tree_43 = Tree(Int32).new
  route_handler_43 = RouteHandler.new(route_tree_43, socket_tree_43,
    route_options_43)
  route_handler_43.load(router60)
  routed60 = route_handler_43
  handler = routed60
  dispatch(handler, "GET", "/about/") do |made327|
    assert made327.response.body == "about"
  end
  dispatch(handler, "GET", "/users/4") do |made328|
    assert made328.response.body == "user 4"
  end
  nil
end

def run_suite : Nil
  describe "Router" do
    describe "HTTP verbs" do
      it "dispatches GET, POST, PUT, PATCH, DELETE and OPTIONS" do
        router_example_1
      end

      it "dispatches QUERY, including a form body" do
        router_example_2
      end

      it "rejects a QUERY body without Content-Type" do
        router_example_3
      end
    end

    describe "parameters" do
      it "captures a named url segment" do
        router_example_4
      end

      it "prefers a static segment over a parameter" do
        router_example_5
      end

      it "reads a query string" do
        router_example_6
      end

      it "prefers a url param over a query param of the same name" do
        router_example_7
      end

      it "captures a glob and an empty glob tail" do
        router_example_8
      end

      it "plus-decodes a form body" do
        router_example_9
      end
    end

    describe "IntoBody" do
      it "stringifies Int32, Nil and Bool" do
        router_example_10
      end

      it "keeps a body already written when the handler returns nil" do
        router_example_11
      end
    end

    describe "HEAD" do
      it "serves GET with an empty body and the would-be Content-Length" do
        router_example_12
      end

      it "cannot bypass before_get" do
        router_example_13
      end

      it "runs GET before, handler and after filters" do
        router_example_14
      end
    end

    describe "method mismatch" do
      it "answers 405 with Allow when the path is routed for another verb" do
        router_example_15
      end

      it "treats methods as case-sensitive" do
        router_example_16
      end
    end

    describe "filters" do
      it "halts from before and skips the route" do
        router_example_17
      end

      it "scopes a wildcard before to that prefix" do
        router_example_18
      end

      it "runs before_get only for GET" do
        router_example_19
      end

      it "lets an after filter append to the body" do
        router_example_20
      end

      it "stops the before chain at the first halt" do
        router_example_21
      end

      it "matches a plain filter path exactly and a /* path by prefix" do
        router_example_22
      end

      it "matches :param and *glob segments in a filter path" do
        router_example_23
      end

      it "registers one block for a list of paths" do
        router_example_24
      end

      it("runs before_all, and only before_all, for a request no " +
        "route matched") do
        router_example_25
      end

      it "lets before_all turn a 404 away first" do
        router_example_26
      end

      it "renders the error page for a status a before filter leaves" do
        router_example_27
      end

      it "records the matched route" do
        router_example_28
      end

      it("answers 400 before the route when a declared JSON body does " +
        "not parse") do
        router_example_29
      end
    end

    describe "uploads" do
      it("answers a malformed multipart body with 400 and a breached " +
        "limit with 413") do
        router_example_30
      end
    end

    describe "halt and redirect" do
      it "redirects without writing the handler's return value" do
        router_example_31
      end

      it "halts without running after filters" do
        router_example_32
      end

      it "leaves an already-halted context alone" do
        router_example_33
      end
    end

    describe "error handlers" do
      it "uses a custom 404 body" do
        router_example_34
      end

      it("rewrites the body when the handler sets a status the error " +
        "table names") do
        router_example_35
      end

      it "collects error handlers from a mounted router" do
        router_example_36
      end

      it("keeps a page an error handler writes with a helper, in " +
        "place of the route's body") do
        router_example_37
      end

      it("sends an empty page when an error handler answers nil and " +
        "writes nothing") do
        router_example_38
      end
    end

    describe "namespace and mount" do
      it "prefixes nested namespaces" do
        router_example_39
      end

      it "mounts at a prefix and at the root" do
        router_example_40
      end

      it "joins nested prefixes in routes()" do
        router_example_41
      end

      it "refuses a route defined twice, across mounts too" do
        router_example_42
      end

      it "serves a route with or without a trailing slash" do
        router_example_43
      end
    end
  end
end

run_suite
