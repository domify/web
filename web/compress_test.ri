# Compression: negotiation by qvalue, the body round-trips, and every
# response that must go out as it is does.
module web/compress_test

import std/compress::{Gzip, Zlib}
import web/compress::{CompressHandler, select_content_coding, compressible_type?, encode_body, append_vary, etag_with_coding}
import web/headers::{Headers}
import web/handler::{chain}
import web/harness::*
import web/router::{Router, RouteHandler}
import web/handler::{Handler}
import web/context::{Context}
import web/spec::*

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

import web/router::{Route, SocketRoute}
import web/radix::{Tree}
import web/config::{Config}

class Route1 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.text(TEXT)
    TEXT
  end
end

class Route2 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.text("short")
    "short"
  end
end

class Route3 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.content_type = "image/png"
    TEXT
  end
end

class Route4 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.status_code = 204
    TEXT
  end
end

class Route5 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.headers["Content-Encoding"] = "br"
    env.text(TEXT)
    TEXT
  end
end

class Route6 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.headers["Vary"] = "Origin, accept-encoding"
    env.text(TEXT)
    TEXT
  end
end

class Route7 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.headers["Vary"] = "Origin"
    env.response.headers["ETag"] = "W/\"42\""
    env.response.headers["Content-Length"] = TEXT.bytesize.to_s
    env.json(TEXT)
    TEXT
  end
end

class Route8 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.text("short")
    "short"
  end
end


TEXT = "The quick brown fox jumps over the lazy dog. " * 40

def compress_app(& : Handler -> Nil) : Nil
  router1 = Router.new("")
  route_action_1 = Route1.new
  router1.get("/text", route_action_1)
  route_action_2 = Route2.new
  router1.get("/small", route_action_2)
  route_action_3 = Route3.new
  router1.get("/png", route_action_3)
  route_action_4 = Route4.new
  router1.get("/empty", route_action_4)
  route_action_5 = Route5.new
  router1.get("/encoded", route_action_5)
  route_action_6 = Route6.new
  router1.get("/vary", route_action_6)
  route_action_7 = Route7.new
  router1.get("/vary-origin", route_action_7)
  route_options_1 = Config.new
  route_tree_1 = Tree(Int32).new
  socket_tree_1 = Tree(Int32).new
  route_handler_1 = RouteHandler.new(route_tree_1, socket_tree_1, route_options_1)
  route_handler_1.load(router1)
  routed1 = route_handler_1
  yield chain([CompressHandler.new, routed1])
end

def fetch(path : String, accept : String?, method : String = "GET",
          & : Context -> Nil) : Nil
  http_request(method, path) do |request|
    request.headers["Accept-Encoding"] = accept if accept
    compress_app do |made2|
      dispatch(made2, request) do |made3|
        yield made3
      end
    end
  end
end

def run_suite : Nil
  describe "select_content_coding" do
    it "prefers gzip, and x-gzip is gzip" do
      assert select_content_coding("gzip, deflate") == "gzip"
      assert select_content_coding("deflate, gzip") == "gzip"
      assert select_content_coding("X-GZIP") == "gzip"
      assert select_content_coding("br, gzip;q=0.5") == "gzip"
    end

    it "follows qvalues" do
      assert select_content_coding("gzip;q=0.4, deflate;q=0.8") == "deflate"
      assert select_content_coding("gzip;q=0, deflate") == "deflate"
      assert select_content_coding("deflate") == "deflate"
    end

    it "answers nil when nothing is acceptable or identity wins" do
      assert select_content_coding("gzip;q=0").nil?
      assert select_content_coding("gzip;q=0, deflate;q=0").nil?
      assert select_content_coding("identity").nil?
      assert select_content_coding("").nil?
      assert select_content_coding("br").nil?
      assert select_content_coding("identity;q=1, gzip;q=0.5").nil?
    end

    it "reads * as every coding not named" do
      assert select_content_coding("*") == "gzip"
      assert select_content_coding("gzip;q=0, *") == "deflate"
      assert select_content_coding("*;q=0").nil?
      assert select_content_coding("identity;q=0, deflate;q=0.1") == "deflate"
    end

    it "drops malformed qvalues and keeps the lowest of duplicates" do
      assert select_content_coding("gzip;q=2").nil?
      assert select_content_coding("gzip;q=abc, deflate;q=0.2") == "deflate"
      assert select_content_coding("gzip;q=0, gzip").nil?
      assert select_content_coding("gzip; Q=0.5 ; level=1") == "gzip"
    end
  end

  describe "compressible_type?" do
    it "takes text, JSON, JavaScript, XML and SVG" do
      assert compressible_type?("text/html; charset=utf-8")
      assert compressible_type?("Text/CSS")
      assert compressible_type?("application/json")
      assert compressible_type?("application/problem+json; charset=utf-8")
      assert compressible_type?("application/atom+xml")
      assert compressible_type?("image/svg+xml")
      assert compressible_type?("application/javascript")
    end

    it "refuses binary and already-compressed types" do
      assert !compressible_type?("image/png")
      assert !compressible_type?("application/octet-stream")
      assert !compressible_type?("application/gzip")
      assert !compressible_type?("")
    end
  end

  describe "encode_body" do
    it "writes gzip and zlib streams that decode back" do
      assert Gzip.decompress(encode_body(TEXT, "gzip")) == TEXT
      assert Zlib.decompress(encode_body(TEXT, "deflate")) == TEXT
      assert encode_body(TEXT, "gzip").bytesize < TEXT.bytesize
    end

    it "panics on a coding it cannot produce" do
      assert panics? { encode_body(TEXT, "br") }
    end
  end

  describe "append_vary and etag_with_coding" do
    it "adds a field once and respects *" do
      headers = Headers.new
      append_vary(headers, "Accept-Encoding")
      append_vary(headers, "accept-encoding")
      assert headers["Vary"] == "Accept-Encoding"
      headers["Vary"] = "*"
      append_vary(headers, "Accept-Encoding")
      assert headers["Vary"] == "*"
    end

    it "suffixes quoted tags only" do
      assert etag_with_coding("W/\"42\"", "gzip") == "W/\"42-gzip\""
      assert etag_with_coding("\"abc\"", "deflate") == "\"abc-deflate\""
      assert etag_with_coding("bare", "gzip") == "bare"
    end
  end

  describe "CompressHandler" do
    it "gzips a large text body" do
      fetch("/text", "gzip, deflate") do |ctx|
        assert ctx.response.headers["Content-Encoding"] == "gzip"
        assert ctx.response.headers["Vary"] == "Accept-Encoding"
        assert ctx.response.body.bytesize < TEXT.bytesize
        assert Gzip.decompress(ctx.response.body) == TEXT
      end
    end

    it "deflates (zlib) when only deflate is accepted" do
      fetch("/text", "deflate") do |ctx|
        assert ctx.response.headers["Content-Encoding"] == "deflate"
        assert Zlib.decompress(ctx.response.body) == TEXT
      end
    end

    it "leaves the body alone when the client refuses every coding" do
      ["gzip;q=0", "identity", "identity;q=1, gzip;q=0.5", "gzip;q=0, deflate;q=0"].each do |accept|
        fetch("/text", accept) do |ctx|
          assert !ctx.response.headers.has_key?("Content-Encoding")
          assert ctx.response.body == TEXT
          assert ctx.response.headers["Vary"] == "Accept-Encoding"
        end
      end
    end

    it "leaves the body alone without Accept-Encoding, but still varies" do
      fetch("/text", nil) do |ctx|
        assert !ctx.response.headers.has_key?("Content-Encoding")
        assert ctx.response.body == TEXT
        assert ctx.response.headers["Vary"] == "Accept-Encoding"
      end
    end

    it "skips bodies under min_size" do
      fetch("/small", "gzip") do |ctx|
        assert !ctx.response.headers.has_key?("Content-Encoding")
        assert !ctx.response.headers.has_key?("Vary")
        assert ctx.response.body == "short"
      end
    end

    it "honours a custom min_size" do
      router2 = Router.new("")
      route_action_8 = Route8.new
      router2.get("/small", route_action_8)
      route_options_2 = Config.new
      route_tree_2 = Tree(Int32).new
      socket_tree_2 = Tree(Int32).new
      route_handler_2 = RouteHandler.new(route_tree_2, socket_tree_2, route_options_2)
      route_handler_2.load(router2)
      routed2 = route_handler_2
      app = chain([CompressHandler.new(1), routed2])
      http_request("GET", "/small") do |request|
        request.headers["Accept-Encoding"] = "gzip"
        dispatch(app, request) do |ctx|
          assert ctx.response.headers["Content-Encoding"] == "gzip"
          assert Gzip.decompress(ctx.response.body) == "short"
        end
      end
    end

    it "skips 204, HEAD, binary types and bodies already encoded" do
      fetch("/empty", "gzip") do |empty|
        assert empty.response.status_code == 204
        assert !empty.response.headers.has_key?("Content-Encoding")

        fetch("/text", "gzip", "HEAD") do |head|
          assert !head.response.headers.has_key?("Content-Encoding")
          assert head.response.headers["Content-Length"] == TEXT.bytesize.to_s

          fetch("/png", "gzip") do |png|
            assert !png.response.headers.has_key?("Content-Encoding")
            assert png.response.body == TEXT

            fetch("/encoded", "gzip") do |encoded|
              assert encoded.response.headers["Content-Encoding"] == "br"
              assert encoded.response.body == TEXT
              assert !encoded.response.headers.has_key?("Vary")
            end
          end
        end
      end
    end

    it "appends to Vary once" do
      fetch("/vary", "gzip") do |ctx|
        assert ctx.response.headers["Vary"] == "Origin, accept-encoding"

        fetch("/vary-origin", "gzip") do |other|
          assert other.response.headers["Vary"] == "Origin, Accept-Encoding"
        end
      end
    end

    it "drops a stale Content-Length and marks the ETag" do
      fetch("/vary-origin", "gzip") do |ctx|
        assert ctx.response.headers["Content-Encoding"] == "gzip"
        assert !ctx.response.headers.has_key?("Content-Length")
        assert ctx.response.headers["ETag"] == "W/\"42-gzip\""
        raw = ctx.response.to_http("HTTP/1.1")
        assert http_header(raw, "Content-Length") == ctx.response.body.bytesize.to_s
        assert Gzip.decompress(http_body(raw)) == TEXT
      end
    end
  end
end

run_suite
