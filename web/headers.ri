# HTTP headers, case-insensitive on lookup and insertion-ordered on write.
#
# Crystal's `HTTP::Headers` is a class the library owns, so Kemal reopens it.
# R-3 forbids that, so this is a type this module owns. A consumer that wants
# a header writes `ctx.request.headers["content-type"]` and the case of the
# name they used does not matter.
#
# A name must be an RFC 9110 token and a value must not carry control
# characters. Writing either is a panic: a CR or LF in a value is how a
# `Location` built from a query string becomes a second, forged header.
module web/headers

import std/http::{HTTP}

pub class Headers
  @pairs : Array(Tuple(String, String))

  def initialize
    @pairs = [] of Tuple(String, String)
  end

  # The fields as they came, name and value, in order: for a layer above
  # that keeps them as they are rather than copying them.
  pub def pairs : Array(Tuple(String, String))
    @pairs
  end

  # Names are compared byte by byte, ignoring ASCII case: a lookup makes
  # no lowercase copies.
  pub def []?(name : String) : String?
    found = nil
    @pairs.each do |pair|
      found = pair[1] if HTTP.same_name?(pair[0], name)
    end
    found
  end

  pub def [](name : String) : String
    self[name]? || raise "no such header #{name.inspect}"
  end

  pub def []=(name : String, value : String) : String
    check(name, value)
    index = 0
    while index < @pairs.size
      if HTTP.same_name?(@pairs[index][0], name)
        @pairs[index] = {name, value}
        return value
      end
      index = index + 1
    end
    @pairs << {name, value}
    value
  end

  pub def add(name : String, value : String) : Nil
    check(name, value)
    @pairs << {name, value}
  end

  pub def has_key?(name : String) : Bool
    !self[name]?.nil?
  end

  pub def each(& : String, String -> Nil) : Nil
    @pairs.each { |pair| yield pair[0], pair[1] }
  end

  # On the caller's tape when there is one, as a request's is; the
  # `String` API beside `write`, so the block leaves the tape here.
  @[Escape]
  pub def to_s : String
    text = ""
    tape do
      buffer = Tape::String::Writer.new(bytesize)
      write(buffer)
      text = buffer.finish.to_s
    end
    text
  end

  # The header block as it goes on the wire, `Name: value` lines each
  # ending in CRLF, onto *buffer*.
  pub def write(buffer : Tape::String::Writer) : Nil
    @pairs.each do |pair|
      buffer.append(pair[0])
      buffer.append(": ")
      buffer.append(pair[1])
      buffer.append("\r\n")
    end
  end

  # The size in bytes of what `write` writes.
  pub def bytesize : Int32
    total = 0
    @pairs.each { |pair| total = total + pair[0].bytesize + pair[1].bytesize + 4 }
    total
  end

  pub def empty? : Bool
    @pairs.empty?
  end

  pub def delete(name : String) : Nil
    kept = [] of Tuple(String, String)
    @pairs.each do |pair|
      kept << pair unless HTTP.same_name?(pair[0], name)
    end
    @pairs = kept
  end

  # RFC 9110 field-name: one or more token characters.
  def self.valid_name?(name : String) : Bool
    return false if name.bytesize == 0
    bytes = name.to_unsafe
    index = 0
    while index < name.bytesize
      return false unless token_byte?(bytes[index])
      index = index + 1
    end
    true
  end

  # RFC 9110 field-value: visible ASCII, obs-text, space and tab. CR, LF,
  # NUL and the other controls are refused.
  def self.valid_value?(value : String) : Bool
    bytes = value.to_unsafe
    index = 0
    while index < value.bytesize
      byte = bytes[index]
      return false if (byte < 32_u8 && byte != 9_u8) || byte == 127_u8
      index = index + 1
    end
    true
  end

  private def check(name : String, value : String) : Nil
    raise "invalid header name #{name.inspect}" unless Headers.valid_name?(name)
    raise "invalid value for header #{name}: control characters such as CR and LF are not allowed" unless Headers.valid_value?(value)
  end
end

private def token_byte?(byte : UInt8) : Bool
  return true if byte >= 48_u8 && byte <= 57_u8
  return true if byte >= 65_u8 && byte <= 90_u8
  return true if byte >= 97_u8 && byte <= 122_u8
  case byte
  when 33_u8, 35_u8, 36_u8, 37_u8, 38_u8, 39_u8, 42_u8, 43_u8, 45_u8, 46_u8, 94_u8, 95_u8, 96_u8, 124_u8, 126_u8
    true
  else
    false
  end
end
