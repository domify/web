# URL, query, form and JSON params, each their own table, and a combined
# lookup that prefers the most specific: url, then query, then body.
# `env.params.url["id"]` without Crystal's `HTTP::Params`. The tables keep
# the last value of a repeated name; `query_all` and `body_all` keep them
# all, in order.
#
# A JSON body (`application/json`, or any `application/*+json`) and a
# `multipart/form-data` body are parsed once, on first use. The router
# asks `json_valid?` and `body_error` before the route runs, so a request
# whose body cannot be read gets a 400 (or a 413 for a breached upload
# limit) rather than a route reading empty tables. Uploaded files live in
# temporary files until `cleanup`, which the server calls once the
# response is written.
module web/params

import std/json::{JSON, Any}
import web/codec::*
import web/request::{Request}
import web/headers::{Headers}
import web/multipart::{FileUpload, multipart_boundary, parse_parts}

pub class Params
  @url : Hash(String, String)
  @query : Hash(String, String)
  @body : Hash(String, String)
  @query_pairs : Array(Tuple(String, String))
  @body_pairs : Array(Tuple(String, String))
  # The decoded names and values the tables and pairs view.
  @text : String::Builder
  @raw_body : String
  @media_type : String
  @content_type : String
  @json : JsonBody
  @files : Hash(String, Int32)
  @uploads : Array(FileUpload)
  @body_state : Int32
  @max_files : Int32
  @max_field_size : Int32

  # The tables of *request*, whose text outlives this. Query, form and JSON
  # are read here; a multipart body, which spools files, on first use.
  def initialize(request : Request)
    text = String::Builder.new(request.query_string.bytesize + request.body.bytesize + 16)
    query_pairs = [] of Tuple(String, String)
    body_pairs = [] of Tuple(String, String)
    query = {} of String => String
    body = {} of String => String
    fill(request.query_string, query_pairs, query, text)
    media = request.content_type.downcase
    if media == "application/x-www-form-urlencoded"
      fill(request.body, body_pairs, body, text)
    end
    @url = {} of String => String
    @query = query
    @body = body
    @query_pairs = query_pairs
    @body_pairs = body_pairs
    @text = text
    @raw_body = request.body
    @media_type = media
    @content_type = request.headers["content-type"]? || ""
    @json = JsonBody.new(media, request.body)
    @files = {} of String => Int32
    @uploads = [] of FileUpload
    @body_state = 0
    @max_files = 128
    @max_field_size = 8 * 1024 * 1024
  end

  # Pre-parsed tables, with one value per key. The caller owns their text.
  def initialize(url : Hash(String, String), query : Hash(String, String),
                 body : Hash(String, String))
    query_pairs = [] of Tuple(String, String)
    body_pairs = [] of Tuple(String, String)
    query.each { |key, value| query_pairs << {key, value} }
    body.each { |key, value| body_pairs << {key, value} }
    @url = url
    @query = query
    @body = body
    @query_pairs = query_pairs
    @body_pairs = body_pairs
    @text = String::Builder.new
    @raw_body = ""
    @media_type = ""
    @content_type = ""
    @json = JsonBody.new("", "")
    @files = {} of String => Int32
    @uploads = [] of FileUpload
    @body_state = 0
    @max_files = 128
    @max_field_size = 8 * 1024 * 1024
  end

  pub def url : Hash(String, String)
    @url
  end

  pub def query : Hash(String, String)
    @query
  end

  # Every value sent for *key* in the query string, in order; empty when
  # there is none. `?tag=a&tag=b` gives `["a", "b"]` where `query["tag"]`
  # is `"b"`. A name is matched as sent: `tag[]` is not `tag`.
  pub def query_all(key : String) : Array(String)
    values_of(@query_pairs, key)
  end

  # Form fields: an `application/x-www-form-urlencoded` body, or the text
  # parts of a `multipart/form-data` one.
  pub def body : Hash(String, String)
    parse_multipart_body
    @body
  end

  # Every value of the form field *key*, in order; empty when there is none.
  # Covers the same fields as `body`.
  pub def body_all(key : String) : Array(String)
    parse_multipart_body
    values_of(@body_pairs, key)
  end

  # The request body as it arrived, whatever its type.
  pub def raw_body : String
    @raw_body
  end

  # A JSON object body's members. A top-level array is under `"_json"`; a
  # scalar, an empty body or a body of another type gives an empty table.
  pub def json : JsonBody
    @json
  end

  # False only when the request declares a JSON body that does not parse.
  pub def json_valid? : Bool
    @json.valid?
  end

  # Uploaded files by field name. A later file under the same name
  # replaces an earlier one; names ending in `[]` are in `all_files`.
  pub def files : FileTable
    parse_multipart_body
    FileTable.new(@files, @uploads)
  end

  # Every file sent under a name ending in `[]`, keyed with the brackets.
  pub def all_files(name : String) : Array(FileUpload)
    parse_multipart_body
    found = [] of FileUpload
    if name.ends_with?("[]")
      @uploads.each { |upload| found << upload if upload.name == name }
    end
    found
  end

  # The status a multipart body that could not be read earns: 400 when it
  # is malformed, 413 when it breaks an upload limit. Nil otherwise.
  pub def body_error : Int32?
    parse_multipart_body
    @body_state > 1 ? @body_state : nil
  end

  # Most file parts, and largest text field in bytes, a multipart body may
  # carry. The server sets them from the configuration.
  pub def limit_uploads(max_files : Int32, max_field_size : Int32) : Nil
    @max_files = max_files
    @max_field_size = max_field_size
  end

  # Deletes every uploaded file's temporary copy.
  pub def cleanup : Nil
    @uploads.each(&.delete)
  end

  pub def []?(key : String) : String?
    @url[key]? || @query[key]? || body[key]?
  end

  pub def [](key : String) : String
    self[key]? || raise "no such param #{key.inspect}"
  end

  pub def has_key?(key : String) : Bool
    !self[key]?.nil?
  end

  # Replaces the url table with a copy of *url*.
  pub def update_url(url : Hash(String, String)) : Nil
    @url.clear
    url.each { |name, value| @url[keep(name)] = keep(value) }
  end

  private def keep(text : String) : String
    at = @text.bytesize
    @text.append(text)
    @text.finish[at, text.bytesize]
  end

  private def parse_multipart_body : Nil
    return unless @body_state == 0
    @body_state = 1
    return unless @media_type == "multipart/form-data"
    boundary = multipart_boundary(@content_type, @text)
    unless boundary
      @body_state = 400
      return
    end
    failure = parse_parts(@raw_body, boundary, @body_pairs, @uploads,
      @max_files, @max_field_size, @text)
    if failure
      @body_pairs.clear
      @body_state = failure.status
      return
    end
    @body_pairs.each { |field| @body[field[0]] = field[1] }
    @uploads.each_with_index do |upload, index|
      unless upload.name.ends_with?("[]")
        if previous = @files[upload.name]?
          @uploads[previous].delete
        end
        @files[upload.name] = index
      end
    end
  end
end

private def json_media_type?(type : String) : Bool
  return true if type == "application/json"
  type.starts_with?("application/") && type.ends_with?("+json")
end

private def fill(text : String, pairs : Array(Tuple(String, String)), table : Hash(String, String), store : String::Builder) : Nil
  return if text.empty?
  text.split('&').each do |pair|
    next if pair.empty?
    eq = pair.index('=')
    name = decoded_view(eq ? pair[0, eq] : pair, store)
    value = eq ? decoded_view(pair[eq + 1, pair.bytesize - eq - 1], store) : ""
    next if name.empty?
    pairs << {name, value}
    table[name] = value
  end
end

private def values_of(pairs : Array(Tuple(String, String)), key : String) : Array(String)
  values = [] of String
  pairs.each { |pair| values << pair[1] if pair[0] == key }
  values
end

# A JSON body: an object's members, a top-level array under `"_json"`, and
# nothing for a scalar, an empty body or another media type.
@[OnTape]
pub struct JsonBody
  @value : Any?
  @valid : Bool

  def initialize(media : String, raw : String)
    value = nil.as(Any?)
    valid = true
    if json_media_type?(media) && !raw.empty?
      value = JSON.parse?(raw)
      valid = !value.nil?
    end
    @value = value
    @valid = valid
  end

  pub def valid? : Bool
    @valid
  end

  pub def []?(key : String) : Any?
    any = @value
    return nil unless any
    if members = any.as_h?
      return members[key]?
    end
    key == "_json" && any.as_a? ? any : nil
  end

  pub def [](key : String) : Any
    self[key]? || raise "no such member #{key.inspect}"
  end

  pub def has_key?(key : String) : Bool
    !self[key]?.nil?
  end

  pub def empty? : Bool
    any = @value
    return true unless any
    if members = any.as_h?
      return members.empty?
    end
    any.as_a?.nil?
  end
end

# A lookup view over upload rows. Hash mutation retains only row indices,
# so a FileUpload view never borrows a slot that a later parse could replace.
@[OnTape]
pub struct FileTable
  def initialize(@indices : Hash(String, Int32),
                 @uploads : Array(FileUpload))
  end

  pub def []?(name : String) : FileUpload?
    if index = @indices[name]?
      @uploads[index]
    end
  end

  pub def [](name : String) : FileUpload
    self[name]? || raise "no such upload #{name.inspect}"
  end

  pub def size : Int32
    @indices.size
  end

  pub def empty? : Bool
    @indices.empty?
  end

  pub def has_key?(name : String) : Bool
    @indices.has_key?(name)
  end

  pub def each(& : String, FileUpload -> Nil) : Nil
    @indices.each { |name, index| yield name, @uploads[index] }
  end
end
