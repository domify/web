# Scoped application construction. Mutable builders belong to their caller;
# serving always starts from copied data and a factory type.
module web/dsl

import std/http

import std/signal::{Signal}
import web/context::{Context, SocketHandler}
import web/router::{Router, RouteHandler, RouteAction}
import web/radix::{Tree}
import web/handler::{Handler, chain}
import web/config::{Config, StaticHeadersHook}
import web/log::{LogHandler, Logger}
import web/server::{Server}
import web/static::{StaticHandler}
import web/compress::{CompressHandler}
import web/file_body::{FileCache}
import web/cli::{CLIParser, cli_parser}
import web/templates

pub macro render(filename)
  ::Web::Templates.render({{ filename }})
end

pub macro render(filename, layout)
  ::Web::Templates.render({{ filename }}, {{ layout }})
end

pub macro content_for(key)
  ::Web::Templates.content_for({{ key }}) do
    {{ yield }}
  end
end

pub macro yield_content(key)
  ::Web::Templates.yield_content({{ key }})
end

pub class App
  getter router : Router
  getter config : Config

  def initialize(@router : Router, @config : Config)
    @gzip = false
  end

  {% for verb in %w(get post put patch delete options head query) %}
    pub def {{verb.id}}(path : String, action : RouteAction) : Nil
      @router.{{verb.id}}(path, action)
    end
  {% end %}

  pub def ws(path : String, action : SocketHandler) : Nil
    @router.ws(path, action)
  end

  {% for kind in %w(before after) %}
    pub def {{(kind + "_all").id}}(action : RouteAction) : Nil
      @router.{{kind.id}}(action)
    end

    pub def {{(kind + "_all").id}}(path : String,
                                   action : RouteAction) : Nil
      @router.{{kind.id}}(path, action)
    end

    pub def {{(kind + "_all").id}}(paths : Array(String),
                                   action : RouteAction) : Nil
      @router.{{kind.id}}(paths, action)
    end

    {% for verb in %w(get post put patch delete options query) %}
      pub def {{(kind + "_" + verb).id}}(path : String,
                                          action : RouteAction) : Nil
        @router.{{(kind + "_" + verb).id}}(path, action)
      end

      pub def {{(kind + "_" + verb).id}}(paths : Array(String),
                                          action : RouteAction) : Nil
        @router.{{(kind + "_" + verb).id}}(paths, action)
      end
    {% end %}
  {% end %}

  pub def error(code : Int32, action : RouteAction) : Nil
    @router.error(code, action)
  end

  pub def mount(path : String, router : Router) : Nil
    @router.mount(path, router)
  end

  pub def mount(router : Router) : Nil
    @router.mount(router)
  end

  pub def use(handler : Handler) : Nil
    @config.add_handler(handler)
  end

  pub def use(handler : Handler, position : Int32) : Nil
    @config.add_handler(handler, position)
  end

  pub def gzip? : Bool
    @gzip
  end

  pub def gzip(enabled : Bool) : Nil
    @gzip = enabled
    nil
  end

  pub def host(value : String) : Nil
    @config.host = value
    nil
  end

  pub def powered_by(value : Bool) : Nil
    @config.powered_by_header = value
    nil
  end

  pub def logging(value : Bool) : Nil
    @config.logging = value
    nil
  end

  pub def logger(value : Logger) : Nil
    @config.logger = value
    nil
  end

  pub def log(message : String) : Nil
    @config.logger.write(message) if @config.logging
    nil
  end

  pub def serve_static(value : Bool) : Nil
    @config.serve_static = value
    nil
  end

  pub def serve_static(options : Hash(String, Bool)) : Nil
    @config.serve_static = true
    @config.static_gzip = options["gzip"]? || false
    @config.static_dir_listing = options["dir_listing"]? || false
    @config.static_dir_index = options["dir_index"]? || false
    nil
  end

  pub def static_headers(hook : StaticHeadersHook) : Nil
    @config.static_headers = hook
    nil
  end

  pub def public_folder(path : String) : Nil
    @config.public_folder = path
    nil
  end
end

# The callback keeps every named stack/index/cache owner live while used.
pub macro with_handler_chain(app, &block)
  %options = {{app}}.config
  %tree = ::Web::Radix::Tree(Int32).new
  %sockets = ::Web::Radix::Tree(Int32).new
  %routed = ::Web::Router::RouteHandler.new(
    %tree, %sockets, %options)
  %routed.load({{app}}.router)
  %logging = ::Web::Log::LogHandler.new(%options.logger)
  %static = ::Web::Static::StaticHandler.new(
    %options.public_folder, %options.static_dir_index,
    %options.static_dir_listing, %options.static_gzip,
    %options.max_ranges, %options.static_headers)
  %cache = ::Web::FileBody::FileCache.new
  %static.file_cache = %cache
  %compress = ::Web::Compress::CompressHandler.new(860)
  %handlers = [] of ::Web::Handler::Handler
  %handlers << %logging if %options.logging
  %handlers << %static if %options.serve_static
  %options.custom_handlers.each do |handler|
    %handlers << handler
  end
  %options.positioned_handlers.each do |entry|
    ::Web::Dsl.insert_at(%handlers, entry[0], entry[1])
  end
  %handlers << %compress if {{app}}.gzip?
  %handlers << %routed
  {{block.args[0]}} = ::Web::Handler.chain(%handlers)
  {{block.body}}
end

pub def insert_at(handlers : Array(Handler), at : Int32,
                       handler : Handler) : Nil
  position = at < 0 ? 0 : at
  position = handlers.size if position > handlers.size
  handlers << handler
  index = handlers.size - 1
  while index > position
    handlers[index] = handlers[index - 1]
    index -= 1
  end
  handlers[position] = handler
  nil
end

pub def halt(context : Context, status_code : Int32 = 200,
             response : String = "") : Nil
  context.halt(status_code, response)
end

pub def headers(context : Context, values : Hash(String, String)) : Nil
  values.each { |name, value| context.response.headers[name] = value }
  nil
end

# CLI and signal handling stay in the caller. Serving tasks capture only
# an immutable packed image and task handles. A second signal cuts off.
pub def run(config : C, factory : F.class,
            tasks : Int32 = ::Std::Http::Server::MAX_CONNECTIONS,
            host : String? = nil, port : Int32? = nil,
            shutdown_timeout : Int32 = 30,
            args : Array(String)? = Program.args) : Nil forall C, F
  options = Config.new
  if arguments = args
    parser = CLIParser.new(options, "Options:")
    cli_parser(parser)
    if problem = parser.parse(arguments)
      raise problem
    end
    if parser.help?
      puts parser.usage
      return
    end
  end
  options.host = host if host
  options.port = port if port
  image = RisTaskConfig.new({options.host, options.port, config})
  defer image.close
  group do |g|
    serving = g.spawn do
      address, number, settings = image.read(Tuple(String, Int32, C))
      Server.serve(address, number, settings, F, tasks: tasks)
      0
    end
    signal = g.spawn do
      Signal.wait(Signal::INT, Signal::TERM)
      0
    end
    until serving.wait(100).nil? || signal.wait(0).nil?
      break if IyiScheduler.current.cancelled
    end
    unless serving.wait(0).nil? || IyiScheduler.current.cancelled
      Server.stop(F, tasks)
      g.spawn do
        result = Signal.wait(Signal::INT, Signal::TERM)
        serving.cancel unless result.is_a?(Cancelled)
        0
      end
      milliseconds = shutdown_timeout > 2147483 ? 2147483647 :
        shutdown_timeout * 1000
      serving.cancel unless serving.wait(milliseconds).nil?
    end
    g.cancel_children
    result = serving.value
    raise result.text if result.is_a?(Panicked)
    0
  end
  Server.clear_stops(F)
end
