# Shutdown, deadlines and addresses over task-owned real sockets.
module web/server_lifecycle_test

import std/file::{File}
import std/socket::{IyiSocket, SocketError}
import std/time::{Time, Span}
import web/handler::{Handler}
import web/context::{Context}
import web/config::{Config}
import web/harness::*
import web/spec::*

pub struct Settings
  property read_timeout : Int32?
  property write_timeout : Int32?
  property idle_timeout : Int32?
  property shutdown_timeout : Int32
  def initialize
    @read_timeout = 60
    @write_timeout = 60
    @idle_timeout = 75
    @shutdown_timeout = 30
  end
end

class Routes < Handler
  pub def call(context : Context) : Nil
    case context.request.path
    when "/slow"
      sleep(300)
      context.response.set_body("slow done")
    when "/stuck"
      return if sleep(10000).is_a?(Cancelled)
      context.response.set_body("late")
    when "/big"
      context.response.set_body("x" * (32 * 1024 * 1024))
    else
      context.response.set_body("home")
    end
  end
end

pub class Factory
  def self.with_handler(config : Settings,
                        & : Handler, Config -> Nil) : Nil
    options = Config.new
    options.logging = false
    options.read_timeout = config.read_timeout
    options.write_timeout = config.write_timeout
    options.idle_timeout = config.idle_timeout
    options.shutdown_timeout = config.shutdown_timeout
    handler = Routes.new
    yield handler, options
  end

  def self.listening(port : Int32) : Nil
    server_listening(Factory, port)
  end

  def self.activity(change : Int32) : Nil
    server_activity(Factory, change)
  end
end

pub class OtherFactory
  def self.with_handler(config : Settings,
                        & : Handler, Config -> Nil) : Nil
    Factory.with_handler(config) { |handler, options| yield handler, options }
  end
  def self.listening(port : Int32) : Nil
    server_listening(OtherFactory, port)
  end

  def self.activity(change : Int32) : Nil
    server_activity(OtherFactory, change)
  end
end

# The connection's bytes until the server closes it.
def read_all(client : IyiSocket) : String
  buffer = String::Builder.new
  loop do
    case chunk = client.read(65536)
    in String
      break if chunk.empty?
      buffer.append(chunk)
    in Cancelled, SocketError
      break
    end
  end
  buffer.finish
end

# One response on a connection that stays open.
def read_frame(client : IyiSocket) : String
  buffer = String::Builder.new
  loop do
    size = http_frame_size(buffer.finish)
    break if size && buffer.bytesize >= size
    chunk = client.read(4096).or_panic
    break if chunk.empty?
    buffer.append(chunk)
  end
  buffer.finish
end

def since(started : Span) : Span
  Time.monotonic - started
end

# Polls *check* for up to two seconds.
def wait_for(& : -> Bool) : Bool
  tries = 0
  while tries < 400
    return true if yield
    sleep(5)
    tries = tries + 1
  end
  false
end

def quiet_config : Settings
  Settings.new
end

def serving(config : Settings,
            & : RunningServer(Factory) -> Nil) : Nil
  with_server(config, Factory) { |server| yield server }
end

def connect(server : RunningServer(Factory)) : IyiSocket
  IyiSocket.connect("127.0.0.1", server.bound_port).or_panic
end

class Flag
  property value : Bool
  def initialize
    @value = false
  end
end

def run_suite : Nil
  describe "Server shutdown" do
    it "lets a request in flight finish, closes its connection after it and refuses new ones" do
      serving(quiet_config) do |server|
        client = connect(server)
        client.write("GET /slow HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert wait_for { server.in_flight == 1 }
        refused = Flag.new
        started = Time.monotonic
        server.shutdown(5)
        refused.value = IyiSocket.connect("127.0.0.1",
          server.bound_port).is_a?(SocketError)
        took = since(started)
        answer = read_all(client)
        client.close
        assert refused.value
        assert status_line(answer) == "HTTP/1.1 200 OK"
        assert http_header(answer, "Connection") == "close"
        assert http_body(answer) == "slow done"
        assert server.in_flight == 0
        assert took < Span.seconds(2)
      end
    end

    it "cuts off a request still running at the timeout" do
      serving(quiet_config) do |server|
        client = connect(server)
        client.write("GET /stuck HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert wait_for { server.in_flight == 1 }
        started = Time.monotonic
        server.shutdown(1)
        took = since(started)
        assert read_all(client) == ""
        client.close
        assert server.in_flight == 0
        assert took >= Span.milliseconds(900)
        assert took < Span.seconds(3)
      end
    end

    it "brings a running deadline forward when asked again with 0" do
      serving(quiet_config) do |server|
        client = connect(server)
        client.write("GET /stuck HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert wait_for { server.in_flight == 1 }
        started = Time.monotonic
        server.close
        sleep(100)
        assert server.in_flight == 1
        server.shutdown(0)
        assert since(started) < Span.seconds(2)
        assert read_all(client) == ""
        client.close
      end
    end

    it "closes an idle keep-alive connection at once" do
      serving(quiet_config) do |server|
        client = connect(server)
        client.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        first = read_frame(client)
        assert http_header(first, "Connection") == "keep-alive"
        started = Time.monotonic
        server.shutdown(5)
        assert since(started) < Span.seconds(1)
        assert read_all(client) == ""
        client.close
      end
    end
  end

  describe "Server timeouts" do
    it "answers 408 to a request that does not arrive whole in read_timeout, however it trickles" do
      cfg = quiet_config
      cfg.read_timeout = 1
      serving(cfg) do |server|
        client = connect(server)
        started = Time.monotonic
        client.write("GET / HTTP/1.1\r\n").or_panic
        buffer = String::Builder.new
        client.read_timeout_ms = 5
        sent = 0
        while sent < 10
          sleep(200)
          break unless client.write("X-Slow: #{sent}\r\n").is_a?(Int32)
          sent += 1
          case received = client.read(4096)
          in String
            buffer.append(received)
            break unless received.empty?
          in SocketError
            break unless received.timed_out?
          in Cancelled
            break
          end
        end
        client.read_timeout_ms = 5000
        buffer.append(read_all(client))
        answer = buffer.finish
        took = since(started)
        client.close
        assert status_line(answer) == "HTTP/1.1 408 Request Timeout"
        assert http_header(answer, "Connection") == "close"
        assert took >= Span.milliseconds(900)
        assert took < Span.milliseconds(1800)
      end
    end

    it "closes a connection that sends nothing in read_timeout without answering" do
      cfg = quiet_config
      cfg.read_timeout = 1
      serving(cfg) do |server|
        client = connect(server)
        started = Time.monotonic
        assert read_all(client) == ""
        client.close
        assert since(started) >= Span.milliseconds(900)
      end
    end

    it "closes a keep-alive connection idle for idle_timeout, and not one whose next request has begun" do
      cfg = quiet_config
      cfg.idle_timeout = 1
      cfg.read_timeout = 3
      serving(cfg) do |server|
        idle = connect(server)
        idle.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert http_body(read_frame(idle)) == "home"
        started = Time.monotonic
        assert read_all(idle) == ""
        idle.close
        took = since(started)
        assert took >= Span.milliseconds(900)
        assert took < Span.seconds(2)

        busy = connect(server)
        busy.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert http_body(read_frame(busy)) == "home"
        busy.write("GET / HTTP/1.1\r\n").or_panic
        sleep(1500)
        busy.write("Host: localhost\r\nConnection: close\r\n\r\n").or_panic
        second = read_all(busy)
        busy.close
        assert status_line(second) == "HTTP/1.1 200 OK"
        assert http_body(second) == "home"
      end
    end

    it "ends a response whose client stops reading for write_timeout" do
      cfg = quiet_config
      cfg.write_timeout = 1
      serving(cfg) do |server|
        client = connect(server)
        client.write("GET /big HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert wait_for { server.in_flight == 1 }
        assert wait_for { server.in_flight == 0 }
        client.close
      end
    end

    it "takes 0 or nil as no timeout, not as none left" do
      cfg = quiet_config
      cfg.read_timeout = 0
      cfg.idle_timeout = nil
      cfg.write_timeout = 0
      serving(cfg) do |server|
        client = connect(server)
        sleep(100)
        client.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert http_body(read_frame(client)) == "home"
        sleep(100)
        client.write("GET / HTTP/1.1\r\n").or_panic
        sleep(100)
        client.write("Host: localhost\r\nConnection: close\r\n\r\n").or_panic
        answer = read_all(client)
        client.close
        assert http_body(answer) == "home"
      end
    end
  end

  describe "Server connections" do
    it "serves each of many connections accepted in one burst on its own socket" do
      with_server(quiet_config, Factory, tasks: 20) do |server|
        clients = [] of IyiSocket
        20.times { clients << connect(server) }
        clients.each do |client|
          client.write("GET / HTTP/1.1\r\nHost: localhost\r\n" +
            "Connection: close\r\n\r\n").or_panic
        end
        clients.each do |client|
          answer = read_all(client)
          client.close
          assert status_line(answer) == "HTTP/1.1 200 OK"
          assert http_body(answer) == "home"
        end
      end
    end
  end

  describe "Server addresses" do
    it "shares a port between servers that bind with reuse_port" do
      # The kernel may hand any connection to either listener, so both serve.
      [{"127.0.0.1", "127.0.0.1"}, {"::1", "::1"}, {"[::1]", "::1"}].each do |host, address|
        with_server(quiet_config, Factory, tasks: 1, host: host) do |running|
          port = running.bound_port
          with_server(quiet_config, OtherFactory, tasks: 1,
            host: host, port: port) do |also|
            assert also.bound_port == port
            10.times do
              client = IyiSocket.connect(address, port).or_panic
              client.write("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").or_panic
              answer = read_all(client)
              client.close
              assert http_body(answer) == "home"
            end
          end
        end
      end
    end

    it "serves on IPv6 loopback, bare and bracketed" do
      ["::1", "[::1]"].each do |host|
        with_server(quiet_config, Factory, host: host) do |running|
          port = running.bound_port
          client = IyiSocket.connect("::1", port).or_panic
          client.write("GET / HTTP/1.1\r\nHost: [::1]\r\nConnection: close\r\n\r\n").or_panic
          answer = read_all(client)
          client.close
          assert status_line(answer) == "HTTP/1.1 200 OK"
          assert http_body(answer) == "home"
        end
      end
    end

    it "serves on a unix socket and removes its file at shutdown" do
      path = File.tempfile("web", ".sock")
      File.delete(path)
      with_unix_server(path, quiet_config, Factory) do |running|
        # `File.exists?` opens the path, which a socket refuses; stat does not.
        listed = File.info?(path)
        assert listed ? listed.type.socket? : false
        client = IyiSocket.connect_unix(path).or_panic
        client.write("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").or_panic
        answer = read_all(client)
        client.close
        assert status_line(answer) == "HTTP/1.1 200 OK"
        assert http_body(answer) == "home"
      end
      assert File.info?(path).nil?
    end
  end
end

run_suite
