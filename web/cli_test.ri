# Command-line flags: bind and port reach the config, bad input is named,
# help is noticed, and an application's own flags run.
module web/cli_test

import web/cli::{CLIParser, CLIAction, cli_parser}
import web/config::{Config}
import web/spec::*

class FlagLog
  def initialize
    @text = String::Builder.new
    @rows = [] of Tuple(Int32, Int32)
  end

  def add(value : String) : Nil
    at = @text.bytesize
    @text.append(value)
    @rows << {at, value.bytesize}
  end

  def ==(values : Array(String)) : Bool
    return false unless @rows.size == values.size
    index = 0
    while index < @rows.size
      at, size = @rows[index]
      return false unless @text.finish[at, size] == values[index]
      index += 1
    end
    true
  end
end

class CollectFlag < CLIAction
  def initialize(@log : FlagLog, @fixed : String? = nil)
  end

  pub def call(value : String) : String?
    @log.add(@fixed || value)
    nil
  end
end

def cli_example_1 : Nil
  cfg = Config.new
  parser = CLIParser.new(cfg, "Options:")
  cli_parser(parser)
  assert parser.parse(["-b", "127.0.0.1", "--port=4000"]).nil?
  assert cfg.host == "127.0.0.1"
  assert cfg.port == 4000
  assert parser.parse(["--bind", "0.0.0.0", "-p5000"]).nil?
  assert cfg.host == "0.0.0.0"
  assert cfg.port == 5000
  assert parser.parse(["-p", "0"]).nil?
  assert cfg.port == 0
  nil
end

def cli_example_2 : Nil
  cfg = Config.new
  parser = CLIParser.new(cfg, "Options:")
  cli_parser(parser)
  assert parser.parse(["-p", "70000"]) == "Invalid port \"70000\": must be an integer between 0 and 65535."
  assert parser.parse(["--port", " 80"]) == "Invalid port \" 80\": must be an integer between 0 and 65535."
  assert parser.parse(["--nope"]) == "Invalid option: --nope"
  assert parser.parse(["--port"]) == "Missing argument for option: --port"
  nil
end

def cli_example_3 : Nil
  cfg = Config.new
  parser = CLIParser.new(cfg, "Options:")
  cli_parser(parser)
  assert parser.parse(["--ssl"]) == "TLS is not supported: terminate TLS at a reverse proxy."
  nil
end

def cli_example_4 : Nil
  cfg = Config.new
  parser = CLIParser.new(cfg, "Options:")
  cli_parser(parser)
  assert parser.parse(["serve", "-h", "--", "--nope"]).nil?
  assert parser.help?
  assert parser.usage.includes?("-p PORT, --port PORT")
  assert parser.usage.includes?("-h, --help")
  nil
end

def cli_example_5 : Nil
  cfg = Config.new
  parser = CLIParser.new(cfg, "Options:")
  cli_parser(parser)
  seen = FlagLog.new
  workers = CollectFlag.new(seen)
  verbose = CollectFlag.new(seen, "verbose")
  parser.on("-w COUNT", "--workers COUNT", "Worker count", workers)
  parser.on("--verbose", "Log more", verbose)
  assert parser.parse(["--workers", "4", "--verbose"]).nil?
  assert seen == ["4", "verbose"]
  assert parser.parse(["--verbose=1"]) == "Option --verbose takes no value"
  assert parser.usage.includes?("-w COUNT, --workers COUNT")
  nil
end

def run_suite : Nil
  describe "cli_parser" do
    it "sets host and port in every spelling" do
      cli_example_1
    end

    it "names an invalid port, an unknown flag and a missing value" do
      cli_example_2
    end

    it "refuses the TLS flags" do
      cli_example_3
    end

    it "notices help and leaves plain arguments and everything after -- alone" do
      cli_example_4
    end

    it "runs an application's own flags" do
      cli_example_5
    end
  end
end

run_suite
