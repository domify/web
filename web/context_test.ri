# halt and redirect close the response and stop the chain; the store
# is a string bag a middleware can write for a later handler.
module web/context_test

import std/file::{File}
import std/time::{Time}
import web/context::{Context}
import web/harness::*
import web/context::{with_context}
import web/spec::*

def env(& : Context -> Nil) : Nil
  http_request("GET", "/") do |made123|
    with_context(made123) do |made124|
      yield made124
    end
  end
end

# *size* bytes of numbered lines, so every offset holds different text.
def numbered(size : Int32) : String
  lines = ""
  total = 0
  index = 0
  while total < size
    digits = index.to_s
    line = "0" * (7 - digits.bytesize) + digits + "\n"
    lines << line
    total = total + line.bytesize
    index = index + 1
  end
  lines[0, size]
end

describe "Context" do
  it "starts open with the request and an empty store" do
    env do |ctx|
      assert !ctx.halted?
      assert ctx.request.path == "/"
      assert ctx.response.status_code == 200
      assert ctx["missing"]?.nil?
    end
  end

  it "reads and overwrites string store values" do
    env do |ctx|
      ctx["user"] = "ada"
      assert ctx["user"] == "ada"
      assert ctx["user"]? == "ada"
      ctx["user"] = "grace"
      assert ctx["user"] == "grace"
    end
  end

  it "carries url params given at construction" do
    url = {} of String => String
    url["id"] = "7"
    http_request("GET", "/") do |made127|
      with_context(made127) do |ctx|
        ctx.params.update_url(url)
        assert ctx.params.url["id"] == "7"
      end
    end
  end

  it "stores typed values with set, get and get?" do
    env do |ctx|
      ctx.set("count", 3)
      ctx.set("ratio", 0.5)
      ctx.set("admin", true)
      ctx.set("name", "ada")
      assert ctx.get("count") == 3
      assert ctx.get("ratio") == 0.5
      assert ctx.get("admin") == true
      assert ctx.get?("missing").nil?
      assert ctx["name"] == "ada"
      assert ctx["count"]?.nil?
      assert panics? { env { |fresh| fresh.get("missing") } }
    end
  end
end

describe "Context#halt" do
  it "sets status and body and closes the response" do
    env do |ctx|
      ctx.halt(401, "no")
      assert ctx.halted?
      assert ctx.response.status_code == 401
      assert ctx.response.body == "no"
      assert ctx.response.closed?
    end
  end

  it "defaults to 200 and an empty body" do
    env do |ctx|
      ctx.halt
      assert ctx.response.status_code == 200
      assert ctx.response.body == ""
    end
  end
end

describe "Context#redirect" do
  it "halts with 302 and a Location header" do
    env do |ctx|
      ctx.redirect("/there")
      assert ctx.halted?
      assert ctx.response.status_code == 302
      assert ctx.response.headers["location"] == "/there"
      assert ctx.response.closed?
    end
  end

  it "accepts a status override" do
    env do |ctx|
      ctx.redirect("/new", 301)
      assert ctx.response.status_code == 301
    end
  end

  it "can write a body and leave the chain running" do
    env do |ctx|
      ctx.redirect("/later", 303, body: "see /later", close: false)
      assert !ctx.halted?
      assert ctx.response.status_code == 303
      assert ctx.response.body == "see /later"
      assert !ctx.response.closed?
    end
  end
end

describe "Context cookies" do
  it "starts empty without a Cookie header" do
    env do |made135|
      assert made135.cookies.empty?
    end
  end

  it "parses the request Cookie header" do
    http_request("GET", "/") do |headed|
      headed.headers["Cookie"] = "session=abc; theme=dark"
      with_context(headed) do |ctx|
        assert ctx.cookies["session"] == "abc"
        assert ctx.cookies["theme"] == "dark"
      end
    end
  end

  it "writes Set-Cookie, including Secure, Max-Age and SameSite" do
    env do |ctx|
      ctx.set_cookie("sid", "1")
      ctx.set_cookie("x", "y", "/", true)
      written = ctx.response.headers.to_s
      assert written.includes?("Set-Cookie: sid=1; Path=/\r\n")
      assert written.includes?("Set-Cookie: x=y; Path=/; HttpOnly\r\n")

      env do |secure|
        secure.set_cookie("sid", "1", "/", true, true, 60, "Lax")
        assert secure.response.headers.to_s.includes?("Secure")
        assert secure.response.headers.to_s.includes?("Max-Age=60")
        assert secure.response.headers.to_s.includes?("SameSite=Lax")
      end
    end
  end

  it "encodes a value outside cookie-octets and reads it back" do
    env do |ctx|
      ctx.set_cookie("flash", "Merhaba dünya; 100% + ok")
      header = ctx.response.headers["set-cookie"]
      assert !header.includes?(" dünya")
      http_request("GET", "/") do |headed|
        headed.headers["Cookie"] = header.split(';')[0]
        with_context(headed) do |made142|
          assert made142.cookies["flash"] == "Merhaba dünya; 100% + ok"
        end
      end
    end
  end

  it "writes Domain and Expires, and deletes a cookie" do
    env do |ctx|
      ctx.set_cookie("sid", "1", domain: "example.com", expires: Time.utc(2030, 1, 2, 3, 4, 5))
      assert ctx.response.headers["set-cookie"] == "sid=1; Path=/; Domain=example.com; Expires=Wed, 02 Jan 2030 03:04:05 GMT"
      env do |gone|
        gone.delete_cookie("sid")
        assert gone.response.headers["set-cookie"] == "sid=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT"
        assert(panics? do
          env { |fresh| fresh.set_cookie("bad name", "x") }
        end)
      end
    end
  end
end

describe "Context helpers" do
  it "chains status and html" do
    env do |ctx|
      ctx.status(201).html("<p>hi</p>")
      assert ctx.response.status_code == 201
      assert ctx.response.content_type == "text/html; charset=utf-8"
      assert ctx.response.body == "<p>hi</p>"
    end
  end

  it "send_file attaches the file with a filename disposition" do
    env do |ctx|
      ctx.send_file(__DIR__ + "/fixtures/hello.txt", "", "hello.txt")
      assert ctx.response.headers["content-disposition"] == "attachment; filename=\"hello.txt\""
      assert ctx.response.body == File.read(__DIR__ + "/fixtures/hello.txt")
      assert ctx.response.content_type == "text/plain; charset=utf-8"
      assert ctx.response.headers["x-content-type-options"] == "nosniff"
    end
  end

  it "send_file of a missing path or a directory is a halted 404" do
    env do |ctx|
      ctx.send_file(__DIR__ + "/fixtures/no-such.txt")
      assert ctx.response.status_code == 404
      assert ctx.halted?

      env do |folder|
        folder.send_file(__DIR__ + "/fixtures")
        assert folder.response.status_code == 404
      end
    end
  end

  it "send_file sends a file larger than one chunk whole, from a range and from a suffix" do
    File.tempfile("web-send-", ".txt") do |path|
      content = numbered(200000)
      File.write(path, content)

      env do |whole|
        whole.send_file(path)
        assert whole.response.status_code == 200
        assert whole.response.headers["content-length"] == "200000"
        assert whole.response.body == content

        http_request("GET", "/") do |ranged|
          ranged.headers["Range"] = "bytes=65530-140000"
          with_context(ranged) do |part|
            part.send_file(path)
            assert part.response.status_code == 206
            assert part.response.headers["content-range"] == "bytes 65530-140000/200000"
            assert part.response.body == content[65530, 74471]

            http_request("GET", "/") do |suffixed|
              suffixed.headers["Range"] = "bytes=-100000"
              with_context(suffixed) do |last|
                last.send_file(path)
                assert last.response.status_code == 206
                assert last.response.headers["content-range"] == "bytes 100000-199999/200000"
                assert last.response.body == content[100000, 100000]
              end
            end
          end
        end
      end
    end
  end

  it "send_file answers HEAD with the file's length and no body" do
    File.tempfile("web-head-", ".txt") do |path|
      File.write(path, numbered(200000))
      http_request("HEAD", "/") do |made155|
        with_context(made155) do |headed|
          headed.send_file(path)
          assert headed.response.status_code == 200
          assert headed.response.body == ""
          assert headed.response.headers["content-length"] == "200000"
          assert headed.response.content_type == "text/plain; charset=utf-8"
        end
      end
    end
  end

  it "send_data sends bytes from memory, typed by the filename, with ranges" do
    env do |named|
      named.send_data("0123456789", filename: "digits.txt")
      assert named.response.body == "0123456789"
      assert named.response.content_type == "text/plain; charset=utf-8"
      assert named.response.headers["content-disposition"] == "attachment; filename=\"digits.txt\""
      assert named.response.headers["accept-ranges"] == "bytes"

      env do |bare|
        bare.send_data("\u0000\u0001")
        assert bare.response.content_type == "application/octet-stream"
        assert !bare.response.headers.has_key?("Content-Disposition")

        env do |typed|
          typed.send_data("{}", mime_type: "application/json", filename: "x.txt", disposition: "inline")
          assert typed.response.content_type == "application/json"
          assert typed.response.headers["content-disposition"] == "inline; filename=\"x.txt\""

          http_request("GET", "/") do |ranged|
            ranged.headers["Range"] = "bytes=2-4"
            with_context(ranged) do |part|
              part.send_data("0123456789")
              assert part.response.status_code == 206
              assert part.response.body == "234"
              assert part.response.headers["content-range"] == "bytes 2-4/10"
            end
          end
        end
      end
    end
  end

  it "json writes a String as is and serialises anything else" do
    env do |raw|
      raw.json(%({"a":1}))
      assert raw.response.body == %({"a":1})
      env do |data|
        data.json({"name" => "ada", "lang" => "iyi"})
        assert data.response.body == %({"name":"ada","lang":"iyi"})
        env do |list|
          list.json([1, 2, 3])
          assert list.response.body == "[1,2,3]"
          assert list.response.content_type == "application/json; charset=utf-8"
        end
      end
    end
  end

  it "takes a content type on the body helpers" do
    env do |ctx|
      ctx.text("a,b", content_type: "text/csv; charset=utf-8")
      assert ctx.response.headers["content-type"] == "text/csv; charset=utf-8"
    end
  end

  it "send_file encodes a non-ASCII filename and honours disposition" do
    env do |ctx|
      ctx.send_file(__DIR__ + "/fixtures/hello.txt", filename: "rapor \"ç\".txt", disposition: "inline")
      assert ctx.response.headers["content-disposition"] == "inline; filename=\"rapor \\\"_\\\".txt\"; filename*=UTF-8''rapor%20%22%C3%A7%22.txt"
    end
  end

  it "send_file answers a byte range" do
    http_request("GET", "/") do |ranged|
      ranged.headers["Range"] = "bytes=6-"
      with_context(ranged) do |part|
        part.send_file(__DIR__ + "/fixtures/hello.txt")
        assert part.response.status_code == 206
        assert part.response.body == "static"
        assert part.response.headers["content-range"] == "bytes 6-11/12"
        assert part.response.headers["accept-ranges"] == "bytes"

        http_request("GET", "/") do |off|
          off.headers["Range"] = "bytes=0-1"
          with_context(off) do |whole|
            whole.max_ranges = 0
            whole.send_file(__DIR__ + "/fixtures/hello.txt")
            assert whole.response.status_code == 200
            assert whole.response.headers["accept-ranges"] == "none"
          end
        end
      end
    end
  end
end
