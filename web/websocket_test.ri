def websocket_example_14 : Nil
  router = Router.new("")
  endpoint_8 = NoopSocket.new
  router.ws("/ws", endpoint_8)
  options_26 = Config.new
  settings(options_26)
  tree_26 = Tree(Int32).new
  sockets_26 = Tree(Int32).new
  handler_26 = RouteHandler.new(tree_26, sockets_26, options_26)
  handler_26.load(router)
  handler = handler_26

  request_headers_27 = Headers.new
  upgrade_headers(request_headers_27)
  request_27 = Request.new("GET", "/ws", "", "HTTP/1.1",
    request_headers_27, "")
  no_connection = request_27
  no_connection.headers["Connection"] = "keep-alive"
  request_headers_28 = Headers.new
  upgrade_headers(request_headers_28)
  request_28 = Request.new("GET", "/ws", "", "HTTP/1.1",
    request_headers_28, "")
  no_key = request_28
  no_key.headers.delete("Sec-WebSocket-Key")
  request_headers_29 = Headers.new
  upgrade_headers(request_headers_29)
  request_29 = Request.new("GET", "/ws", "", "HTTP/1.1",
    request_headers_29, "")
  short_key = request_29
  short_key.headers["Sec-WebSocket-Key"] = "c2hvcnQ="
  request_headers_30 = Headers.new
  upgrade_headers(request_headers_30)
  request_30 = Request.new("GET", "/ws", "", "HTTP/1.1",
    request_headers_30, "")
  bad_key = request_30
  bad_key.headers["Sec-WebSocket-Key"] = "dGhlIHNhbXBsZSBub25jZ!=="
  request_headers_31 = Headers.new
  upgrade_headers(request_headers_31)
  request_31 = Request.new("GET", "/ws", "", "HTTP/1.1",
    request_headers_31, "")
  old = Request.new("GET", "/ws", "", "HTTP/1.0", request_31.headers, "")

  [no_connection, no_key, short_key, bad_key, old].each do |request|
    response_headers_32 = Headers.new
    response_32 = Response.new(response_headers_32)
    params_32 = Params.new(request)
    context_32 = Context.new(request, response_32, params_32)
    handler.call(context_32)
    ctx = context_32
    assert ctx.response.status_code == 400
    assert ctx.response.headers["Connection"] == "close"
    assert !ctx.upgrades?
  end
  nil
end

