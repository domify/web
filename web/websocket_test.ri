  context_17 = Context.new(request_16, response_17, params_17)
  handler.call(context_17)
  assert context_17.response.body == "posted"
  request_headers_18 = Headers.new
  upgrade_headers(request_headers_18)
  request_18 = Request.new("POST", "/only", "", "HTTP/1.1",
    request_headers_18, "")
  response_headers_19 = Headers.new
  response_19 = Response.new(response_headers_19)
  params_19 = Params.new(request_18)
  context_19 = Context.new(request_18, response_19, params_19)
  handler.call(context_19)
  only = context_19
  assert only.response.status_code == 405
  assert only.response.headers["Allow"] == "GET"
  assert !only.upgrades?
  nil
end

