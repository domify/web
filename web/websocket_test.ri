  end
end

class Route6 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    "posted"
  end
end


MASK = "\x37\xfa\x21\x3d"

# A client and its buffers stay in the test task.
class Peer
  getter socket : IyiSocket

  def initialize(@socket : IyiSocket)
    @buffer = String::Builder.new
    @payload = String::Builder.new
    @close_reason = String::Builder.new
    @offset = 0
  end

  def append(bytes : String) : Nil
    @buffer.append(bytes)
  end

  def send(opcode : Int32, payload : String, fin : Bool = true) : Nil
    @socket.write(WebSocket.encode_frame(opcode, payload, fin, MASK)).or_panic
  end

  def write(bytes : String) : Nil
    @socket.write(bytes).or_panic
  end

  def frame : Frame?
    @payload.clear
    loop do
      case decoded = WebSocket.decode_frame(@buffer.finish, @offset,
        false, 64 * 1024 * 1024, @payload)
      in Frame
        @offset += decoded.size
        return decoded
      in FrameError
        raise "the server sent a bad frame: " + decoded.reason
      in Int32
        count = @socket.read(@buffer, 65536)
        return nil unless count.is_a?(Int32)
        return nil if count == 0
      end
    end
  end

  def expect : Frame
    got = frame
    raise "the connection ended" unless got
    got
  end

  def expect_close : Tuple(Int32, String)
    got = expect
    raise "expected a close frame" unless got.opcode == WebSocket::CLOSE
    code = 1005
    @close_reason.clear
    if got.payload.bytesize >= 2
      code = (got.payload[0].to_i32 << 8) | got.payload[1].to_i32
      @close_reason.append(got.payload[2, got.payload.bytesize - 2])
    end
    raise "the server kept the connection open" unless frame.nil?
    {code, @close_reason.finish}
  end
end

@[OnTape]
pub struct SessionEvent
  getter kind : Int32
  getter code : Int32
  getter text : String
  def initialize(@kind : Int32, @code : Int32, @text : String)
  end
end

pub struct SessionReady
  getter port : Int32
  def initialize(@port : Int32)
  end
end

@[OnTape]
pub struct SessionCommand
  getter text : String
  def initialize(@text : String)
  end
end

class Seen
  def initialize
    @text = String::Builder.new
    @rows = [] of Tuple(Int32, Int32, Int32, Int32)
  end

  def poll : Nil
    loop do
      result = RisBoard.poll(SessionEvent)
      break if result.is_a?(Cancelled) || !result[1]
      if event = result[0]
        at = @text.bytesize
        @text.append(event.text)
        @rows << {event.kind, event.code, at, event.text.bytesize}
      end
    end
  end

  private def texts(kind : Int32) : Array(String)
    rows = @rows.select { |row| row[0] == kind }
    rows.map { |row| @text.finish[row[2], row[3]] }
  end

  def messages : Array(String)
    texts(WebSocket::TEXT)
  end

  def binaries : Array(String)
    texts(WebSocket::BINARY)
  end

  def pings : Array(String)
    texts(WebSocket::PING)
  end

  def pongs : Array(String)
    texts(WebSocket::PONG)
  end

  def closes : Array(Tuple(Int32, String))
    rows = @rows.select { |row| row[0] == WebSocket::CLOSE }
    rows.map { |row| {row[1], @text.finish[row[2], row[3]]} }
  end

  def late : Array(Bool)
    rows = @rows.select { |row| row[0] == 88 }
    rows.map { |row| row[1] == 1 }
  end
end

def session_record(kind : Int32, text : String, code : Int32 = 0) : Nil
  unless RisBoard.post(SessionEvent.new(kind, code, text))
    raise "session event queue full"
  end
end

def converse(max : Int32, seen : Seen, mode : Symbol = :echo,
             first : String = "", & : Peer -> Nil) : Tuple(Bool, Bool, Bool)
  image = RisTaskConfig.new({max, mode, first})
  defer image.close
  outcome = {false, true, true}
  group do |g|
    server = g.spawn do
      limit, behavior, leftover = image.read(Tuple(Int32, Symbol, String))
      listener = IyiSocket.listen("127.0.0.1", 0)
      defer listener.close
      assert RisBoard.post(SessionReady.new(listener.local_port))
      socket = listener.accept.or_panic
      defer socket.close
      ws = WebSocket.new(socket, limit)
      if behavior == :parallel
        group do |producers|
          {% for letter in %w(a b c) %}
            producers.spawn do
              4.times do
                command = SessionCommand.new({{letter}} * (1024 * 1024))
                raise "command queue full" unless RisBoard.post(command)
              end
              0
            end
          {% end %}
          12.times do
            command = RisBoard.take(SessionCommand).or_panic
            ws.send_binary(command.text)
          end
          0
        end
        ws.close(1000, "")
      end
      ws.run_events(leftover) do |opcode, text|
        if opcode == WebSocket::TEXT
          raise "handler failed on " + text if behavior == :panic
          session_record(opcode, text)
          if behavior == :close
            ws.close(4000, "done with " + text)
            session_record(88, "", ws.send("late") ? 1 : 0)
            session_record(88, "", ws.closed? ? 1 : 0)
          else
            ws.send(text)
          end
        elsif opcode == WebSocket::BINARY
          session_record(opcode, text)
          ws.send_binary(text)
        elsif opcode == WebSocket::PING || opcode == WebSocket::PONG
          session_record(opcode, text)
        end
        nil
      end
      session_record(WebSocket::CLOSE, ws.close_reason, ws.close_code)
      {ws.closed?, ws.send("anyone?"), ws.ping}
    end
    ready = RisBoard.take(SessionReady).or_panic
    client = IyiSocket.connect("127.0.0.1", ready.port).or_panic
    defer client.close
    client.read_timeout_ms = 10000
    peer = Peer.new(client)
    yield peer
    client.close
    result = server.value
    if result.is_a?(Panicked)
      raise result.text unless mode == :panic
      outcome = {true, false, false}
    else
      outcome = result
    end
    0
  end
  seen.poll
  outcome
end

def upgrade_headers(headers : Headers) : Nil
  headers["Host"] = "localhost"
  headers["Upgrade"] = "websocket"
  headers["Connection"] = "keep-alive, Upgrade"
  headers["Sec-WebSocket-Version"] = "13"
  headers["Sec-WebSocket-Key"] = "dGhlIHNhbXBsZSBub25jZQ=="
  headers["Origin"] = "http://localhost"
  nil
end

def settings(config : Config,
             origins : Array(String) = [] of String) : Config
  config.websocket_allowed_origins = origins
  config
end

def uniform?(text : String, byte : UInt8) : Bool
  index = 0
  while index < text.bytesize
    return false unless text[index] == byte
    index += 1
  end
  true
end

class NoopSocket < SocketHandler
  pub def call(socket : IyiSocket, leftover : String, context : Context,
               max_message_size : Int32) : Nil
  end
end

class Home < RouteAction
  pub def call(context : Context) : String
    "home"
  end
end

class EchoSocket < SocketHandler
  pub def call(socket : IyiSocket, leftover : String, context : Context,
               max_message_size : Int32) : Nil
    ws = WebSocket.new(socket, max_message_size)
    ws.run_events(leftover) do |opcode, text|
      ws.send(text) if opcode == WebSocket::TEXT
      nil
    end
  end
end

class RoomSocket < SocketHandler
  def initialize(@journal : String)
  end

  pub def call(socket : IyiSocket, leftover : String, context : Context,
               max_message_size : Int32) : Nil
    ws = WebSocket.new(socket, max_message_size)
    ws.poll_interval_ms = 25
    name = context.params.url["name"]
    offset = File.read(@journal).bytesize
    ws.run_events(leftover) do |opcode, text|
      if opcode == WebSocket::TEXT
        append_message(name + ": " + text)
      end
      unless ws.closed?
        bytes = File.read(@journal)
        while ending = bytes.index('\n', offset)
          ws.send(Base64.decode(bytes[offset, ending - offset]))
          offset = ending + 1
        end
      end
      nil
    end
  end

  private def append_message(text : String) : Nil
    file = File.open(@journal, "a")
    defer file.close
    file.print(Base64.encode(text) + "\n")
  end
end

@[OnTape]
pub struct SocketSettings
  getter journal : String
  def initialize(@journal : String)
  end
end

pub class SocketFactory
  def self.with_handler(config : SocketSettings,
                        & : Handler, Config -> Nil) : Nil
    options = Config.new
    options.logging = false
    options.websocket_allowed_origins = ["http://example.com"]
    router = Router.new("")
    home = Home.new
    echo = EchoSocket.new
    room = RoomSocket.new(config.journal)
    router.get("/", home)
    router.ws("/echo", echo)
    router.ws("/room/:name", room)
    tree = Tree(Int32).new
    sockets = Tree(Int32).new
    handler = RouteHandler.new(tree, sockets, options)
    handler.load(router)
    yield handler, options
    nil
  end

  def self.listening(port : Int32) : Nil
    server_listening(SocketFactory, port)
  end
end

def handshake(path : String,
              origin : String = "http://example.com") : String
  "GET #{path} HTTP/1.1\r\nHost: 127.0.0.1\r\n" +
    "Upgrade: websocket\r\nConnection: Upgrade\r\n" +
    "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n" +
    "Sec-WebSocket-Version: 13\r\nOrigin: #{origin}\r\n\r\n"
end

def socket_attempt(port : Int32, path : String, first : String,
                   & : String, Peer -> Nil) : Bool
  client = IyiSocket.connect("127.0.0.1", port).or_panic
  defer client.close
  client.read_timeout_ms = 250
  client.write(handshake(path) + first).or_panic
  buffer = String::Builder.new
  loop do
    if ending = buffer.finish.index("\r\n\r\n")
      peer = Peer.new(client)
      peer.append(buffer.finish[ending + 4, buffer.bytesize - ending - 4])
      client.read_timeout_ms = 10000
      yield buffer.finish[0, ending + 4], peer
      return true
    end
    count = client.read(buffer, 4096)
    return false unless count.is_a?(Int32) && count > 0
  end
end

def open_socket(port : Int32, path : String, first : String = "",
                & : String, Peer -> Nil) : Nil
  32.times do
    opened = socket_attempt(port, path, first) do |head, peer|
      yield head, peer
      nil
    end
    return if opened
  end
  raise "no idle reuse-port worker answered the handshake"
end

def websocket_example_1 : Nil
  assert WebSocket.encode_frame(WebSocket::TEXT, "Hello") == "\x81\x05Hello"
  assert WebSocket.encode_frame(WebSocket::PONG, "") == "\x8a\x00"
  nil
end

def websocket_example_2 : Nil
  wire = "\x81\x85\x37\xfa\x21\x3d\x7f\x9f\x4d\x51\x58"
  assert WebSocket.encode_frame(WebSocket::TEXT, "Hello", true, MASK) == wire
  decoded_payload_2 = String::Builder.new
  decoded = WebSocket.decode_frame(wire, 0, true, 1024, decoded_payload_2)
  assert decoded.is_a?(Frame)
  if decoded.is_a?(Frame)
    assert decoded.fin
    assert decoded.opcode == WebSocket::TEXT
    assert decoded.payload == "Hello"
    assert decoded.size == 11
  end
  nil
end

def websocket_example_3 : Nil
  assert WebSocket.encode_frame(WebSocket::BINARY, "x" * 125)[0, 2] == "\x82\x7d"
  assert WebSocket.encode_frame(WebSocket::BINARY, "x" * 126)[0, 4] == "\x82\x7e\x00\x7e"
  assert WebSocket.encode_frame(WebSocket::BINARY, "x" * 256)[0, 4] == "\x82\x7e\x01\x00"
  assert WebSocket.encode_frame(WebSocket::BINARY, "x" * 65535)[0, 4] == "\x82\x7e\xff\xff"
  long = WebSocket.encode_frame(WebSocket::BINARY, "x" * 65536)
  assert long[0, 10] == "\x82\x7f\x00\x00\x00\x00\x00\x01\x00\x00"
  assert long.bytesize == 10 + 65536

  [125, 126, 65535, 65536, 70000].each do |size|
    payload = "y" * size
    decoded_payload_3 = String::Builder.new
    decoded = WebSocket.decode_frame(
      WebSocket.encode_frame(WebSocket::BINARY, payload, true, MASK),
      0,
      true,
      100000,
      decoded_payload_3
    )
    assert decoded.is_a?(Frame)
    if decoded.is_a?(Frame)
      assert decoded.payload == payload
      assert decoded.opcode == WebSocket::BINARY
    end
  end
  nil
end

def websocket_example_4 : Nil
  wire = WebSocket.encode_frame(WebSocket::TEXT, "z" * 300, true, MASK)
  decoded_payload_4 = String::Builder.new
  assert WebSocket.decode_frame("", 0, true, 1024, decoded_payload_4) == 2
  decoded_payload_5 = String::Builder.new
  assert WebSocket.decode_frame(
    wire[0, 1],
    0,
    true,
    1024,
    decoded_payload_5
  ) == 2
  decoded_payload_6 = String::Builder.new
  assert WebSocket.decode_frame(
    wire[0, 3],
    0,
    true,
    1024,
    decoded_payload_6
  ) == 4
  decoded_payload_7 = String::Builder.new
  assert WebSocket.decode_frame(
    wire[0, 4],
    0,
    true,
    1024,
    decoded_payload_7
  ) == 4 + 4 + 300
  decoded_payload_8 = String::Builder.new
  assert WebSocket.decode_frame(
    wire[0, wire.bytesize - 1],
    0,
    true,
    1024,
    decoded_payload_8
  ) == wire.bytesize
  decoded_payload_9 = String::Builder.new
  assert WebSocket.decode_frame(
    "\x82\xff\x00\x00",
    0,
    true,
    1024,
    decoded_payload_9
  ) == 10
  nil
end

def websocket_example_5 : Nil
  first = WebSocket.encode_frame(WebSocket::TEXT, "one", false, MASK)
  second = WebSocket.encode_frame(WebSocket::CONTINUATION, "two", true, MASK)
  both = first + second
  decoded_payload_10 = String::Builder.new
  head = WebSocket.decode_frame(both, 0, true, 1024, decoded_payload_10)
  assert head.is_a?(Frame)
  if head.is_a?(Frame)
    assert !head.fin
    assert head.opcode == WebSocket::TEXT
    decoded_payload_11 = String::Builder.new
    tail = WebSocket.decode_frame(
      both,
      head.size,
      true,
      1024,
      decoded_payload_11
    )
    assert tail.is_a?(Frame)
    if tail.is_a?(Frame)
      assert tail.fin
      assert tail.opcode == WebSocket::CONTINUATION
      assert tail.payload == "two"
      assert head.size + tail.size == both.bytesize
    end
  end
  nil
end

def websocket_example_6 : Nil
  refused = [
    {"\x81\x05Hello", 1002},                              # unmasked client frame
    {"\xc1\x80" + MASK, 1002},                            # RSV1 without an extension
    {"\x83\x80" + MASK, 1002},                            # opcode 3 is reserved
    {"\x09\x80" + MASK, 1002},                            # a ping without FIN
    {"\x89\xfe\x00\x7e" + MASK, 1002},                    # a ping over 125 bytes
    {"\x82\xff\x80\x00\x00\x00\x00\x00\x00\x00", 1002},   # 64-bit length with its high bit
    {"\x82\xfe\x04\x01", 1009},                           # 1025 bytes against a 1024 limit
  ]
  refused.each do |pair|
    decoded_payload_12 = String::Builder.new
    decoded = WebSocket.decode_frame(
      pair[0],
      0,
      true,
      1024,
      decoded_payload_12
    )
    assert decoded.is_a?(FrameError)
    if decoded.is_a?(FrameError)
      assert decoded.code == pair[1]
    end
  end
  # The limit is exact, and an unmasked frame is a client's to read.
  decoded_payload_13 = String::Builder.new
  assert WebSocket.decode_frame(
    "\x82\xfe\x04\x00",
    0,
    true,
    1024,
    decoded_payload_13
  ) == 4 + 4 + 1024
  decoded_payload_14 = String::Builder.new
  assert WebSocket.decode_frame(
    "\x81\x05Hello",
    0,
    false,
    1024,
    decoded_payload_14
  ).is_a?(Frame)
  nil
end

def websocket_example_7 : Nil
  assert WebSocket.close_payload(1000, "bye") == "\x03\xe8bye"
  assert WebSocket.close_payload(4000, "") == "\x0f\xa0"
  assert WebSocket.close_payload(1005, "ignored") == ""
  [1000, 1001, 1003, 1007, 1011, 1014, 3000, 4999].each { |code| assert WebSocket.valid_close_code?(code) }
  [0, 999, 1004, 1005, 1006, 1015, 2999, 5000].each { |code| assert !WebSocket.valid_close_code?(code) }
  nil
end

def websocket_example_8 : Nil
  assert WebSocket.accept_key("dGhlIHNhbXBsZSBub25jZQ==") == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
  nil
end

def websocket_example_9 : Nil
  router = Router.new("")
  route_action_1 = Route1.new
  router.before_get("/rooms/:room", route_action_1)
  endpoint_1 = NoopSocket.new
  router.ws("/rooms/:room", endpoint_1)
  options_1 = Config.new
  settings(options_1)
  tree_1 = Tree(Int32).new
  sockets_1 = Tree(Int32).new
  handler_1 = RouteHandler.new(tree_1, sockets_1, options_1)
  handler_1.load(router)
  request_headers_2 = Headers.new
  upgrade_headers(request_headers_2)
  request_2 = Request.new("GET", "/rooms/lobby", "", "HTTP/1.1",
    request_headers_2, "")
  response_headers_3 = Headers.new
  response_3 = Response.new(response_headers_3)
  params_3 = Params.new(request_2)
  context_3 = Context.new(request_2, response_3, params_3)
  handler_1.call(context_3)
  ctx = context_3
  assert ctx.response.status_code == 101
  assert ctx.response.headers["Upgrade"] == "websocket"
  assert ctx.response.headers["Connection"] == "Upgrade"
  assert ctx.response.headers["Sec-WebSocket-Accept"] == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
  assert ctx.upgrades?
  assert ctx.params.url["room"] == "lobby"
  assert ctx.get("filtered") == "lobby"
  assert ctx.route_pattern == "/rooms/:room"
  nil
end

def websocket_example_10 : Nil
  router = Router.new("")
  route_action_2 = Route2.new
  router.get("/chat", route_action_2)
  endpoint_2 = NoopSocket.new
  router.ws("/chat", endpoint_2)
  options_4 = Config.new
  settings(options_4)
  tree_4 = Tree(Int32).new
  sockets_4 = Tree(Int32).new
  handler_4 = RouteHandler.new(tree_4, sockets_4, options_4)
  handler_4.load(router)
  handler = handler_4
  request_headers_5 = Headers.new
  upgrade_headers(request_headers_5)
  request_5 = Request.new("GET", "/chat", "", "HTTP/1.1",
    request_headers_5, "")
  response_headers_6 = Headers.new
  response_6 = Response.new(response_headers_6)
  params_6 = Params.new(request_5)
  context_6 = Context.new(request_5, response_6, params_6)
  handler.call(context_6)
  assert context_6.response.status_code == 101
  request_headers_7 = Headers.new
  request_headers_7["Host"] = "localhost"
  request_7 = Request.new("GET", "/chat", "", "HTTP/1.1", request_headers_7, "")
  response_headers_7 = Headers.new
  response_7 = Response.new(response_headers_7)
  params_7 = Params.new(request_7)
  context_7 = Context.new(request_7, response_7, params_7)
  handler.call(context_7)
  plain = context_7
  assert plain.response.status_code == 200
  assert plain.response.body == "page"
  assert !plain.upgrades?
  nil
end

def websocket_example_11 : Nil
  router = Router.new("")
  route_action_3 = Route3.new
  router.before("/private", route_action_3)
  route_action_4 = Route4.new
  router.before_get("/guarded", route_action_4)
  endpoint_3 = NoopSocket.new
  router.ws("/private", endpoint_3)
  endpoint_4 = NoopSocket.new
  router.ws("/guarded", endpoint_4)
  route_action_5 = Route5.new
  router.error(403, route_action_5)
  options_8 = Config.new
  settings(options_8)
  tree_8 = Tree(Int32).new
  sockets_8 = Tree(Int32).new
  handler_8 = RouteHandler.new(tree_8, sockets_8, options_8)
  handler_8.load(router)
  handler = handler_8
  request_headers_9 = Headers.new
  upgrade_headers(request_headers_9)
  request_9 = Request.new("GET", "/private", "", "HTTP/1.1",
    request_headers_9, "")
  response_headers_10 = Headers.new
  response_10 = Response.new(response_headers_10)
  params_10 = Params.new(request_9)
  context_10 = Context.new(request_9, response_10, params_10)
  handler.call(context_10)
  halted = context_10
  assert halted.response.status_code == 401
  assert halted.response.body == "who are you"
  assert !halted.upgrades?
  request_headers_11 = Headers.new
  upgrade_headers(request_headers_11)
  request_11 = Request.new("GET", "/guarded", "", "HTTP/1.1",
    request_headers_11, "")
  response_headers_12 = Headers.new
  response_12 = Response.new(response_headers_12)
  params_12 = Params.new(request_11)
  context_12 = Context.new(request_11, response_12, params_12)
  handler.call(context_12)
  guarded = context_12
  assert guarded.response.status_code == 403
  assert guarded.response.body == "not for you"
  assert guarded.response.headers["Connection"] == "close"
  assert !guarded.upgrades?
  nil
end

def websocket_example_12 : Nil
  router = Router.new("")
  endpoint_5 = NoopSocket.new
  router.ws("/chat", endpoint_5)
  route_action_6 = Route6.new
  router.post("/chat", route_action_6)
  endpoint_6 = NoopSocket.new
  router.ws("/only", endpoint_6)
