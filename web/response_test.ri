# Writable response: status, headers, body, and the exact bytes a socket is owed.
module web/response_test

import web/response::{Response, Wire}
import web/headers::{Headers}
import web/spec::*

# What a flushed response wrote, kept apart.
class Recorder < Wire
  getter writes : Array(String)

  def initialize(@writes : Array(String))
  end

  pub def write(bytes : String) : Nil
    @writes << bytes.copy_to(Program.tape)
  end
end

describe "Response" do
  it "starts as 200 HTML with an empty body" do
    res_headers1 = Headers.new
    res = Response.new(res_headers1)
    assert res.status_code == 200
    assert res.body == ""
    assert !res.closed?
    assert res.content_type == "text/html; charset=utf-8"
  end

  it "concatenates print/write and replaces with set_body" do
    res_headers2 = Headers.new
    res = Response.new(res_headers2)
    res.status_code = 201
    res.content_type = "application/json"
    res.print("{")
    res.write("}")
    assert res.body == "{}"
    assert res.headers["content-type"] == "application/json"

    res.set_body("ok")
    assert res.body == "ok"
  end

  it "serialises status, headers, a blank line and the body" do
    res_headers3 = Headers.new
    res = Response.new(res_headers3)
    res.status_code = 201
    res.content_type = "application/json"
    res.set_body("ok")
    res.close
    assert res.closed?
    assert res.to_http("HTTP/1.1") == "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\nok"
  end

  it "writes the default type and length when neither was set" do
    res_headers4 = Headers.new
    res = Response.new(res_headers4)
    res.set_body("ok")
    assert res.to_http("HTTP/1.1") == "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 2\r\n\r\nok"
  end

  it "leaves an existing Content-Length alone" do
    res_headers5 = Headers.new
    res = Response.new(res_headers5)
    res.headers["Content-Length"] = "99"
    res.set_body("x")
    kept = res.to_http("HTTP/1.1")
    assert kept.includes?("Content-Length: 99\r\n")
    assert kept.includes?("\r\n\r\nx")
  end

  it "still serialises an unnamed status code" do
    res_headers6 = Headers.new
    res = Response.new(res_headers6)
    res.status_code = 599
    res.set_body("")
    assert res.to_http("HTTP/1.1").starts_with?("HTTP/1.1 599 Server Error\r\n")
  end

  it "omits the body on HEAD and keeps the length" do
    res_headers7 = Headers.new
    res = Response.new(res_headers7)
    res.set_body("ok")
    assert res.to_http("HTTP/1.1", false) == "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 2\r\n\r\n"
  end

  it "sends no entity body, Content-Type or Content-Length for 204 and 304" do
    res_headers8 = Headers.new
    res = Response.new(res_headers8)
    res.status_code = 204
    res.set_body("nope")
    assert res.to_http("HTTP/1.1") == "HTTP/1.1 204 No Content\r\n\r\n"
    cached_headers9 = Headers.new
    cached = Response.new(cached_headers9)
    cached.status_code = 304
    cached.headers["ETag"] = "W/\"1\""
    assert cached.to_http("HTTP/1.1") == "HTTP/1.1 304 Not Modified\r\nETag: W/\"1\"\r\n\r\n"
  end

  it "streams a flushed body in chunks and ends it with the last chunk" do
    writes = [] of String
    res_headers10 = Headers.new
    res = Response.new(res_headers10)
    recorder_res = Recorder.new(writes)
    res.attach(recorder_res, "HTTP/1.1", true, false)
    res.print("ab")
    res.flush
    assert res.headers_sent?
    res.print("cd")
    res.finish
    assert writes.size == 4
    assert writes[0].starts_with?("HTTP/1.1 200 OK\r\n")
    assert writes[0].includes?("Transfer-Encoding: chunked\r\n")
    assert writes[0].includes?("Connection: keep-alive\r\n")
    assert !writes[0].includes?("Content-Length")
    assert writes[1] == "2\r\nab\r\n"
    assert writes[2] == "2\r\ncd\r\n"
    assert writes[3] == "0\r\n\r\n"
    assert res.reusable?
  end

  it "streams raw bytes when the length is known or the client speaks HTTP/1.0" do
    sized = [] of String
    known_headers11 = Headers.new
    known = Response.new(known_headers11)
    recorder_known = Recorder.new(sized)
    known.attach(recorder_known, "HTTP/1.1", true, false)
    known.headers["Content-Length"] = "4"
    known.print("abcd")
    known.finish
    assert sized[1] == "abcd"
    assert sized.size == 2
    assert known.reusable?

    old = [] of String
    legacy_headers12 = Headers.new
    legacy = Response.new(legacy_headers12)
    recorder_legacy = Recorder.new(old)
    legacy.attach(recorder_legacy, "HTTP/1.0", true, false)
    legacy.print("x")
    legacy.finish
    assert old[0].includes?("Connection: close\r\n")
    assert old[1] == "x"
    assert !legacy.reusable?
  end

  it "keeps buffering when nothing is attached, and sends no body for HEAD" do
    buffered_headers13 = Headers.new
    buffered = Response.new(buffered_headers13)
    buffered.print("a")
    buffered.flush
    assert !buffered.headers_sent?
    assert buffered.body == "a"

    heads = [] of String
    head_headers14 = Headers.new
    head = Response.new(head_headers14)
    recorder_head = Recorder.new(heads)
    head.attach(recorder_head, "HTTP/1.1", true, true)
    head.print("hidden")
    head.finish
    assert heads.size == 1
  end

  it "copies a sent body into the body when no server is attached" do
    res_headers15 = Headers.new
    res = Response.new(res_headers15)
    tape do
      res.send(String.build(8) { |buf| buf.append("plain") })
    end
    assert res.body == "plain"
  end
end
