# Segment tree: static wins over a param, :name captures one segment,
# *name the rest, and a failed static walk falls back to the param.
module web/radix_test

import web/radix::{Tree}
import web/spec::*

def fill_sample(tree : Tree(String)) : Nil
  tree.add("/GET/", "home")
  tree.add("/GET/users/:id", "user")
  tree.add("/GET/users/new", "new-user")
  tree.add("/GET/files/*path", "file")
  tree.add("/POST/users", "create")
  tree.add("/GET/:x/c", "xc")
  tree.add("/GET/a/b", "ab")
end

def payload(tree : Tree(String), path : String) : String
  table = {} of String => String
  found = tree.find(path, table)
  return found if found
  assert false, "missing " + path
  ""
end

def params(tree : Tree(String), path : String, & : Hash(String, String) -> Nil) : Nil
  table = {} of String => String
  if tree.find(path, table)
    yield table
  else
    assert false, "missing " + path
  end
end

describe "Tree" do
  it "finds a static root" do
    tree = Tree(String).new
    fill_sample(tree)
    assert payload(tree, "/GET/") == "home"
    params(tree, "/GET/") { |table| assert table.empty? }
  end

  it "captures a named segment" do
    tree = Tree(String).new
    fill_sample(tree)
    assert payload(tree, "/GET/users/7") == "user"
    params(tree, "/GET/users/7") { |table| assert table["id"] == "7" }
  end

  it "prefers a static segment over a parameter on the same node" do
    tree = Tree(String).new
    fill_sample(tree)
    assert payload(tree, "/GET/users/new") == "new-user"
  end

  it "captures the rest of the path as a glob" do
    tree = Tree(String).new
    fill_sample(tree)
    assert payload(tree, "/GET/files/a/b/c.txt") == "file"
    params(tree, "/GET/files/a/b/c.txt") { |table| assert table["path"] == "a/b/c.txt" }
    params(tree, "/GET/files") { |table| assert table["path"] == "" }
  end

  it "keys the walk on the HTTP method" do
    tree = Tree(String).new
    fill_sample(tree)
    assert payload(tree, "/POST/users") == "create"
  end

  it "backtracks onto a parameter when a static walk fails" do
    tree = Tree(String).new
    fill_sample(tree)
    assert payload(tree, "/GET/a/b") == "ab"
    assert payload(tree, "/GET/a/c") == "xc"
    params(tree, "/GET/a/c") { |table| assert table["x"] == "a" }
  end

  it "returns nil for a path, method or extra segment that is not routed" do
    tree = Tree(String).new
    fill_sample(tree)
    assert tree.find("/GET/missing", {} of String => String).nil?
    assert tree.find("/DELETE/users", {} of String => String).nil?
    assert tree.find("/GET/users/7/extra", {} of String => String).nil?
  end

  it "answers a successful match with its payload" do
    tree = Tree(String).new
    fill_sample(tree)
    assert tree.find("/GET/", {} of String => String) == "home"
  end

  it "gives each route its own name for a shared parameter segment" do
    tree = Tree(String).new
    tree.add("/GET/users/:id", "user")
    tree.add("/GET/users/:user_id/posts", "posts")
    params(tree, "/GET/users/5") { |table| assert table["id"] == "5" }
    params(tree, "/GET/users/5/posts") do |posts|
      assert posts["user_id"] == "5"
      assert !posts.has_key?("id")
    end
  end

  it "refuses a second payload for the same path" do
    tree = Tree(String).new
    assert tree.add("/GET/dup", "first")
    assert !tree.add("/GET/dup", "second")
    assert !tree.add("/GET/dup/", "third")
    assert payload(tree, "/GET/dup") == "first"
  end

  it "matches a path with or without a trailing slash" do
    tree = Tree(String).new
    fill_sample(tree)
    assert payload(tree, "/GET/a/b/") == "ab"
    assert payload(tree, "/GET/users/7/") == "user"
    slashed = Tree(String).new
    slashed.add("/GET/about/", "about")
    assert payload(slashed, "/GET/about") == "about"
  end
end
