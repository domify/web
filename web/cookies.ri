# Request cookies as a table, parsed from the `Cookie` header. Setting a
# cookie is on Context (`set_cookie`), because that writes `Set-Cookie`
# onto the response rather than mutating what the client sent.
module web/cookies

import web/codec::*

# The table's entries view text the jar keeps beside it.
@[OnTape]
pub struct CookieJar
  @table : Hash(String, String)
  @text : String::Builder

  def initialize(header : String)
    store = String::Builder.new(header.bytesize + 1)
    table = {} of String => String
    unless header.empty?
      header.split(';').each do |part|
        trimmed = part.strip
        next if trimmed.empty?
        eq = trimmed.index('=')
        if eq
          name = decoded_view(trimmed[0, eq].strip, store)
          rest = trimmed.bytesize - eq - 1
          value = decoded_view(trimmed[eq + 1, rest].strip, store)
          table[name] = value unless name.empty?
        else
          name = decoded_view(trimmed, store)
          table[name] = "" unless name.empty?
        end
      end
    end
    @table = table
    @text = store
  end

  def self.parse(header : String) : CookieJar
    new(header)
  end

  pub def []?(name : String) : String?
    @table[name]?
  end

  pub def [](name : String) : String
    self[name]? || raise "no such cookie #{name.inspect}"
  end

  pub def has_key?(name : String) : Bool
    @table.has_key?(name)
  end

  pub def empty? : Bool
    @table.empty?
  end
end

# RFC 6265 cookie-octets pass through. Everything else, and `%` and `+`
# (which `CookieJar.parse` decodes), is percent-encoded, so a value holding
# a space, a semicolon or a line break round-trips instead of breaking the
# header.
pub def encode_cookie_value(value : String) : String
  hex = "0123456789ABCDEF"
  encoded = ""
  bytes = value
  index = 0
  while index < value.bytesize
    byte = bytes[index]
    if cookie_octet?(byte)
      encoded << byte.unsafe_chr.to_s
    else
      encoded << "%"
      encoded << hex[byte.to_i32 >> 4, 1]
      encoded << hex[byte.to_i32 % 16, 1]
    end
    index = index + 1
  end
  encoded
end

private def cookie_octet?(byte : UInt8) : Bool
  return false if byte == 37_u8 || byte == 43_u8
  return true if byte == 33_u8
  return true if byte >= 35_u8 && byte <= 43_u8
  return true if byte >= 45_u8 && byte <= 58_u8
  return true if byte >= 60_u8 && byte <= 91_u8
  byte >= 93_u8 && byte <= 126_u8
end
