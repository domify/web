# The command-line flags `run` reads from the program's arguments: where to
# bind, which port, and help. An application adds its own flags through
# `extra_options`, which hands it the same parser.
#
# A flag spelled with a word after it (`--port PORT`) takes a value, given
# as `--port 4000`, `--port=4000`, `-p 4000` or `-p4000`. The parser returns
# what went wrong instead of stopping the program, so `run` decides how to
# report it and tests can read the answer.
module web/cli

import web/config::{Config}

pub abstract class CLIAction
  pub abstract def call(value : String) : String?
end

struct FlagText
  getter start : Int32
  getter size : Int32
  def initialize(@start : Int32, @size : Int32)
  end
end

@[OnTape]
struct Flag
  getter short : FlagText
  getter long : FlagText
  getter value : Bool
  getter label : FlagText
  getter description : FlagText
  getter action : Symbol
  getter handler : Int32

  def initialize(@short : FlagText, @long : FlagText, @value : Bool,
                 @label : FlagText, @description : FlagText, @action : Symbol,
                 @handler : Int32)
  end
end

pub class CLIParser
  @flags : Array(Flag)
  @help : Bool

  def initialize(@config : Config? = nil,
                 @banner : String = "Options:")
    @flags = [] of Flag
    @help = false
    @handlers = [] of CLIAction
    @text = String::Builder.new
  end

  pub def on(short : String, long : String, description : String,
             handler : CLIAction) : Nil
    add(short, long, description, :custom, handler)
  end

  pub def on(flag : String, description : String,
             handler : CLIAction) : Nil
    if flag.starts_with?("--")
      add("", flag, description, :custom, handler)
    else
      add(flag, "", description, :custom, handler)
    end
  end

  pub def standard_options : Nil
    add("-b HOST", "--bind HOST",
      "Host to bind (defaults to 0.0.0.0)", :bind)
    add("-p PORT", "--port PORT",
      "Port to listen for connections (defaults to 3000)", :port)
    add("-s", "--ssl", "Enables SSL", :tls)
    add("", "--ssl-key-file FILE", "SSL key file", :tls)
    add("", "--ssl-cert-file FILE", "SSL certificate file", :tls)
  end

  # True once `-h` or `--help` was given.
  pub def help? : Bool
    @help
  end

  pub def usage : String
    width = "-h, --help".bytesize
    @flags.each do |flag|
      size = spelling(flag).bytesize
      width = size if size > width
    end
    output = String.new(@banner)
    output << "\n    -h, --help"
    output << " " * (width - "-h, --help".bytesize + 4)
    output << "Shows this help"
    @flags.each do |flag|
      name = spelling(flag)
      output << "\n    " << name
      output << " " * (width - name.bytesize + 4)
      output << read(flag.description)
    end
    output
  end

  private def spelling(flag : Flag) : String
    result = ""
    unless read(flag.short).empty?
      result << read(flag.short)
      result << " " << read(flag.label) if flag.value
    end
    unless read(flag.long).empty?
      result << ", " unless read(flag.short).empty?
      result << read(flag.long)
      result << " " << read(flag.label) if flag.value
    end
    result
  end

  # Nil when every flag was understood; otherwise what went wrong.
  # Arguments that are not flags, and everything after `--`, are left alone.
  pub def parse(args : Array(String)) : String?
    index = 0
    while index < args.size
      arg = args[index]
      index = index + 1
      break if arg == "--"
      if arg == "-h" || arg == "--help"
        @help = true
        next
      end
      next unless arg.starts_with?("-") && arg.bytesize > 1
      name = arg
      inline = nil
      if arg.starts_with?("--")
        if eq = arg.index('=')
          name = arg[0, eq]
          inline = arg[eq + 1, arg.bytesize - eq - 1]
        end
      elsif arg.starts_with?("-") && arg.bytesize > 2
        name = arg[0, 2]
        inline = arg[2, arg.bytesize - 2]
      end
      flag = find(name)
      return "Invalid option: " + arg unless flag
      value = ""
      if flag.value
        if given = inline
          value = given
        elsif index < args.size
          value = args[index]
          index = index + 1
        else
          return "Missing argument for option: " + name
        end
      elsif inline
        return "Option " + name + " takes no value"
      end
      if problem = apply(flag, value)
        return problem
      end
    end
    nil
  end

  private def apply(flag : Flag, value : String) : String?
    case flag.action
    when :bind
      config = @config || raise "CLI config missing"
      config.host = value
    when :port
      port = port_number(value)
      unless port
        return "Invalid port \"" + value +
          "\": must be an integer between 0 and 65535."
      end
      config = @config || raise "CLI config missing"
      config.port = port
    when :tls
      return "TLS is not supported: terminate TLS at a reverse proxy."
    else
      handler = @handlers[flag.handler]
      return handler.call(value) if handler
    end
    nil
  end

  private def read(span : FlagText) : String
    @text.finish[span.start, span.size]
  end

  private def keep(value : String) : FlagText
    at = @text.bytesize
    @text.append(value)
    FlagText.new(at, value.bytesize)
  end

  private def add(short : String, long : String, description : String,
                  action : Symbol, handler : CLIAction? = nil) : Nil
    short_name, short_label = split_spec(short)
    long_name, long_label = split_spec(long)
    label = long_label.empty? ? short_label : long_label
    handler_index = @handlers.size
    @handlers << handler if handler
    @flags << Flag.new(keep(short_name), keep(long_name), !label.empty?,
      keep(label), keep(description), action, handler_index)
    nil
  end

  private def find(name : String) : Flag?
    @flags.each do |flag|
      return flag if name == read(flag.short) || name == read(flag.long)
    end
    nil
  end

  private def split_spec(spec : String) : Tuple(String, String)
    space = spec.index(' ')
    space ? {spec[0, space], spec[space + 1, spec.bytesize - space - 1].strip} : {spec, ""}
  end
end

# Configure a caller-owned parser; never return a locally declared owner.
pub def cli_parser(parser : CLIParser) : CLIParser
  parser.standard_options
  parser
end

private def port_number(text : String) : Int32?
  return nil if text.empty? || text.strip != text
  number = text.to_i?
  return nil unless number
  number >= 0 && number <= 65535 ? number : nil
end
