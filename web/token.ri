# Names nobody can guess: multipart boundaries, and the directories
# uploads are spooled into.
module web/token

import std/text
import std/random::{Random}
import std/int

# *count* random bytes as `2 * count` lower-case hex digits.
pub def random_hex(count : Int32) : String
  digits = "0123456789abcdef"
  text = String::Builder.new(count * 2 + 1)
  each_random_byte(count) do |byte|
    text.write_byte(digits.byte_at((byte >> 4).to_i32))
    text.write_byte(digits.byte_at((byte & 15_u8).to_i32))
  end
  text.finish
end

# `File.exists?` is an open for reading, so it answers whether the device
# can be read. wasm32 has no such path to ask about.
#
# Where there is no `/dev/urandom` - Windows, wasm32 - the bytes come from
# `std/random` seeded by `Random.new`, which reads the platform's own
# entropy (`RtlGenRandom` on Windows; the clocks on wasm32, which has none).
private def each_random_byte(count : Int32, & : UInt8 -> Nil) : Nil
  {% if !flag?(:wasm32) %}
    if File.exists?("/dev/urandom")
      file = File.open("/dev/urandom", "r", count)
      defer file.close
      bytes = file.read_bytes(count)
      if bytes.bytesize == count
        bytes.each_byte { |byte| yield byte }
        return
      end
    end
  {% end %}

  rng = Random.new
  count.times { yield (rng.next_u & 255_u32).to_u8 }
end
