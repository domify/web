# `multipart/form-data` bodies (RFC 7578): the text fields in the order
# they were sent, and every file part spooled to a temporary file in a
# directory of its own.
#
# A request body arrives here as one String, which holds bytes rather than
# text, so a file's contents come out exactly as the client sent them: NUL,
# CR and LF included. A part is a file when its Content-Disposition carries
# a `filename` parameter, even an empty one.
#
# Field names and filenames are used as sent. Nothing is sanitised: a
# filename can be `../../etc/passwd` or contain any byte a header value may
# hold, so never join it to a directory without cleaning it first.
#
# Parsing is all or nothing. A malformed body is a 400 and a breached limit
# a 413, and either way every temporary file already written is deleted
# before the error is returned. On success the caller owns the files and
# calls `delete` when the request is over.
module web/multipart

import std/file::{File}
import std/dir::{Dir}
import std/text
import std/http::{HTTP}
import web/headers::{Headers}
import web/token::{random_hex}

TEMPFILE_PREFIX = "web-upload"

# A part's header block, read where it lies.
@[OnTape]
pub struct PartHeaders
  def initialize(@block : String)
  end

  pub def to_s : String
    @block
  end

  pub def []?(name : String) : String?
    start = 0
    while start < @block.bytesize
      stop = @block.index("\r\n", start) || @block.bytesize
      line = @block[start, stop - start]
      if colon = line.index(':')
        if HTTP.same_name?(line[0, colon], name)
          return line[colon + 1, line.bytesize - colon - 1].strip
        end
      end
      start = stop + 2
    end
    nil
  end

  pub def [](name : String) : String
    self[name]? || raise "no such header #{name.inspect}"
  end
end

# One file part, spooled to disk under `path`.
@[OnTape]
pub struct FileUpload
  getter name : String
  getter filename : String
  getter path : String
  getter headers : PartHeaders
  getter size : Int32
  @spool_dir : String

  def initialize(@name : String, @filename : String, @path : String, @headers : PartHeaders, @size : Int32, @spool_dir : String)
  end

  # The part's Content-Type as sent, or "" when it carried none.
  pub def content_type : String
    @headers["Content-Type"]? || ""
  end

  # The whole upload. Reads the file each time it is called.
  pub def read : String
    File.read(@path)
  end

  # Removes the temporary file, and the directory it was spooled into once
  # that is empty. Safe to call more than once.
  pub def delete : Nil
    File.delete(@path) if File.exists?(@path)
    Dir.delete?(@spool_dir)
  end
end

# A parsed body: text fields in order, repeated names kept, file parts, or
# why it was refused (and then no file is left on disk). Texts view the
# body or *store*, which the caller owns.
@[OnTape]
pub struct Multipart
  getter fields : Array(Tuple(String, String))
  getter files : Array(FileUpload)
  getter error : MultipartError?

  def initialize(body : String, boundary : String, max_files : Int32, max_field_size : Int32, store : String::Builder)
    fields = [] of Tuple(String, String)
    files = [] of FileUpload
    @error = parse_parts(body, boundary, fields, files, max_files, max_field_size, store)
    @fields = fields
    @files = files
  end

  # Deletes every file part's temporary file.
  pub def delete : Nil
    @files.each { |upload| upload.delete }
  end
end

# Why a body was refused: 400 when it is malformed, 413 when it breaches a
# limit.
@[OnTape]
pub struct MultipartError
  @status : Int32
  @message : String

  def initialize(@status : Int32, @message : String)
  end

  pub def status : Int32
    @status
  end

  pub def message : String
    @message
  end
end

impl Error for MultipartError
  def message : String
    @message
  end
end

# The `boundary` parameter of a `multipart/*` Content-Type, quoted or not,
# written onto *store*. Nil when the media type is not multipart or the
# parameter is missing or empty.
pub def multipart_boundary(content_type : String, store : String::Builder) : String?
  semi = content_type.index(';') || content_type.bytesize
  return nil unless content_type[0, semi].strip.downcase.starts_with?("multipart/")
  boundary = header_param(content_type, "boundary", store)
  return nil unless boundary
  return nil if boundary.empty?
  boundary
end

# Reads a whole `multipart/form-data` body into *fields* and *files*. At
# most *max_files* file parts are accepted and a text field may hold at
# most *max_field_size* bytes; past either limit the answer is a 413. A
# body with no parts at all (`--boundary--`) is an empty form, not an error.
# Parse into caller-owned collections; no intermediate form is retained.
pub def parse_multipart(body : String, boundary : String,
                        fields : Array(Tuple(String, String)),
                        files : Array(FileUpload), max_files : Int32,
                        max_field_size : Int32,
                        store : String::Builder) : MultipartError?
  parse_parts(body, boundary, fields, files, max_files,
    max_field_size, store)
end

pub def parse_parts(body : String, boundary : String,
                    fields : Array(Tuple(String, String)),
                    files : Array(FileUpload), max_files : Int32,
                    max_field_size : Int32,
                    store : String::Builder) : MultipartError?
  return MultipartError.new(400, "multipart boundary is empty") if boundary.empty?
  dash = "--" + boundary
  delimiter = "\r\n" + dash

  # The first boundary opens the body or starts a line; anything before it
  # is preamble and ignored.
  cursor = 0
  if body.starts_with?(dash)
    cursor = dash.bytesize
  else
    found = body.index(delimiter)
    return MultipartError.new(400, "multipart body has no boundary") unless found
    cursor = found + delimiter.bytesize
  end

  while true
    start = after_delimiter(body, cursor)
    unless start
      discard(files)
      return MultipartError.new(400, "malformed multipart boundary line")
    end
    break if start == CLOSED

    finish = body.index(delimiter, start)
    unless finish
      discard(files)
      return MultipartError.new(400, "multipart body has no closing boundary")
    end

    problem = add_part(body, start, finish, fields, files, max_files, max_field_size, store)
    if problem
      discard(files)
      return problem
    end
    cursor = finish + delimiter.bytesize
  end
  nil
end

CLOSED = -1

# Reads what follows a boundary at *cursor*: `--` closes the body (what
# comes after is epilogue), otherwise optional spaces or tabs and CRLF open
# the next part, whose first byte is returned. Nil for anything else.
private def after_delimiter(body : String, cursor : Int32) : Int32?
  rest = body.bytesize - cursor
  return CLOSED if rest >= 2 && body[cursor, 2] == "--"
  line_end = body.index("\r\n", cursor)
  return nil unless line_end
  bytes = body
  index = cursor
  while index < line_end
    byte = bytes[index]
    return nil unless byte == 32_u8 || byte == 9_u8
    index = index + 1
  end
  line_end + 2
end

# One part, from its first header byte to the CRLF before the next
# boundary.
private def add_part(body : String, start : Int32, finish : Int32, fields : Array(Tuple(String, String)), files : Array(FileUpload), max_files : Int32, max_field_size : Int32, store : String::Builder) : MultipartError?
  content_start = 0
  header_block = ""
  if finish - start >= 2 && body[start, 2] == "\r\n"
    content_start = start + 2
  else
    separator = body.index("\r\n\r\n", start)
    return MultipartError.new(400, "multipart part headers are not terminated") unless separator
    return MultipartError.new(400, "multipart part headers are not terminated") if separator + 4 > finish
    header_block = body[start, separator - start]
    content_start = separator + 4
  end

  return MultipartError.new(400, "malformed multipart part header") unless part_headers?(header_block)
  headers = PartHeaders.new(header_block)
  disposition = headers["Content-Disposition"]?
  return MultipartError.new(400, "multipart part has no Content-Disposition") unless disposition

  semi = disposition.index(';') || disposition.bytesize
  return MultipartError.new(400, "multipart part is not form-data") unless disposition[0, semi].strip.downcase == "form-data"
  name = header_param(disposition, "name", store)
  filename = header_param(disposition, "filename", store)
  return MultipartError.new(400, "multipart part has no name") unless name

  content = body[content_start, finish - content_start]
  if filename
    # Counted before the part is spooled, so a refused body costs no
    # temporary file beyond the ones already accepted.
    return MultipartError.new(413, "Too many file parts (max #{max_files})") if files.size >= max_files
    dir = spool_dir(store)
    at = store.bytesize
    store.append(dir)
    store.append("/upload")
    path = store.finish[at, store.bytesize - at]
    File.write(path, content)
    files << FileUpload.new(name, filename, path, headers, content.bytesize, dir)
  else
    return MultipartError.new(413, "Payload Too Large") if content.bytesize > max_field_size
    fields << {name, content}
  end
  nil
end

# A new directory for one upload, mode 0700, under a name nobody can guess.
# `File.tempfile` names its files after the pid and a counter and writes
# through whatever already sits at the path, so another account sharing
# the temporary directory could plant a symlink there and have the upload
# written wherever it points. `mkdir` refuses any existing entry, a symlink
# included, and nobody else can create one inside the new directory.
private def spool_dir(store : String::Builder) : String
  at = store.bytesize
  store.append(File.join(Dir.tempdir, TEMPFILE_PREFIX + "-" + random_hex(16)))
  dir = store.finish[at, store.bytesize - at]
  Dir.mkdir(dir, 0o700)
  dir
end

# `Name: value` lines separated by CRLF. False when a line is not a header,
# so a malformed part is a 400 rather than a panic.
private def part_headers?(block : String) : Bool
  return true if block.empty?
  block.split("\r\n").each do |line|
    colon = line.index(':')
    return false unless colon
    name = line[0, colon]
    value = line[colon + 1, line.bytesize - colon - 1].strip
    return false unless Headers.valid_name?(name) && Headers.valid_value?(value)
  end
  true
end

private def discard(files : Array(FileUpload)) : Nil
  files.each { |upload| upload.delete }
end

# The last parameter *wanted* of `kind; key=value; key="quoted value"`,
# written onto *store*. Keys are matched without case; a `;` inside a quoted
# string belongs to the value, and `\\"` and `\\\\` inside one are
# unescaped. Any other backslash is kept, so a Windows path sent as a
# filename survives.
private def header_param(text : String, wanted : String, store : String::Builder) : String?
  size = text.bytesize
  index = 0
  while index < size && text[index] != 59_u8
    index = index + 1
  end
  found = nil.as(String?)
  while index < size
    index = index + 1
    key_start = index
    while index < size && text[index] != 61_u8 && text[index] != 59_u8
      index = index + 1
    end
    key = text[key_start, index - key_start].strip
    matches = key.downcase == wanted
    at = store.bytesize
    if index < size && text[index] == 61_u8
      index = index + 1
      while index < size && (text[index] == 32_u8 || text[index] == 9_u8)
        index = index + 1
      end
      if index < size && text[index] == 34_u8
        index = index + 1
        while index < size && text[index] != 34_u8
          byte = text[index]
          if byte == 92_u8 && index + 1 < size && (text[index + 1] == 34_u8 || text[index + 1] == 92_u8)
            index = index + 1
            byte = text[index]
          end
          store.push(byte) if matches
          index = index + 1
        end
        while index < size && text[index] != 59_u8
          index = index + 1
        end
      else
        value_start = index
        while index < size && text[index] != 59_u8
          index = index + 1
        end
        store.append(text[value_start, index - value_start].strip) if matches
      end
    end
    found = store.finish[at, store.bytesize - at] if matches
  end
  found
end
