# An HTTP/1.1 request as a value: method, path, query, headers, body.
#
# The bytes come from `std/http`'s parser. This type is what a handler
# mutates — `_method` override, a content-type chop — so it is a class
# this module owns rather than `std/http`'s struct.
module web/request

import std/http::{HTTP, Server, ParsedHead, HeadError}
import std/text
import web/codec::*
import web/headers::{Headers}

pub struct ParseError
  getter message : String

  def initialize(@message : String)
  end
end

impl Error for ParseError
  def message : String
    @message
  end
end

pub class Request
  def initialize(@method : String, @path : String, @query_string : String, @version : String, @headers : Headers, @body : String)
  end

  # `std/http`'s request as this type: path percent-decoded, query left
  # encoded, headers in the case-insensitive table a handler writes.

  pub def method : String
    @method
  end

  pub def method=(value : String) : String
    @method = value
  end

  pub def path : String
    @path
  end

  pub def query_string : String
    @query_string
  end

  pub def version : String
    @version
  end

  pub def headers : Headers
    @headers
  end

  pub def body : String
    @body
  end

  pub def content_type : String
    header = @headers["content-type"]?
    return "" unless header
    semi = header.index(';')
    semi ? header[0, semi].strip : header.strip
  end

  pub def content_length : Int32
    raw = @headers["content-length"]?
    return 0 unless raw
    raw.to_i? || 0
  end

  pub def keep_alive? : Bool
    conn = @headers["connection"]?
    if conn
      lowered = conn.downcase
      return false if lowered == "close"
      return true if lowered == "keep-alive"
    end
    @version == "HTTP/1.1"
  end

  pub def host : String
    @headers["host"]? || ""
  end
end

# One pass of `std/http`'s parser: a request, a refusal, or "not yet".

# Split a request-target into path and query, percent-decoding the path.
# The query is left encoded; `parse_query` is what turns it into a table,
# and form bodies share that function.
pub def split_target(target : String) : Tuple(String, String)
  q = target.index('?')
  if q
    path = decode_path(target[0, q])
    query = target[q + 1, target.bytesize - q - 1]
    {path.empty? ? "/" : path, query}
  else
    path = decode_path(target)
    {path.empty? ? "/" : path, ""}
  end
end

# `HTTP.content_length` read where the field lies: every comma-separated
# part spelled as the first (RFC 9112 §6.3), digits only (RFC 9110
# §8.6), and one past 2147483647 for any larger.
pub def content_length(value : Tape::String) : Int64?
  first_from = -1
  first_to = -1
  start = 0
  while start <= value.bytesize
    stop = start
    while stop < value.bytesize && value[stop] != 44_u8
      stop = stop + 1
    end
    from = start
    while from < stop && (value[from] == 32_u8 || value[from] == 9_u8)
      from = from + 1
    end
    to = stop
    while to > from && (value[to - 1] == 32_u8 || value[to - 1] == 9_u8)
      to = to - 1
    end
    if first_from < 0
      first_from = from
      first_to = to
    else
      return nil unless to - from == first_to - first_from
      i = 0
      while i < to - from
        return nil unless value[from + i] == value[first_from + i]
        i = i + 1
      end
    end
    start = stop + 1
  end
  return nil unless first_to > first_from
  n = 0_i64
  i = first_from
  while i < first_to
    byte = value[i]
    return nil unless byte >= 48_u8 && byte <= 57_u8
    i = i + 1
  end
  i = first_from
  while i < first_to
    n = n * 10_i64 + (value[i] - 48_u8).to_i64
    return 2147483648_i64 if n > 2147483647_i64
    i = i + 1
  end
  n
end

# A complete request off the wire, or why not. Headers-only text is
# completed with a blank line so a unit test can share the parser the
# server uses.
pub def parse_head(block : String) : Request | ParseError
  text = block.includes?("\r\n\r\n") ? block : block + "\r\n\r\n"
  result = ParseError.new("incomplete request").as(Request | ParseError)
  tape do
    case head = Server.parse_head(Tape::String.view(text))
    in Nil
    in HeadError
      result = ParseError.new(head.message)
    in ParsedHead
      length = 0
      if field = head.field("Content-Length")
        if declared = content_length(field)
          length = declared.to_i32
        end
      end
      if text.bytesize - head.body_start >= length
        case built = request_from(head, text[head.body_start, length])
        in ParseError            then result = built
        in Tuple(Request, Bool)  then result = built[0]
        end
      end
    end
  end
  result
end

# The request *head* names, with *body*, and whether the client asked for
# the connection to close; a refusal for framing `std/http` refuses. Built
# from the head's views on the request's tape: the method, the version and
# the fields are copied to the heap once, into what the `Request` keeps.
pub def request_from(head : ParsedHead, body : String) : Tuple(Request, Bool) | ParseError
  headers = Headers.new
  head.each_heap_field { |name, value| headers.add(name, value) }
  http10 = head.http10?
  version = http10 ? "HTTP/1.0" : "HTTP/1.1"
  target = head.target
  p = target
  n = target.bytesize
  path = ""
  query = ""
  if authority = HTTP.absolute_form(target)
    # The absolute form (RFC 9112 §3.2.2): its authority is the host,
    # whatever the Host line says, and the path follows it.
    after = authority
    while after < n && p[after] != 47_u8 && p[after] != 63_u8
      after = after + 1
    end
    text = target.to_heap
    named = text[authority, after - authority]
    return ParseError.new("not a host: #{named.inspect}") unless named.bytesize > 0 && HTTP.host?(named)
    headers["Host"] = named
    origin = text[after, n - after]
    origin = "/" + origin if origin.bytesize == 0 || origin.starts_with?("?")
    path, query = split_target(origin)
  else
    q = 0
    while q < n && p[q] != 63_u8
      q = q + 1
    end
    raw = target[0, q].to_heap
    query = q < n ? target[q + 1, n - q - 1].to_heap : ""
    raw = "/" if raw == "*" || raw.empty?
    path = decode_path(raw)
    path = "/" if path.empty?
  end

  # `Connection` is a list of options (RFC 9110 §7.6.1); `close` among them
  # closes (RFC 9112 §9.6), and HTTP/1.0 closes unless it asks otherwise.
  close = http10
  if conn = headers["connection"]?
    close = HTTP.has_token?(conn, "close") || (http10 && !HTTP.has_token?(conn, "keep-alive"))
  end
  if te = headers["transfer-encoding"]?
    return ParseError.new("transfer encoding #{te.inspect} is not chunked") unless HTTP.same_name?(HTTP.trim(te), "chunked")
    # A length beside the chunks, or chunks in HTTP/1.0, is framing a
    # reader ahead may have taken otherwise (RFC 9112 §6.1, §6.3).
    close = true if headers.has_key?("content-length") || http10
  elsif cl = headers["content-length"]?
    return ParseError.new("Content-Length is not a number: #{cl.inspect}") unless HTTP.content_length(cl)
  end
  {Request.new(head.method.to_heap, path, query, version, headers, body), close}
end

pub def with_body(request : Request, body : String) : Request
  Request.new(request.method, request.path, request.query_string, request.version, request.headers, body)
end


