# An HTTP/1.1 request as a value: method, path, query, headers, body.
#
# The bytes come from `std/http`'s parser. This type is what a handler
# mutates — `_method` override, a content-type chop — so it is a class
# this module owns rather than `std/http`'s struct.
module web/request

import std/http::{HTTP, Server, ParsedHead, HeadError, Field}
import std/text
import web/codec::*
import web/headers::{Headers}

@[OnTape]
pub struct ParseError
  getter message : String

  def initialize(@message : String)
  end
end

impl Error for ParseError
  def message : String
    @message
  end
end

pub class Request
  # A refusal for framing `std/http` refuses, and whether the client asked
  # for the connection to close.
  getter refusal : ParseError?
  getter close : Bool

  def initialize(@method : String, @path : String, @query_string : String, @version : String, @headers : Headers, @body : String)
    @refusal = nil
    @close = false
  end

  # The request *head* names, with *body*. The fields, method, path and
  # query are copied once into *headers*, the table the caller declared for
  # this request, and the `Request` views them.
  def initialize(head : ParsedHead, @body : String, headers : Headers)
    @headers = headers
    headers.add_fields(head)
    http10 = head.http10?
    @version = http10 ? "HTTP/1.0" : "HTTP/1.1"
    @method = headers.keep(head.method)
    @refusal = nil
    @close = http10
    @path = ""
    @query_string = ""
    target = head.target
    n = target.bytesize
    if authority = HTTP.absolute_form(target)
      # The absolute form (RFC 9112 §3.2.2): its authority is the host,
      # whatever the Host line says, and the path follows it.
      after = authority
      while after < n && target[after] != 47_u8 && target[after] != 63_u8
        after = after + 1
      end
      named = target[authority, after - authority]
      unless named.bytesize > 0 && HTTP.host?(named)
        @refusal = ParseError.new(headers.keep("not a host: #{named.inspect}"))
        return
      end
      headers["Host"] = named
      origin = target[after, n - after]
      origin = "/" + origin if origin.bytesize == 0 || origin.starts_with?("?")
      split = split_target(origin)
      @path = headers.keep(split[0])
      @query_string = headers.keep(split[1])
    else
      q = 0
      while q < n && target[q] != 63_u8
        q = q + 1
      end
      raw = target[0, q]
      @query_string = q < n ? headers.keep(target[q + 1, n - q - 1]) : ""
      raw = "/" if raw == "*" || raw.empty?
      @path = headers.keep(decode_path(raw))
      @path = "/" if @path.empty?
    end

    # `Connection` is a list of options (RFC 9110 §7.6.1); `close` among
    # them closes (RFC 9112 §9.6), and HTTP/1.0 closes unless it asks
    # otherwise.
    if conn = headers["connection"]?
      @close = HTTP.has_token?(conn, "close") || (http10 && !HTTP.has_token?(conn, "keep-alive"))
    end
    if te = headers["transfer-encoding"]?
      unless HTTP.same_name?(HTTP.trim(te), "chunked")
        @refusal = ParseError.new(headers.keep("transfer encoding #{te.inspect} is not chunked"))
        return
      end
      # A length beside the chunks, or chunks in HTTP/1.0, is framing a
      # reader ahead may have taken otherwise (RFC 9112 §6.1, §6.3).
      @close = true if headers.has_key?("content-length") || http10
    elsif cl = headers["content-length"]?
      unless HTTP.content_length(cl)
        @refusal = ParseError.new(headers.keep("Content-Length is not a number: #{cl.inspect}"))
      end
    end
  end

  # `std/http`'s request as this type: path percent-decoded, query left
  # encoded, headers in the case-insensitive table a handler writes.

  pub def method : String
    @method
  end

  pub def method=(value : String) : String
    @method = value
  end

  pub def path : String
    @path
  end

  pub def query_string : String
    @query_string
  end

  pub def version : String
    @version
  end

  pub def headers : Headers
    @headers
  end

  pub def body : String
    @body
  end

  pub def content_type : String
    header = @headers["content-type"]?
    return "" unless header
    semi = header.index(';')
    semi ? header[0, semi].strip : header.strip
  end

  pub def content_length : Int32
    raw = @headers["content-length"]?
    return 0 unless raw
    raw.to_i? || 0
  end

  pub def keep_alive? : Bool
    conn = @headers["connection"]?
    if conn
      lowered = conn.downcase
      return false if lowered == "close"
      return true if lowered == "keep-alive"
    end
    @version == "HTTP/1.1"
  end

  pub def host : String
    @headers["host"]? || ""
  end
end

# One pass of `std/http`'s parser: a request, a refusal, or "not yet".

# Split a request-target into path and query, percent-decoding the path.
# The query is left encoded; `parse_query` is what turns it into a table,
# and form bodies share that function.
pub def split_target(target : String) : Tuple(String, String)
  q = target.index('?')
  if q
    path = decode_path(target[0, q])
    query = target[q + 1, target.bytesize - q - 1]
    {path.empty? ? "/" : path, query}
  else
    path = decode_path(target)
    {path.empty? ? "/" : path, ""}
  end
end

# `HTTP.content_length` read where the field lies: every comma-separated
# part spelled as the first (RFC 9112 §6.3), digits only (RFC 9110
# §8.6), and one past 2147483647 for any larger.
pub def content_length(value : String) : Int64?
  first_from = -1
  first_to = -1
  start = 0
  while start <= value.bytesize
    stop = start
    while stop < value.bytesize && value[stop] != 44_u8
      stop = stop + 1
    end
    from = start
    while from < stop && (value[from] == 32_u8 || value[from] == 9_u8)
      from = from + 1
    end
    to = stop
    while to > from && (value[to - 1] == 32_u8 || value[to - 1] == 9_u8)
      to = to - 1
    end
    if first_from < 0
      first_from = from
      first_to = to
    else
      return nil unless to - from == first_to - first_from
      i = 0
      while i < to - from
        return nil unless value[from + i] == value[first_from + i]
        i = i + 1
      end
    end
    start = stop + 1
  end
  return nil unless first_to > first_from
  n = 0_i64
  i = first_from
  while i < first_to
    byte = value[i]
    return nil unless byte >= 48_u8 && byte <= 57_u8
    i = i + 1
  end
  i = first_from
  while i < first_to
    n = n * 10_i64 + (value[i] - 48_u8).to_i64
    return 2147483648_i64 if n > 2147483647_i64
    i = i + 1
  end
  n
end

# A complete request off the wire, or why not, in *headers* (a table the
# caller declares). Headers-only text is completed with a blank line so a
# unit test can share the parser the server uses.
pub def parse_head(block : String, headers : Headers, & : Request | ParseError -> Nil) : Nil
  text = block.includes?("\r\n\r\n") ? block : block + "\r\n\r\n"
  fields = Array(Field).new(16)
  case head = Server.parse_head(text, 0, true, fields)
  in Nil
    yield ParseError.new("incomplete request")
  in HeadError
    yield ParseError.new(head.message)
  in ParsedHead
    length = 0
    if field = head.field("Content-Length")
      if declared = content_length(field)
        length = declared.to_i32
      end
    end
    if text.bytesize - head.body_start < length
      yield ParseError.new("incomplete request")
    else
      request = Request.new(head, text[head.body_start, length], headers)
      refusal = request.refusal
      if refusal
        yield refusal
      else
        yield request
      end
    end
  end
end

pub def with_body(request : Request, body : String) : Request
  Request.new(request.method, request.path, request.query_string, request.version, request.headers, body)
end



# A request as it arrived, on the tape of its connection: the parsed
# head's views and the body, nothing copied. What a handler with a
# request type of its own reads (`Handler#answer`) instead of a `Request`.
@[OnTape]
pub struct Arrived
  getter head : ParsedHead
  getter body : String
  # The target's path, percent-decoded (a view when there is nothing to
  # decode), and its query, left encoded.
  getter path : String
  getter query : String
  # What the client sent after this request, which the connection reads
  # next.
  getter rest : String
  # Whether the connection closes after this request.
  getter close : Bool

  def initialize(@head : ParsedHead, @body : String, @path : String, @query : String, @rest : String, @close : Bool)
  end

  def method : String
    @head.method
  end

  def head? : Bool
    @head.method == "HEAD"
  end

  def http10? : Bool
    @head.http10?
  end

  # The value of the first field called *name*, in any case.
  def field(name : String) : String?
    @head.field(name)
  end

  # The request as a `Request`, for a handler that reads one, kept in
  # *headers*, the table the caller declared for it.
  def to_request(headers : Headers) : Request
    Request.new(@head, @body, headers)
  end
end

# *head* as an `Arrived`, with *body*, or a refusal for framing `std/http`
# refuses, as `request_from` refuses it. The absolute form is left to
# `request_from`: nil.
pub def arrived_from(head : ParsedHead, body : String, rest : String,
                     paths : String::Builder) : Arrived | ParseError | Nil
  target = head.target
  return nil if HTTP.absolute_form(target)
  close = close_after(head)
  return close if close.is_a?(ParseError)
  q = 0
  while q < target.bytesize && target[q] != 63_u8
    q = q + 1
  end
  raw = target[0, q]
  query = q < target.bytesize ? target[q + 1, target.bytesize - q - 1] : ""
  at = paths.bytesize
  if raw.bytesize == 0 || raw == "*"
    paths.append("/")
  else
    decode_onto(raw, false, paths)
  end
  path = paths.finish[at, paths.bytesize - at]
  path = "/" if path.bytesize == 0
  Arrived.new(head, body, path, query, rest, close)
end

# Whether the connection closes after the request *head* begins, or a
# refusal for its framing, read where the fields lie.
def close_after(head : ParsedHead) : Bool | ParseError
  http10 = head.http10?
  close = http10
  if conn = head.field("Connection")
    close = HTTP.has_token?(conn, "close") || (http10 && !HTTP.has_token?(conn, "keep-alive"))
  end
  if te = head.field("Transfer-Encoding")
    return ParseError.new("transfer encoding #{te.inspect} is not chunked") unless chunked?(te)
    close = true if head.field("Content-Length") || http10
  elsif cl = head.field("Content-Length")
    return ParseError.new("Content-Length is not a number: #{cl.inspect}") unless content_length(cl)
  end
  close
end

# `chunked`, in any case, between optional whitespace.
def chunked?(value : String) : Bool
  from = 0
  stop = value.bytesize
  while from < stop && (value[from] == 32_u8 || value[from] == 9_u8)
    from = from + 1
  end
  while stop > from && (value[stop - 1] == 32_u8 || value[stop - 1] == 9_u8)
    stop = stop - 1
  end
  word = "chunked"
  return false unless stop - from == word.bytesize
  i = 0
  while i < word.bytesize
    byte = value[from + i]
    byte = byte + 32_u8 if byte >= 65_u8 && byte <= 90_u8
    return false unless byte == word[i]
    i = i + 1
  end
  true
end
