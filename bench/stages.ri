# In-process timings. Set RIS_TAPE_STATS=1 for tape allocation counters.
module bench/stages

import std/time::{Time, Span}
import std/int
import web/intake::{Intake, TooLarge}
import web/request::{Request, ParseError}
import web/headers::{Headers}
import web/context::{Context, with_context}
import web/harness::*
import web/http_date::*
import web/log::{request_log_line}
import web/router::{Router, RouteAction, RouteHandler}
import web/radix::{Tree}
import web/config::{Config}

N = 200000
WIRE = "GET / HTTP/1.1\r\nHost: localhost:3000\r\n" +
  "User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0\r\n" +
  "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\n" +
  "Accept-Language: en-US,en;q=0.5\r\n" +
  "Accept-Encoding: gzip, deflate, br\r\nConnection: keep-alive\r\n\r\n"

class Hello < RouteAction
  pub def call(context : Context) : String
    "Hello World!"
  end
end

def nanos(span : Span) : Int64
  span.total_seconds_i64 * 1000000000_i64 + span.nanoseconds.to_i64
end

def report(name : String, & : -> Nil) : Nil
  best = 9223372036854775807_i64
  7.times do
    started = Time.monotonic
    index = 0
    while index < N
      yield
      index += 1
    end
    elapsed = nanos(Time.monotonic - started)
    best = elapsed if elapsed < best
  end
  puts "#{name.ljust(28)} #{(best // N).to_s.rjust(6)} ns"
end

def take(wire : String, & : Request -> Nil) : Nil
  headers = Headers.new
  intake = Intake.new(1048576)
  intake.append(wire)
  intake.take(headers) do |request|
    case request
    in Request
      yield request
    in ParseError, TooLarge, Nil
      raise "not taken"
    end
    nil
  end
end

def main : Nil
  router = Router.new("")
  hello = Hello.new
  router.get("/", hello)
  options = Config.new
  tree = Tree(Int32).new
  sockets = Tree(Int32).new
  handler = RouteHandler.new(tree, sockets, options)
  handler.load(router)
  report("intake + head + Request") { take(WIRE) { |_request| } }
  take(WIRE) do |request|
    report("Context") { with_context(request) { |_context| } }
    report("Context + router") { dispatch(handler, request) { |_context| } }
    dispatch(handler, request) do |ctx|
      report("Date header") do
        ctx.response.headers["Date"] = current_http_date
        nil
      end
      report("serialise onto tape") do
        buffer = String::Builder.new(ctx.response.http_capacity)
        ctx.response.write_http(buffer, "HTTP/1.1", true)
      end
    end
  end
  report("log line") do
    request_log_line("GET", "/", 200, Span.new(nanoseconds: 1234))
    nil
  end
end
main
