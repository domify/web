# Independent factory-built handlers for the framework throughput benchmark.
module bench/app

import web/dsl::{run, with_handler_chain}
import web/handler::{Handler}
import web/router::{Router, RouteAction}
import web/config::{Config}
import web/context::{Context}

PAGE = "<p>ris web</p>\n" * 2730

class Hello < RouteAction
  pub def call(context : Context) : String
    "Hello World!"
  end
end

class Page < RouteAction
  pub def call(context : Context) : String
    context.response.content_type = "text/html; charset=utf-8"
    PAGE
  end
end

class Rows < RouteAction
  def initialize(@rows : Array(String), @send : Bool)
  end

  pub def call(context : Context) : String
    context.response.content_type = "text/html; charset=utf-8"
    html = String::Builder.new(48_000)
    @rows.each do |row|
      html.append("<tr><td>")
      html.append_html_escaped(row)
      html.append("</td></tr>")
    end
    if @send
      context.response.send(html.finish)
      ""
    else
      String.new(html.finish)
    end
  end
end

pub class Factory
  def self.with_handler(rows : Array(String),
                        & : Handler, Config -> Nil) : Nil
    options = Config.new
    router = Router.new("")
    hello = Hello.new
    page = Page.new
    render = Rows.new(rows, false)
    send = Rows.new(rows, true)
    router.get("/", hello)
    router.get("/page", page)
    router.get("/render", render)
    router.get("/send", send)
    app = ::Web::Dsl::App.new(router, options)
    with_handler_chain(app) { |handler| yield handler, options }
    nil
  end
end

rows = [] of String
text = String::Builder.new
index = 1
while index <= 1000
  at = text.bytesize
  text << "row <" << index << "> & co"
  rows << text.finish[at, text.bytesize - at]
  index += 1
end
run(rows, Factory)
