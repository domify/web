# The same responses through std's task-owned reuse-port server.
module bench/raw

import std/http::{Server, Incoming, Outgoing}

PAGE = "<p>ris web</p>\n" * 2730

pub class Answers
  def initialize(config : Int32)
  end

  def call(request : Incoming, response : Outgoing) : Nil
    response.header("Content-Type", "text/html; charset=utf-8")
    response.body.append(request.path == "/page" ? PAGE : "Hello World!")
    nil
  end
end

args = Program.args
port = (args.size > 1 ? args[1] : "3999").to_i
Server.answer("127.0.0.1", port, 0, Answers)
