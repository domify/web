# HTML forms: url-encoded fields, multipart file uploads with limits, and a
# form that deletes through `_method`. Run from the repository root with
# `ris run examples/forms_and_uploads.ri` and open http://localhost:3000.
#
#   curl -d 'email=ada@example.com' localhost:3000/subscribe
#   curl -F 'title=Holiday' -F 'photos[]=@README.md' -F 'photos[]=@LICENSE' localhost:3000/albums
#   curl -d '_method=DELETE' localhost:3000/albums/7
module examples/forms_and_uploads

import std/html::{HTML}
import web/dsl::*
import web/multipart::{FileUpload}
import web/override::{OverrideMethodHandler}

# Limits are checked while the body is read, before any route runs. Past
# them the client gets `413 Content Too Large`.

# HTML forms only send GET and POST; this turns a POST carrying
# `_method=DELETE` (or PUT, PATCH) into that method before routing.

FORMS = <<-HTML
  <form method="post" action="/subscribe">
    <input name="email" type="email"> <button>Subscribe</button>
  </form>
  <form method="post" action="/albums" enctype="multipart/form-data">
    <input name="title"> <input name="photos[]" type="file" multiple> <button>Upload</button>
  </form>
  <form method="post" action="/albums/7">
    <input type="hidden" name="_method" value="DELETE"> <button>Delete album 7</button>
  </form>
  HTML


# Url-encoded and multipart text fields both land in `env.params.body`.

# Each file is already on disk in a private temporary directory, and is
# deleted once the response is sent: copy it elsewhere to keep it. Names
# ending in `[]` keep every file sent under them, in `all_files`.



import web/handler::{Handler}
import web/router::{Router}
import web/config::{Config}

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

class Route1 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    FORMS
  end
end

class Route2 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    email = env.params.body["email"]? || ""
    if email.includes?("@")
      env.text("Subscribed " + email)
    else
      env.halt(422, "An email address is required")
    end
  end
end

class Route3 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    title = ""
    title << (env.params.body["title"]? || "Untitled")
    photos = env.params.all_files("photos[]")
    lines = "<h1>" + HTML.escape(title) + "</h1>\n<ul>"
    photos.each do |photo|
      # The filename is the client's: escape it before printing, and never
      # join it to a directory path as is.
      lines << "\n<li>" + HTML.escape(photo.filename) + " (" + photo.content_type + ", " + photo.size.to_s + " bytes)</li>"
    end
    lines << "\n</ul>"
    lines
  end
end

class Route4 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.text("Deleted album " + env.params.url["id"])
  end
end


pub class Factory
  def self.with_handler(data : Int32,
                        & : Handler, Config -> Nil) : Nil
    router = Router.new("")
    options = Config.new
    application = App.new(router, options)
    options.max_request_body_size = 2 * 1024 * 1024
    options.max_file_uploads = 3
    options.max_multipart_form_field_size = 1024
    override = OverrideMethodHandler.new
    application.use(override)
    route_action_1 = Route1.new
    application.get("/", route_action_1)
    route_action_2 = Route2.new
    application.post("/subscribe", route_action_2)
    route_action_3 = Route3.new
    application.post("/albums", route_action_3)
    route_action_4 = Route4.new
    application.delete("/albums/:id", route_action_4)

    with_handler_chain(application) do |handler|
      yield handler, options
    end
    nil
  end

end

run(0, Factory)
