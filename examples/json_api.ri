# A JSON API over an in-memory store: list, show, create, update and delete
# todos. Run from the repository root with `ris run examples/json_api.ri`.
#
#   curl localhost:3000/todos
#   curl -X POST localhost:3000/todos -H 'Content-Type: application/json' -d '{"title":"Write docs"}'
#   curl -X PATCH localhost:3000/todos/1 -H 'Content-Type: application/json' -d '{"done":true}'
#   curl -X DELETE localhost:3000/todos/1
module examples/json_api

import std/json::{ToJSON, Builder}
import web/dsl::*
import web/context::{Context}

@[OnTape]
struct Todo
  getter id : Int32
  property title : String
  property done : Bool

  def initialize(@id : Int32, @title : String, @done : Bool = false)
  end
end

# Implementing `ToJSON` is what lets `env.json` serialise a `Todo`, alone or
# inside an `Array`.
impl ToJSON for Todo
  def to_json(json : Builder) : Nil
    json.object do
      json.field("id", @id)
      json.field("title", @title)
      json.field("done", @done)
    end
  end
end

# Kept in memory for as long as the program runs. A constant cannot be
# reassigned, so the last id given out lives in an object.


class Ids
  @last = 0

  def next : Int32
    @last += 1
  end
end



class Todos
  def initialize
    @text = String::Builder.new
    @rows = {} of Int32 => Tuple(Int32, Int32, Bool)
    @last = 0
  end
  def next : Int32
    @last += 1
  end
  def []=(id : Int32, todo : Todo) : Nil
    at = @text.bytesize
    @text.append(todo.title)
    @rows[id] = {at, todo.title.bytesize, todo.done}
    nil
  end
  def []?(id : Int32) : Todo?
    row = @rows[id]?
    row ? Todo.new(id, @text.finish[row[0], row[1]], row[2]) : nil
  end
  def [](id : Int32) : Todo
    self[id]? || raise "missing todo"
  end
  def values : Array(Todo)
    @rows.keys.map { |id| self[id] }
  end
  def delete(id : Int32) : Nil
    @rows.delete(id)
    nil
  end
end

# The todo named by `:id`, or a `404` that ends the request. A segment that
# is not a number names no todo either.
def find_todo(env : Context, todos : Todos) : Todo?
  id = env.params.url["id"].to_i?
  todo = id ? todos[id]? : nil
  env.halt(404, %({"error":"not found"})) unless todo
  todo
end

# `env.params.json` holds the members of a JSON object body, as `JSON::Any`.
def json_string(env : Context, key : String) : String?
  value = env.params.json[key]?
  value ? value.as_s? : nil
end

# `halt` sends its body as is; give error bodies the JSON content type too.

import web/headers::{Headers}
import web/handler::{Handler}
import web/router::{Router}
import web/config::{Config}

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

class Route1 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.response.content_type = "application/json; charset=utf-8"
  end
end

class Route2 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.json({"error" => "invalid JSON"})
  end
end

class Route3 < RouteAction
  def initialize(@todos : Todos)
  end

  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    env.json(@todos.values)
  end
end

class Route4 < RouteAction
  def initialize(@todos : Todos)
  end

  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    if todo = find_todo(env, @todos)
      env.json(todo)
    end
  end
end

class Route5 < RouteAction
  def initialize(@todos : Todos)
  end

  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    title = json_string(env, "title")
    if title.nil? || title.empty?
      env.halt(422, %({"error":"title is required"}))
    else
      id = @todos.next
      @todos[id] = Todo.new(id, title)
      env.status(201).json(@todos[id])
    end
  end
end

class Route6 < RouteAction
  def initialize(@todos : Todos)
  end

  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    if todo = find_todo(env, @todos)
      if title = json_string(env, "title")
        todo.title = title
      end
      if done = env.params.json["done"]?
        todo.done = done.as_bool? == true
      end
      @todos[todo.id] = todo
      env.json(todo)
    end
  end
end

class Route7 < RouteAction
  def initialize(@todos : Todos)
  end

  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    if todo = find_todo(env, @todos)
      @todos.delete(todo.id)
      env.response.status_code = 204
    end
    nil
  end
end


pub class Factory
  def self.with_handler(data : Int32,
                        & : Handler, Config -> Nil) : Nil
    router = Router.new("")
    options = Config.new
    application = App.new(router, options)
    todos = Todos.new
    route_action_1 = Route1.new
    application.before_all("/todos/*", route_action_1)

    # A body declared as JSON that does not parse gets `400` before the route
    # runs; this page replaces the default text.
    route_action_2 = Route2.new
    application.error(400, route_action_2)

    route_action_3 = Route3.new(todos)
    application.get("/todos", route_action_3)

    route_action_4 = Route4.new(todos)
    application.get("/todos/:id", route_action_4)

    route_action_5 = Route5.new(todos)
    application.post("/todos", route_action_5)

    route_action_6 = Route6.new(todos)
    application.patch("/todos/:id", route_action_6)

    route_action_7 = Route7.new(todos)
    application.delete("/todos/:id", route_action_7)


    with_handler_chain(application) do |handler|
      yield handler, options
    end
    nil
  end
end

# A single task owns this example's in-memory store across requests.
run(0, Factory, tasks: 1)
