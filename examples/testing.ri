# Testing an application without a socket. The routes live in
# examples/testing/notes.ri so both this program and
# examples/testing_test.ri can load them. Run the program from the
# repository root with `ris run examples/testing.ri`, and its test with
# `ris test examples`.
#
#   curl -d 'text=Buy milk' localhost:3000/notes
#   curl localhost:3000/notes
module examples/testing

import web/dsl::*
import examples/testing/notes::*

import web/handler::{Handler}
import web/config::{Config}

pub class Factory
  def self.with_handler(data : Int32,
                        & : Handler, Config -> Nil) : Nil
    options = Config.new
    notes_routes do |router|
      application = App.new(router, options)
      with_handler_chain(application) do |handler|
        yield handler, options
      end
    end
    nil
  end
end

run(0, Factory, tasks: 1)
