# Middleware: a handler of our own limited with `only` and `exclude`, CORS
# for one path prefix, gzip for every response, and static files from
# examples/public/. Run from the repository root, where the public folder
# path below resolves, with `ris run examples/middleware.ri`.
#
#   curl localhost:3000/
#   curl -H 'Accept-Encoding: gzip' -o /dev/null -D - localhost:3000/site.css
#   curl -H 'X-Api-Key: secret' localhost:3000/api/report
#   curl -i -X OPTIONS -H 'Origin: https://app.example.com' -H 'Access-Control-Request-Method: POST' localhost:3000/api/report
module examples/middleware

import web/dsl::*
import web/handler::{Handler, HandlerRules}
import web/context::{Context}
import web/cors::{CORSHandler}

# A handler sees every request that reaches its place in the chain, and
# passes it on with `call_next`; not calling it ends the chain. `only` and
# `exclude` record the paths and methods it is for, in the filter syntax.
class ApiKey < Handler
  @key : String

  def initialize(@key : String)
    super()
  end

  pub def call(ctx : Context) : Nil
    return call_next(ctx) unless only_match?(ctx)
    return call_next(ctx) if exclude_match?(ctx)
    if ctx.request.headers["X-Api-Key"]? == @key
      # Later handlers and the route read what a handler stored.
      ctx.set("client", "reporting")
      call_next(ctx)
    else
      ctx.halt(401, "Unauthorized")
    end
  end
end

# Static files are served before `use` middleware and routes. The folder is
# relative to the working directory, not to this file.

import web/handler::{Handler}
import web/router::{Router}
import web/config::{Config}
import std/file::{File}
import web/path::{PathHandler}
import web/config::{StaticHeadersHook}

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

import web/router::{Route, SocketRoute}
import web/radix::{Tree}
import web/config::{Config}

class Route1 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    "ok"
  end
end

class Route2 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    client = env.get("client").to_s
    lines = (1..30).map { |day| "2026-09-" + day.to_s + ": " + (day * 17).to_s + " orders for " + client }
    env.text(lines.join("\n") + "\n")
  end
end

class CacheHeader < StaticHeadersHook
  pub def call(context : Context, path : String, info : File::Info) : Nil
    context.response.headers["Cache-Control"] = "public, max-age=3600"
    nil
  end
end

pub class Factory
  def self.with_handler(data : String,
                        & : Handler, Config -> Nil) : Nil
    router = Router.new("")
    options = Config.new
    application = App.new(router, options)
    application.public_folder("examples/public")

    header_hook = CacheHeader.new
    application.static_headers(header_hook)

    # `use` handlers run in the order they are added. CORS goes first so a
    # preflight, which carries no API key, is answered before `ApiKey` runs.
    cors = CORSHandler.new(origin: "https://app.example.com")
    scoped_cors = PathHandler.new("/api", cors)
    application.use(scoped_cors)
    rules = HandlerRules.new
    rules.only(["/api/*"], "*")
    rules.exclude(["/api/health"], "*")
    auth = ApiKey.new(data)
    auth.rules = rules
    application.use(auth)

    # Compresses textual responses of 860 bytes or more for clients that send
    # `Accept-Encoding: gzip` or `deflate`.
    application.gzip(true)

    route_action_1 = Route1.new
    application.get("/api/health", route_action_1)

    route_action_2 = Route2.new
    application.get("/api/report", route_action_2)


    with_handler_chain(application) do |handler|
      yield handler, options
    end
    nil
  end
end

run(Program.env("API_KEY") || "secret", Factory)
