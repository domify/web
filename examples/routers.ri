# Routers: groups of routes with their own filters, mounted under a prefix,
# nested with `namespace`, and the application's error pages. Run from the
# repository root with `ris run examples/routers.ri`.
#
#   curl localhost:3000/api/v1/status
#   curl -H 'Authorization: Bearer secret' localhost:3000/admin/reports/2026/09
#   curl -i localhost:3000/admin
#   curl -i localhost:3000/boom
module examples/routers

import std/html::{HTML}
import web/dsl::*
import web/router::{Router}

# A router built by a function, the shape a larger application gives each
# module of routes. It needs no DSL, only `Router`.

import web/handler::{Handler}
import web/router::{Router}
import web/config::{Config}

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

import web/router::{Route, SocketRoute}
import web/radix::{Tree}
import web/config::{Config}

class Route1 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    unless env.request.headers["Authorization"]? == "Bearer secret"
      env.response.status_code = 401
    end
  end
end

class Route2 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    "Dashboard"
  end
end

class Route3 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    "Report for " + env.params.url["year"] + "-" + env.params.url["month"]
  end
end

class Route4 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    env.response.headers["WWW-Authenticate"] = "Bearer"
    "<h1>Sign in to see the admin pages</h1>"
  end
end

class Route5 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    env.response.headers["Cache-Control"] = "no-store"
  end
end

class Route6 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    env.json({"status" => "ok", "version" => "v1"})
  end
end

class Route7 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    env.response.headers["X-Content-Type-Options"] = "nosniff"
  end
end

class Route8 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    "<h1>No page at " + HTML.escape(env.request.path) + "</h1>"
  end
end

class Route9 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    "<h1>Something went wrong</h1>"
  end
end

class Route10 < RouteAction
  pub def call(env : Context) : String
    perform(env).into_body
  end

  private def perform(env : Context)
    raise "the database is on fire"
  end
end


pub class Factory
  def self.with_handler(data : Int32,
                        & : Handler, Config -> Nil) : Nil
    router = Router.new("")
    options = Config.new
    application = App.new(router, options)
    admin = Router.new("")

    # Filter paths are relative to where the router is mounted: the default
    # `*` becomes `/admin/*` below, so this guards the admin pages only.
    # Setting an error status, rather than halting, lets the `error 401` page
    # answer instead of the route.
    route_action_1 = Route1.new
    admin.before(route_action_1)

    route_action_2 = Route2.new
    admin.get("/", route_action_2)

    # `namespace` hands the nested router to its block.
    namespace_1 = Router.new("")
    route_action_3 = Route3.new
    namespace_1.get("/:year/:month", route_action_3)
    admin.mount("/reports", namespace_1)

    # Error pages are the application's, wherever they are declared; a
    # mounted router's page replaces the program's for the same code.
    route_action_4 = Route4.new
    admin.error(401, route_action_4)


    api = Router.new("")

    # After filters run once the route has, for routes this router owns.
    route_action_5 = Route5.new
    api.after(route_action_5)

    namespace_2 = Router.new("")
    route_action_6 = Route6.new
    namespace_2.get("/status", route_action_6)
    api.mount("/v1", namespace_2)

    application.mount "/admin", admin
    application.mount "/api", api

    # A program-level `before_all` runs for every request, even one no route
    # matches.
    route_action_7 = Route7.new
    application.before_all(route_action_7)

    route_action_8 = Route8.new
    application.error(404, route_action_8)

    # A route that panics gets `500`, this page and a log line; the server keeps
    # serving other connections.
    route_action_9 = Route9.new
    application.error(500, route_action_9)

    route_action_10 = Route10.new
    application.get("/boom", route_action_10)


    with_handler_chain(application) do |handler|
      yield handler, options
    end
    nil
  end

  def self.error_page(data : Int32, request) : String
    "<h1>Something went wrong</h1>"
  end
end

run(0, Factory)
