# A chat room over WebSockets: every message a member sends goes to every
# member. Run from the repository root with
# `ris run examples/websocket_chat.ri` and open http://localhost:3000 in
# two browser tabs.
module examples/websocket_chat

import web/dsl::*
import web/websocket::{WebSocket}

PAGE = <<-HTML
  <form id="join"><input id="name" placeholder="name" required><button>Join</button></form>
  <form id="say" hidden><input id="text" autocomplete="off"><button>Send</button></form>
  <ul id="log"></ul>
  <script>
    let socket;
    const log = (line) => {
      const item = document.createElement("li");
      item.textContent = line;
      document.getElementById("log").append(item);
    };
    document.getElementById("join").onsubmit = (event) => {
      event.preventDefault();
      const name = encodeURIComponent(document.getElementById("name").value);
      socket = new WebSocket("ws://" + location.host + "/chat/" + name);
      socket.onmessage = (message) => log(message.data);
      socket.onclose = (close) => log("closed: " + close.code);
      event.target.hidden = true;
      document.getElementById("say").hidden = false;
    };
    document.getElementById("say").onsubmit = (event) => {
      event.preventDefault();
      socket.send(document.getElementById("text").value);
      document.getElementById("text").value = "";
    };
  </script>
  HTML


import std/base64::{Base64}
import std/file::{File}
import std/socket::{IyiSocket}
import web/context::{Context, SocketHandler}
import web/router::{Router, RouteAction}
import web/config::{Config}
import web/handler::{Handler}

class Home < RouteAction
  pub def call(context : Context) : String
    PAGE
  end
end

# Each socket owner polls the append-only room journal and sends its own
# frames. No task borrows another connection's WebSocket or write buffer.
class Chat < SocketHandler
  def initialize(@journal : String)
  end

  private def publish(text : String) : Nil
    file = File.open(@journal, "a")
    defer file.close
    file.print(Base64.encode(text) + "\n")
  end

  pub def call(socket : IyiSocket, leftover : String, context : Context,
               max_message_size : Int32) : Nil
    ws = WebSocket.new(socket, max_message_size)
    ws.poll_interval_ms = 25
    name = context.params.url["name"]
    offset = File.read(@journal).bytesize
    publish(name + " joined")
    defer publish(name + " left")
    ws.run_events(leftover) do |opcode, text|
      if opcode == WebSocket::TEXT
        if text == "/quit"
          ws.close(1000, "bye " + name)
        else
          publish(name + ": " + text)
        end
      end
      unless ws.closed?
        bytes = File.read(@journal)
        while ending = bytes.index('\n', offset)
          ws.send(Base64.decode(bytes[offset, ending - offset]))
          offset = ending + 1
        end
      end
      nil
    end
  end
end

pub class Factory
  def self.with_handler(journal : String,
                        & : Handler, Config -> Nil) : Nil
    router = Router.new("")
    options = Config.new
    application = App.new(router, options)
    home = Home.new
    chat = Chat.new(journal)
    application.get("/", home)
    application.ws("/chat/:name", chat)
    with_handler_chain(application) do |handler|
      yield handler, options
    end
    nil
  end
end

def main : Nil
  journal = File.tempfile("web-chat-", ".log")
  File.write(journal, "")
  defer File.delete(journal)
  run(journal, Factory)
end
main
