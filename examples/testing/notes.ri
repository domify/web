# Every invocation builds an independent in-process or task-local app.
module examples/testing/notes

import web/router::{Router, RouteAction}
import web/context::{Context}

class Notes
  def initialize
    @text = String::Builder.new
    @rows = [] of Tuple(Int32, Int32)
  end

  def add(text : String) : Nil
    at = @text.bytesize
    @text.append(text)
    @rows << {at, text.bytesize}
  end

  def size : Int32
    @rows.size
  end

  def [](index : Int32) : String
    at, size = @rows[index]
    @text.finish[at, size]
  end

  def values : Array(String)
    @rows.map { |row| @text.finish[row[0], row[1]] }
  end
end

class AllNotes < RouteAction
  def initialize(@notes : Notes)
  end

  pub def call(context : Context) : String
    context.json(@notes.values)
    ""
  end
end

class OneNote < RouteAction
  def initialize(@notes : Notes)
  end

  pub def call(context : Context) : String
    index = context.params.url["index"].to_i? || -1
    if index >= 0 && index < @notes.size
      context.text(@notes[index])
    else
      context.halt(404, "No such note")
    end
    ""
  end
end

class CreateNote < RouteAction
  def initialize(@notes : Notes)
  end

  pub def call(context : Context) : String
    text = (context.params.body["text"]? || "").strip
    if text.empty?
      context.halt(422, "A note needs text")
    else
      @notes.add(text)
      context.status(201).text("Note " + (@notes.size - 1).to_s)
    end
    ""
  end
end

pub def notes_routes(& : Router -> Nil) : Nil
  notes = Notes.new
  router = Router.new("")
  all = AllNotes.new(notes)
  one = OneNote.new(notes)
  create = CreateNote.new(notes)
  router.get("/notes", all)
  router.get("/notes/:index", one)
  router.post("/notes", create)
  yield router
  nil
end
