# A test is a `*_test.ri` program that exits non-zero on failure;
# `ris test examples` runs every one under examples/. The harness sends
# requests straight to a handler, so no port is opened.
module examples/testing_test

import web/router::{RouteHandler, Route, SocketRoute}
import web/radix::{Tree}
import web/config::{Config}
import web/harness::*
import examples/testing/notes::*

# A fresh application for each check keeps them independent.
def app(& : RouteHandler -> Nil) : Nil
  notes_routes do |router|
    options = Config.new
    tree = Tree(Int32).new
    sockets = Tree(Int32).new
    handler = RouteHandler.new(tree, sockets, options)
    handler.load(router)
    yield handler
    nil
  end
end

def run_suite : Nil
  # An empty list is still a JSON array.
  app do |made329|
    dispatch(made329, "GET", "/notes") do |made330|
      response = made330.response
      assert response.status_code == 200
      assert response.content_type == "application/json; charset=utf-8"
      assert response.body == "[]"

      # `form_request` builds a url-encoded POST; the handler parses it as the
      # server would.
      app do |handler|
        form_request("POST", "/notes", "text=Buy+milk") do |made332|
          dispatch(handler, made332) do |made333|
            created = made333.response
            assert created.status_code == 201
            assert created.body == "Note 0"
            dispatch(handler, "GET", "/notes/0") do |made334|
              assert made334.response.body == "Buy milk"
            end
            dispatch(handler, "GET", "/notes") do |made335|
              assert made335.response.body == %(["Buy milk"])
            end

            # Blank text is refused, and nothing is stored.
            form_request("POST", "/notes", "text=++") do |made336|
              dispatch(handler, made336) do |made337|
                refused = made337.response
                assert refused.status_code == 422
                dispatch(handler, "GET", "/notes") do |made338|
                  assert made338.response.body == %(["Buy milk"])
                end

                # Past the end, a negative index and a word all answer 404.
                ["/notes/1", "/notes/-1", "/notes/first"].each do |path|
                  dispatch(handler, "GET", path) do |made339|
                    assert made339.response.status_code == 404
                  end
                end

                # The router answers 405 with an Allow header for a known path and an
                # unknown method.
                dispatch(handler, "DELETE", "/notes") do |made340|
                  wrong = made340.response
                  assert wrong.status_code == 405
                  assert wrong.headers["Allow"]? == "GET, POST, HEAD"
                end
              end
            end
          end
        end
      end
    end
  end
end

run_suite
