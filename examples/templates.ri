# Templates: a view rendered inside a layout, `content_for` blocks the layout
# prints, and a partial rendered from a view. The views are in
# examples/views/. Run from the repository root with
# `ris run examples/templates.ri` and open http://localhost:3000.
#
#   curl localhost:3000/
#   curl localhost:3000/books/2
module examples/templates

import std/html::{HTML}
import web/dsl::*

@[OnTape]
pub struct Book
  getter id : Int32
  getter title : String
  getter author : String
  getter year : Int32

  def initialize(@id : Int32, @title : String, @author : String, @year : Int32)
  end
end

# Constants are defined before the blocks that read them.
BOOKS = [
  Book.new(1, "The Left Hand of Darkness", "Ursula K. Le Guin", 1969),
  Book.new(2, "Kindred", "Octavia E. Butler", 1979),
  Book.new(3, "Snow & Silence", "Unknown <anonymous>", 2001),
]

# Templates are compiled into the program and see the locals where `render`
# is written: `books` here, `book` below. Paths are relative to this file.


# Error pages can render templates too. Output is not escaped for you, so
# every template escapes what came from outside with `HTML.escape`.


import web/handler::{Handler}
import web/router::{Router}
import web/config::{Config}

import web/router::{RouteAction}
import web/context::{Context}
import web/body::{IntoBody}

class Route1 < RouteAction
  def initialize(@books_config : Array(Book))
  end

  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    books = @books_config
    rendered = render "views/books.eiy", "views/layout.eiy"
    body = ""
    body << rendered
    body
  end
end

class Route2 < RouteAction
  def initialize(@books_config : Array(Book))
  end

  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    id = env.params.url["id"].to_i? || 0
    if book = @books_config.find { |candidate| candidate.id == id }
      rendered = render "views/book.eiy", "views/layout.eiy"
      body = ""
      body << rendered
      body
    else
      # An error status hands the response to the `error 404` page below.
      env.response.status_code = 404
      ""
    end
  end
end

class Route3 < RouteAction
  pub def call(context : Context) : String
    perform(context).into_body
  end

  private def perform(env : Context)
    path = env.request.path
    rendered = render "views/not_found.eiy", "views/layout.eiy"
    body = ""
    body << rendered
    body
  end
end


pub class Factory
  def self.with_handler(data : Array(Book),
                        & : Handler, Config -> Nil) : Nil
    router = Router.new("")
    options = Config.new
    application = App.new(router, options)
    books_config = data
    route_action_1 = Route1.new(books_config)
    application.get("/", route_action_1)
    route_action_2 = Route2.new(books_config)
    application.get("/books/:id", route_action_2)
    route_action_3 = Route3.new
    application.error(404, route_action_3)

    with_handler_chain(application) do |handler|
      yield handler, options
    end
    nil
  end

end

run(BOOKS, Factory)
